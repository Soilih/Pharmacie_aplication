{# templates/commande/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Commander — Locapharma</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
/* ============================================
   VARIABLES
   ============================================ */
:root{
  --G:#0E7C66; --GD:#0a5e4d; --GL:#e1f5ee; --GXL:#f0faf7;
  --B:#0B2545; --BM:#1a3a6e;
  --GOLD:#F4C430; --GOLD-D:#d9a90f;
  --T:#1D2939; --MUT:#667085; --LT:#F2F4F7; --BDR:#E4E7EC;
  --W:#fff; --ERR:#F04438; --OK:#12B76A; --WARN:#F59E0B;

  --shadow-sm: 0 1px 2px rgba(11,37,69,.05);
  --shadow:    0 2px 16px rgba(11,37,69,.07);
  --shadow-md: 0 8px 28px rgba(11,37,69,.10);
  --shadow-lg: 0 18px 40px -8px rgba(11,37,69,.18);
  --shadow-teal: 0 12px 32px -8px rgba(14,124,102,.45);

  --ease-out: cubic-bezier(.22,1,.36,1);
  --ease-spring: cubic-bezier(.34,1.56,.64,1);
  --ease-soft: cubic-bezier(.4,0,.2,1);
}

*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{
  font-family:'Manrope',sans-serif;color:var(--T);
  background:#F0F4F9;overflow-x:hidden;min-height:100vh;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
a{text-decoration:none;color:inherit}
img{display:block;max-width:100%}
button{font-family:inherit}
:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(14,124,102,.36)}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-thumb{background:var(--G);border-radius:3px}

h1,h2,h3,h4{font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em}

/* ============================================
   SCREENS
   ============================================ */
.screen{display:none;animation:screenIn .35s var(--ease-out)}
.screen.active{display:block}
@keyframes screenIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ============================================
   SCREEN 1 — SEARCH HUB
   ============================================ */
.search-wrap{max-width:900px;margin:0 auto;padding:36px 5% 0}
.search-hero{text-align:center;margin-bottom:28px;animation:fadeUp .55s var(--ease-out) both}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
.sh-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--GL);color:var(--G);
  border:1px solid rgba(14,124,102,.2);
  padding:5px 14px;border-radius:100px;
  font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  margin-bottom:14px;font-family:'Plus Jakarta Sans',sans-serif;
}
.sh-eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--G);box-shadow:0 0 0 3px rgba(14,124,102,.18)}
.search-hero h1{font-size:clamp(24px,3.6vw,38px);font-weight:900;color:var(--B);margin-bottom:8px;letter-spacing:-.025em}
.search-hero p{font-size:14px;color:var(--MUT);font-weight:500;max-width:520px;margin:0 auto;line-height:1.55}

.search-box{
  background:white;border-radius:20px;
  box-shadow:var(--shadow-md);border:1px solid var(--BDR);
  overflow:hidden;
  animation:fadeUp .55s var(--ease-out) .1s both;
  margin-bottom:16px;
}
.search-tabs{display:flex;border-bottom:1px solid var(--BDR);background:#FAFBFC}
.stab{
  flex:1;padding:14px;text-align:center;
  font-size:13px;font-weight:800;color:var(--MUT);cursor:pointer;
  transition:color .2s, background .2s, border-color .2s;
  font-family:'Plus Jakarta Sans',sans-serif;
  display:flex;align-items:center;justify-content:center;gap:7px;
  border-bottom:3px solid transparent;
}
.stab.on{color:var(--G);border-bottom-color:var(--G);background:white}
.stab i{font-size:14px}
.search-input-wrap{display:flex;align-items:center}
.search-input-wrap input{
  flex:1;border:none;outline:none;
  padding:18px 20px;font-size:15px;
  font-family:'Manrope',sans-serif;color:var(--T);background:transparent;
}
.search-input-wrap input::placeholder{color:#A6B0BD}
.search-submit{
  background:linear-gradient(135deg,var(--G),var(--GD));color:white;
  border:none;padding:0 28px;height:60px;
  font-size:14px;font-weight:800;font-family:'Plus Jakarta Sans',sans-serif;
  cursor:pointer;display:flex;align-items:center;gap:8px;flex-shrink:0;
  transition:background .25s, transform .2s var(--ease-out);
}
.search-submit:hover{background:var(--GD);transform:translateY(-1px)}
.search-submit:active{transform:translateY(0)}

.search-hint{
  text-align:center;font-size:12px;color:var(--MUT);
  margin-bottom:32px;animation:fadeUp .55s var(--ease-out) .2s both;
}
.search-hint .label{font-weight:700;color:var(--T);margin-right:4px}
.search-hint span.chip{
  display:inline-flex;align-items:center;gap:5px;
  background:white;border:1px solid var(--BDR);
  border-radius:100px;padding:5px 13px;margin:3px;
  cursor:pointer;transition:border-color .2s, color .2s, background .2s, transform .2s var(--ease-spring);
  font-weight:600;color:var(--T);
}
.search-hint span.chip:hover{border-color:var(--G);color:var(--G);background:var(--GXL);transform:translateY(-1px)}

/* SECTION HEADER */
.sec-head{
  max-width:1300px;margin:0 auto;
  padding:28px 5% 16px;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:10px;
}
.sec-head h2{
  font-size:18px;font-weight:900;color:var(--B);
  display:flex;align-items:center;gap:10px;
}
.sec-head h2 i{color:var(--G)}
.sec-head p{font-size:13px;color:var(--MUT);font-weight:500;margin-top:2px}
.badge-count{
  background:var(--G);color:white;
  font-size:10px;font-weight:800;border-radius:100px;
  padding:3px 9px;font-family:'Plus Jakarta Sans',sans-serif;
}

/* PHARMACY GRID */
.ph-grid-wrap{max-width:1300px;margin:0 auto;padding:0 5% 56px}
.ph-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.ph-card{
  background:white;border-radius:18px;overflow:hidden;
  box-shadow:var(--shadow);
  transition:transform .3s var(--ease-out), box-shadow .3s var(--ease-out);
  cursor:pointer;position:relative;
  border:1px solid var(--BDR);
}
.ph-card:hover{box-shadow:var(--shadow-md);transform:translateY(-4px)}
.ph-card-img{height:160px;overflow:hidden;background:var(--B);position:relative}
.ph-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease-out)}
.ph-card:hover .ph-card-img img{transform:scale(1.07)}
.ph-card-img::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(11,37,69,.35) 100%);pointer-events:none}
.ph-card-badge{
  position:absolute;bottom:10px;left:10px;
  padding:5px 11px;border-radius:100px;
  font-size:10px;font-weight:800;letter-spacing:.04em;z-index:2;
  box-shadow:0 4px 10px rgba(0,0,0,.18);
  display:inline-flex;align-items:center;gap:5px;
}
.b-open{background:rgba(18,183,106,.95);color:white}
.b-guard{background:rgba(244,196,48,.96);color:#5B3F00}
.b-closed{background:rgba(240,68,56,.90);color:white}
.ph-card-body{padding:14px}
.ph-card-name{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:15px;font-weight:800;color:var(--B);
  margin-bottom:5px;line-height:1.3;letter-spacing:-.01em;
}
.ph-card-loc{display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--MUT);margin-bottom:10px;font-weight:600}
.ph-card-loc i{color:var(--G);font-size:10px}
.ph-btn-view{
  width:100%;padding:10px;border-radius:11px;
  font-size:12px;font-weight:800;border:none;
  background:var(--G);color:white;cursor:pointer;
  font-family:'Plus Jakarta Sans',sans-serif;
  transition:background .2s, transform .2s var(--ease-spring);
  display:flex;align-items:center;justify-content:center;gap:6px;
}
.ph-btn-view:hover{background:var(--GD);transform:translateY(-1px)}

@media(max-width:1100px){.ph-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:768px){.ph-grid{grid-template-columns:repeat(2,1fr);gap:14px}}
@media(max-width:640px){.ph-grid-wrap{padding:0 14px 100px}.ph-card-img{height:140px}}

.empty-state{text-align:center;padding:60px 20px;animation:fadeUp .5s var(--ease-out) both}
.empty-state i{font-size:54px;color:var(--BDR);margin-bottom:14px;display:block}
.empty-state h3{font-size:17px;font-weight:800;color:var(--B);margin-bottom:7px}
.empty-state p{font-size:13px;color:var(--MUT);max-width:280px;margin:0 auto;line-height:1.55}

/* ============================================
   SCREEN 2 — MED RESULTS
   ============================================ */
.med-wrap{max-width:880px;margin:0 auto;padding:24px 5% 140px}
.back-btn{
  display:inline-flex;align-items:center;gap:7px;
  font-size:13px;font-weight:700;color:var(--MUT);
  cursor:pointer;padding:9px 16px;border-radius:10px;
  background:white;border:1px solid var(--BDR);
  transition:background .2s, color .2s, border-color .2s, transform .2s var(--ease-out);
  font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:18px;
}
.back-btn:hover{background:var(--GL);color:var(--G);border-color:var(--G);transform:translateX(-2px)}

.med-query-badge{
  display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg, var(--GL), white);
  border:1px solid rgba(14,124,102,.3);
  border-radius:14px;padding:12px 18px;
  font-size:13px;font-weight:700;color:var(--T);
  margin-bottom:18px;box-shadow:var(--shadow-sm);
}
.med-query-badge .ico{
  width:36px;height:36px;border-radius:10px;
  background:var(--G);color:white;
  display:flex;align-items:center;justify-content:center;font-size:14px;
}
.med-query-badge .txt{flex:1}
.med-query-badge .txt .q{font-family:'Plus Jakarta Sans',sans-serif;font-weight:900;font-size:15px;color:var(--B);display:block;margin-bottom:2px}
.med-query-badge .txt .c{font-size:11px;color:var(--MUT);font-weight:600}

.med-limit-info{
  background:#EFF6FF;border:1px solid #BFDBFE;border-radius:13px;
  padding:12px 16px;font-size:12.5px;font-weight:600;color:#1E40AF;
  display:flex;align-items:center;gap:10px;margin-bottom:18px;
}
.med-limit-info i{font-size:16px;flex-shrink:0}

.med-limit-warn{
  background:#FEF3C7;border:1px solid var(--WARN);border-radius:13px;
  padding:12px 16px;font-size:12.5px;font-weight:700;color:#92400E;
  display:none;align-items:center;gap:10px;margin-bottom:18px;
  animation:shake .4s;
}
.med-limit-warn.show{display:flex}
@keyframes shake{
  0%,100%{transform:translateX(0)}
  25%{transform:translateX(-4px)}
  75%{transform:translateX(4px)}
}

.med-ph-card{
  background:white;border-radius:16px;border:2px solid var(--BDR);
  padding:16px;margin-bottom:12px;
  display:flex;align-items:center;gap:14px;
  cursor:pointer;
  transition:border-color .25s, transform .25s var(--ease-out), box-shadow .25s, background .25s;
  position:relative;
}
.med-ph-card:hover{border-color:var(--G);box-shadow:var(--shadow);transform:translateX(4px)}
.med-ph-card.selected{
  border-color:var(--G);background:var(--GXL);
  box-shadow:var(--shadow-teal);
}
.med-ph-img{width:72px;height:72px;border-radius:14px;object-fit:cover;flex-shrink:0;background:var(--LT)}
.med-ph-info{flex:1;min-width:0}
.med-ph-name{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:15px;font-weight:800;color:var(--B);margin-bottom:4px;
  letter-spacing:-.01em;
}
.med-ph-loc{font-size:12px;color:var(--MUT);font-weight:600;margin-bottom:7px;display:flex;align-items:center;gap:5px}
.med-ph-loc i{color:var(--G);font-size:11px}
.med-ph-stock{
  display:inline-flex;align-items:center;gap:5px;
  background:var(--GL);color:var(--G);
  font-size:11px;font-weight:800;border-radius:100px;
  padding:3px 11px;
}
.med-ph-stock i{font-size:10px}
.med-ph-check{
  width:34px;height:34px;border-radius:50%;
  background:white;border:2px solid var(--BDR);
  display:flex;align-items:center;justify-content:center;
  font-size:14px;color:transparent;
  transition:background .25s, border-color .25s, color .25s, transform .25s var(--ease-spring);
  flex-shrink:0;
}
.med-ph-card.selected .med-ph-check{
  background:var(--G);border-color:var(--G);color:white;
  transform:scale(1.08);
}

/* ============================================
   FLOATING ORDER BUTTON
   ============================================ */
.float-cmd{
  position:fixed;bottom:24px;left:50%;
  transform:translateX(-50%) translateY(80px);
  z-index:600;
  background:linear-gradient(135deg, var(--G), var(--GD));
  color:white;border:none;
  padding:16px 42px;border-radius:100px;
  font-size:15px;font-weight:900;
  font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;
  transition:transform .35s var(--ease-spring), background .25s;
  box-shadow:0 14px 36px -6px rgba(14,124,102,.55);
  display:flex;align-items:center;gap:10px;white-space:nowrap;
  opacity:0;visibility:hidden;
}
.float-cmd.show{transform:translateX(-50%) translateY(0);opacity:1;visibility:visible}
.float-cmd:hover{background:var(--GD);transform:translateX(-50%) translateY(-3px)}
.fc-badge{
  background:rgba(255,255,255,.28);
  width:22px;height:22px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:900;
}

/* ============================================
   PHARMACY MODAL
   ============================================ */
.ph-modal{
  position:fixed;inset:0;z-index:800;background:white;
  transform:translateX(100%);
  transition:transform .42s var(--ease-out);
  display:flex;flex-direction:column;overflow:hidden;
}
.ph-modal.open{transform:translateX(0)}
.pm-topbar{
  display:flex;align-items:center;gap:14px;
  padding:0 22px;height:64px;flex-shrink:0;
  background:white;border-bottom:1px solid var(--BDR);
  box-shadow:0 2px 12px rgba(11,37,69,.06);z-index:2;
}
.pm-back{
  width:40px;height:40px;background:var(--LT);
  border:none;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:15px;color:var(--B);cursor:pointer;
  transition:background .2s, transform .25s var(--ease-spring);flex-shrink:0;
}
.pm-back:hover{background:var(--GL);color:var(--G);transform:scale(1.05)}
.pm-titlebox{flex:1;min-width:0}
.pm-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:16px;font-weight:900;color:var(--B);letter-spacing:-.015em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pm-sub{font-size:11px;color:var(--MUT);font-weight:600;margin-top:1px}
.pm-body{flex:1;overflow-y:auto;background:#F0F4F9;-webkit-overflow-scrolling:touch}

.pm-hero{
  position:relative;height:200px;overflow:hidden;background:var(--B);
}
.pm-hero img{width:100%;height:100%;object-fit:cover;opacity:.55}
.pm-hero-overlay{
  position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(11,37,69,.25) 0%, rgba(11,37,69,.75) 100%);
  display:flex;flex-direction:column;justify-content:flex-end;padding:22px;
}
.pm-hero-overlay h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;font-weight:900;color:white;margin-bottom:4px;letter-spacing:-.02em}
.pm-hero-overlay .meta{font-size:13px;color:rgba(255,255,255,.85);display:flex;align-items:center;gap:6px}
.pm-hero-overlay .meta i{color:var(--GOLD);font-size:12px}
.pm-hero .status{
  position:absolute;top:16px;right:16px;
  padding:6px 14px;border-radius:100px;
  font-size:11px;font-weight:800;letter-spacing:.04em;
  box-shadow:0 4px 12px rgba(0,0,0,.15);
}

.pm-section{
  background:white;border-radius:20px;
  margin:14px;padding:20px;box-shadow:var(--shadow);
  border:1px solid var(--BDR);
}
.pm-section-title{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:14px;font-weight:900;color:var(--B);
  margin-bottom:16px;display:flex;align-items:center;gap:9px;
  padding-bottom:12px;border-bottom:2px solid var(--GL);
  letter-spacing:-.01em;
}
.pm-section-title i{color:var(--G);font-size:13px}

/* Medicament search inside pharmacy */
.med-search-input{
  position:relative;
}
.med-search-input input{
  width:100%;padding:12px 14px 12px 42px;
  border:1.5px solid var(--BDR);border-radius:12px;
  font-size:14px;color:var(--T);background:#FAFBFC;
  font-family:'Manrope',sans-serif;outline:none;
  transition:border-color .2s, background .2s, box-shadow .2s;
}
.med-search-input input:focus{border-color:var(--G);background:white;box-shadow:0 0 0 4px rgba(14,124,102,.1)}
.med-search-input i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--MUT);font-size:14px;pointer-events:none}
.med-results-count{font-size:11px;color:var(--MUT);font-weight:700;margin-top:8px;letter-spacing:.04em}

.med-list{max-height:340px;overflow-y:auto;margin-top:12px}
.med-item{
  display:flex;align-items:center;gap:12px;
  padding:11px 13px;
  border:1px solid var(--BDR);
  background:#FAFBFC;border-radius:12px;
  margin-bottom:8px;cursor:pointer;
  transition:background .2s, border-color .2s, transform .2s var(--ease-out);
}
.med-item:hover{background:var(--GXL);border-color:rgba(14,124,102,.2);transform:translateX(3px)}
.med-item.selected{background:var(--GL);border-color:var(--G)}
.med-item-name{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:13.5px;font-weight:700;color:var(--T);
  flex:1;line-height:1.3;
}
.med-item-rx{
  display:inline-flex;align-items:center;gap:4px;
  font-size:9.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
  padding:3px 8px;border-radius:100px;flex-shrink:0;
  font-family:'Plus Jakarta Sans',sans-serif;
}
.med-item-rx.rx{background:#FEF3C7;color:#92400E;border:1px solid rgba(245,158,11,.3)}
.med-item-rx.free{background:var(--GL);color:var(--G);border:1px solid rgba(14,124,102,.2)}
.med-item-rx i{font-size:9px}
.med-item-check{
  width:22px;height:22px;border-radius:7px;
  border:1.5px solid var(--BDR);background:white;
  display:flex;align-items:center;justify-content:center;
  font-size:10px;color:transparent;flex-shrink:0;
  transition:background .2s, border-color .2s, color .2s, transform .2s var(--ease-spring);
}
.med-item.selected .med-item-check{
  background:var(--G);border-color:var(--G);color:white;transform:scale(1.08);
}

.selected-meds-preview{
  background:linear-gradient(135deg, var(--GL), white);
  border:1px solid rgba(14,124,102,.2);
  border-radius:12px;padding:12px;margin-top:12px;
  display:none;
}
.selected-meds-preview.show{display:block;animation:fadeUp .35s var(--ease-out)}
.smp-title{font-size:11px;font-weight:800;color:var(--G);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}
.smp-tags{display:flex;flex-wrap:wrap;gap:6px}
.med-tag{
  background:white;border:1px solid var(--G);
  font-size:11px;font-weight:700;color:var(--T);
  padding:4px 10px 4px 12px;border-radius:100px;
  display:inline-flex;align-items:center;gap:8px;
  box-shadow:var(--shadow-sm);
}
.med-tag.rx{border-color:var(--WARN);background:#FFFBEB}
.med-tag .rx-dot{width:6px;height:6px;border-radius:50%;background:var(--WARN)}
.med-tag .x{
  width:18px;height:18px;border-radius:50%;
  background:var(--LT);color:var(--MUT);
  display:flex;align-items:center;justify-content:center;
  font-size:9px;cursor:pointer;transition:background .2s, color .2s;
}
.med-tag .x:hover{background:var(--ERR);color:white}

/* Accessories grid — REAL IMAGES */
.acc-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:14px;
}
@media(max-width:540px){.acc-grid{grid-template-columns:repeat(2,1fr);gap:10px}}
@media(max-width:380px){.acc-grid{grid-template-columns:repeat(2,1fr);gap:8px}}

.acc-item{
  position:relative;
  border-radius:14px;overflow:hidden;
  border:2px solid var(--BDR);background:white;
  cursor:pointer;
  transition:border-color .25s, transform .25s var(--ease-out), box-shadow .25s;
}
.acc-item:hover{border-color:var(--G);transform:translateY(-3px);box-shadow:var(--shadow-md)}
.acc-item.selected{border-color:var(--G);background:var(--GXL);box-shadow:var(--shadow-teal)}
.acc-img{
  position:relative;height:120px;overflow:hidden;
  background:linear-gradient(135deg, #F1F5F9, #E2E8F0);
}
.acc-img img{
  width:100%;height:100%;object-fit:cover;
  transition:transform .5s var(--ease-out);
}
.acc-item:hover .acc-img img{transform:scale(1.08)}
.acc-img .fallback{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:38px;color:var(--G);background:linear-gradient(135deg, var(--GL), white);
  display:none;
}
.acc-img img.broken + .fallback{display:flex}
.acc-check{
  position:absolute;top:8px;right:8px;
  width:26px;height:26px;border-radius:50%;
  background:white;border:2px solid var(--BDR);
  display:flex;align-items:center;justify-content:center;
  font-size:11px;color:transparent;
  transition:background .2s, border-color .2s, color .2s, transform .25s var(--ease-spring);
  box-shadow:var(--shadow-sm);
}
.acc-item.selected .acc-check{
  background:var(--G);border-color:var(--G);color:white;transform:scale(1.12);
}
.acc-info{padding:10px}
.acc-name{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:12px;font-weight:800;color:var(--B);margin-bottom:3px;
  line-height:1.3;letter-spacing:-.01em;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:31px;
}
.acc-price{font-size:11.5px;color:var(--G);font-weight:800;font-family:'Plus Jakarta Sans',sans-serif}

/* Pharmacy modal footer (sticky CTA) — HIDDEN by default */
.pm-footer{
  flex-shrink:0;background:white;border-top:1px solid var(--BDR);
  padding:14px 20px env(safe-area-inset-bottom,0);
  box-shadow:0 -4px 20px rgba(11,37,69,.08);
  display:none;
  animation:slideUpFooter .35s var(--ease-out);
}
.pm-footer.show{display:block}
@keyframes slideUpFooter{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

.pm-sel-info{
  font-size:12px;color:var(--MUT);font-weight:600;
  margin-bottom:10px;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;
}
.pm-sel-count{
  display:inline-flex;align-items:center;gap:6px;
  color:var(--G);font-weight:800;
}
.pm-sel-total{color:var(--B);font-weight:800;font-family:'Plus Jakarta Sans',sans-serif}
.pm-cmd-btn{
  width:100%;padding:15px;
  background:linear-gradient(135deg, var(--G), var(--GD));color:white;
  border:none;border-radius:13px;
  font-size:15px;font-weight:900;
  font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;
  transition:background .25s, transform .2s var(--ease-out), box-shadow .25s;
  display:flex;align-items:center;justify-content:center;gap:10px;
  box-shadow:0 8px 22px -4px rgba(14,124,102,.5);
}
.pm-cmd-btn:hover{background:var(--GD);transform:translateY(-2px);box-shadow:0 14px 28px -6px rgba(14,124,102,.6)}

/* ============================================
   SCREEN 3 — RECAP
   ============================================ */
.recap-wrap{max-width:760px;margin:0 auto;padding:28px 5% 60px}
.recap-card{
  background:white;border-radius:20px;
  box-shadow:var(--shadow-md);overflow:hidden;
  margin-bottom:18px;border:1px solid var(--BDR);
  animation:fadeUp .5s var(--ease-out) both;
}
.recap-card-head{
  padding:18px 22px;
  background:linear-gradient(135deg, var(--B), var(--BM));
  display:flex;align-items:center;gap:14px;
}
.recap-card-head .ico{
  width:44px;height:44px;border-radius:13px;
  background:rgba(255,255,255,.16);
  display:flex;align-items:center;justify-content:center;
  font-size:18px;color:white;flex-shrink:0;
  border:1px solid rgba(255,255,255,.14);
}
.recap-card-head .txt h3{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:16px;font-weight:900;color:white;margin-bottom:2px;letter-spacing:-.01em;
}
.recap-card-head .txt p{font-size:11.5px;color:rgba(255,255,255,.7);font-weight:600}

.recap-ph-badge{
  background:var(--GXL);border:1px solid rgba(14,124,102,.18);
  border-radius:12px;padding:12px 16px;margin:14px 22px;
  display:flex;align-items:center;gap:12px;
}
.recap-ph-badge i{color:var(--G);font-size:15px;flex-shrink:0}
.recap-ph-badge strong{display:block;font-size:13px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif}
.recap-ph-badge span{font-size:11.5px;color:var(--MUT);font-weight:600}

.recap-item{display:flex;align-items:center;gap:14px;padding:14px 22px;border-bottom:1px solid var(--BDR)}
.recap-item:last-of-type{border-bottom:0}
.recap-item-ico{
  width:46px;height:46px;border-radius:12px;
  background:var(--GL);
  display:flex;align-items:center;justify-content:center;
  font-size:18px;color:var(--G);flex-shrink:0;
}
.recap-item-info{flex:1;min-width:0}
.recap-item-name{font-family:'Plus Jakarta Sans',sans-serif;font-size:13.5px;font-weight:800;color:var(--B);margin-bottom:3px;letter-spacing:-.01em}
.recap-item-sub{font-size:11.5px;color:var(--MUT);font-weight:600;display:inline-flex;align-items:center;gap:6px}
.recap-item-sub .rx-pill{
  background:#FEF3C7;color:#92400E;border:1px solid rgba(245,158,11,.3);
  padding:2px 7px;border-radius:100px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;
}
.recap-item-price{font-size:13px;font-weight:800;color:var(--G);flex-shrink:0;font-family:'Plus Jakarta Sans',sans-serif}

.recap-total{
  padding:16px 22px;background:var(--GXL);
  display:flex;align-items:center;justify-content:space-between;
  border-top:1px dashed var(--BDR);
}
.recap-total-lbl{font-size:13px;font-weight:700;color:var(--MUT)}
.recap-total-val{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:900;color:var(--G);letter-spacing:-.01em}

.recap-note{
  background:#FEF9E7;border:1px solid var(--WARN);border-radius:13px;
  padding:14px 16px;font-size:12.5px;color:#92400E;font-weight:600;
  display:flex;align-items:flex-start;gap:10px;margin-top:14px;line-height:1.55;
}
.recap-note i{font-size:14px;flex-shrink:0;margin-top:2px}

.recap-cta{
  width:100%;padding:17px;
  background:linear-gradient(135deg, var(--G), var(--GD));color:white;
  border:none;border-radius:14px;
  font-size:15px;font-weight:900;
  font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;
  transition:background .25s, transform .2s var(--ease-out), box-shadow .25s;
  display:flex;align-items:center;justify-content:center;gap:10px;
  box-shadow:0 10px 28px -4px rgba(14,124,102,.4);
  margin-top:18px;
}
.recap-cta:hover{background:var(--GD);transform:translateY(-2px);box-shadow:0 14px 32px -6px rgba(14,124,102,.55)}

/* ============================================
   SCREEN 4 — ORDER FORM (locked user info)
   ============================================ */
.form-wrap{max-width:760px;margin:0 auto;padding:28px 5% 80px}
.form-card{
  background:white;border-radius:20px;
  box-shadow:var(--shadow-md);padding:24px;margin-bottom:18px;
  border:1px solid var(--BDR);
  animation:fadeUp .5s var(--ease-out) both;
}
.form-section-title{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:14px;font-weight:900;color:var(--B);margin-bottom:18px;
  display:flex;align-items:center;gap:9px;
  padding-bottom:12px;border-bottom:2px solid var(--GL);
  letter-spacing:-.01em;
}
.form-section-title i{color:var(--G);font-size:13px}

/* Locked user info rows */
.user-info-locked{display:flex;flex-direction:column;gap:10px}
.uir{
  display:flex;align-items:center;gap:14px;
  padding:14px;border-radius:13px;
  background:linear-gradient(135deg, var(--GXL), white);
  border:1px solid rgba(14,124,102,.16);
  position:relative;
}
.uir-icon{
  width:42px;height:42px;border-radius:12px;
  background:white;color:var(--G);
  display:flex;align-items:center;justify-content:center;font-size:16px;
  flex-shrink:0;border:1px solid var(--BDR);
}
.uir-content{flex:1;min-width:0}
.uir-label{font-size:10px;font-weight:800;color:var(--MUT);text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px;font-family:'Plus Jakarta Sans',sans-serif}
.uir-value{font-size:14px;font-weight:700;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.01em;word-break:break-word}
.uir-verified{
  display:inline-flex;align-items:center;gap:5px;
  color:var(--OK);font-size:11px;font-weight:800;
  background:white;padding:5px 11px;border-radius:100px;
  border:1px solid rgba(16,183,106,.3);flex-shrink:0;
  font-family:'Plus Jakarta Sans',sans-serif;
}
.uir-verified i{font-size:10px}

.reassurance-note{
  background:#FFF7E6;border:1px solid #FCD34D;border-radius:13px;
  padding:14px 16px;margin-top:14px;
  display:flex;align-items:flex-start;gap:12px;
}
.reassurance-note i{font-size:18px;color:var(--GOLD-D);flex-shrink:0;margin-top:2px}
.reassurance-note strong{display:block;font-size:13px;font-weight:800;color:#78350F;margin-bottom:4px;font-family:'Plus Jakarta Sans',sans-serif}
.reassurance-note p{font-size:12.5px;color:#78350F;line-height:1.55;font-weight:500}
.reassurance-note a{color:var(--G);font-weight:800;text-decoration:underline;text-underline-offset:2px}

/* Delivery options */
.delivery-options{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.delivery-options{grid-template-columns:1fr}}
.del-opt{
  border:2px solid var(--BDR);border-radius:14px;
  padding:16px;cursor:pointer;
  transition:border-color .25s, background .25s, transform .25s var(--ease-out);
  display:flex;align-items:center;gap:12px;background:white;
}
.del-opt:hover{border-color:var(--G);background:var(--GXL)}
.del-opt.on{border-color:var(--G);background:var(--GXL);box-shadow:var(--shadow-teal)}
.del-opt-ico{
  width:42px;height:42px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;
}
.del-opt-ico.pick{background:var(--GL);color:var(--G)}
.del-opt-ico.deliv{background:#EFF6FF;color:#4285F4}
.del-opt-txt strong{display:block;font-size:13px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:2px;letter-spacing:-.01em}
.del-opt-txt span{font-size:11.5px;color:var(--MUT);font-weight:600}

/* Adresse + notes inputs */
.form-group{margin-bottom:14px}
.form-group:last-child{margin-bottom:0}
.form-label{display:block;font-size:11px;font-weight:800;color:var(--T);margin-bottom:7px;letter-spacing:.05em;text-transform:uppercase;font-family:'Plus Jakarta Sans',sans-serif}
.form-input{
  width:100%;padding:13px 16px;
  border:1.5px solid var(--BDR);border-radius:12px;
  font-size:14px;color:var(--T);font-family:'Manrope',sans-serif;
  background:#FAFBFC;transition:border-color .2s, background .2s, box-shadow .2s;
  outline:none;
}
.form-input:focus{border-color:var(--G);background:white;box-shadow:0 0 0 4px rgba(14,124,102,.1)}
.form-input::placeholder{color:#A6B0BD}
.form-textarea{resize:vertical;min-height:90px}

/* Ordonnance upload */
.ord-upload{
  border:2px dashed var(--BDR);border-radius:14px;padding:24px;text-align:center;
  cursor:pointer;transition:border-color .2s, background .2s;
  background:#FAFBFC;position:relative;
}
.ord-upload:hover{border-color:var(--G);background:var(--GXL)}
.ord-upload.has-file{border-color:var(--G);background:var(--GL);border-style:solid}
.ord-upload input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.ord-upload-ico{font-size:28px;color:var(--G);margin-bottom:8px}
.ord-upload-txt{font-size:13px;font-weight:800;color:var(--B);margin-bottom:3px;font-family:'Plus Jakarta Sans',sans-serif}
.ord-upload-sub{font-size:11px;color:var(--MUT);font-weight:500}
.rx-required-banner{
  background:#FEF3C7;border:1px solid var(--WARN);border-radius:13px;
  padding:12px 16px;margin-bottom:14px;
  display:flex;align-items:flex-start;gap:10px;font-size:12.5px;color:#92400E;font-weight:600;line-height:1.55;
}
.rx-required-banner i{font-size:15px;flex-shrink:0;margin-top:2px}

/* Position notice */
.position-notice{
  background:#EFF6FF;border:1px solid #BFDBFE;border-radius:13px;
  padding:14px 16px;display:flex;align-items:flex-start;gap:12px;margin-bottom:14px;
}
.position-notice i{font-size:18px;color:#2563EB;flex-shrink:0;margin-top:2px}
.position-notice strong{display:block;font-size:13px;font-weight:800;color:#1E3A8A;margin-bottom:3px;font-family:'Plus Jakarta Sans',sans-serif}
.position-notice p{font-size:12.5px;color:#1E40AF;line-height:1.55;font-weight:500}

/* Order summary mini */
.order-summary-mini{
  background:var(--GXL);border:1px solid rgba(14,124,102,.2);
  border-radius:13px;padding:14px 18px;margin-bottom:16px;
}
.osm-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;color:var(--G);margin-bottom:10px;display:flex;align-items:center;gap:7px;letter-spacing:-.01em}
.osm-row{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:var(--T);font-weight:600;margin-bottom:6px}
.osm-row span:first-child{flex:1;padding-right:10px}
.osm-row.total{color:var(--B);font-weight:900;font-size:14px;border-top:1px solid rgba(14,124,102,.2);padding-top:8px;margin-top:8px;font-family:'Plus Jakarta Sans',sans-serif}

/* Terms checkbox */
.terms-wrap{
  background:white;border:2px solid var(--BDR);border-radius:14px;
  padding:16px;margin-bottom:18px;
  transition:border-color .25s, background .25s;
}
.terms-wrap.checked{border-color:var(--G);background:var(--GXL)}
.terms-checkbox{
  display:flex;align-items:flex-start;gap:12px;cursor:pointer;user-select:none;
}
.terms-checkbox input{position:absolute;opacity:0;width:0;height:0}
.terms-checkbox .box{
  width:22px;height:22px;border-radius:7px;
  border:2px solid var(--BDR);background:white;
  display:flex;align-items:center;justify-content:center;
  font-size:12px;color:transparent;flex-shrink:0;margin-top:1px;
  transition:background .2s, border-color .2s, color .2s, transform .2s var(--ease-spring);
}
.terms-checkbox input:checked ~ .box{background:var(--G);border-color:var(--G);color:white;transform:scale(1.05)}
.terms-checkbox input:focus-visible ~ .box{box-shadow:0 0 0 3px rgba(14,124,102,.24)}
.terms-text{font-size:13px;line-height:1.55;color:var(--T);font-weight:500}
.terms-text strong{color:var(--B);font-weight:800;font-family:'Plus Jakarta Sans',sans-serif}
.terms-text a{color:var(--G);font-weight:800;text-decoration:underline;text-underline-offset:2px}

.submit-btn{
  width:100%;padding:18px;
  background:linear-gradient(135deg, var(--G), var(--GD));color:white;
  border:none;border-radius:14px;
  font-size:16px;font-weight:900;
  font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;
  transition:background .25s, transform .2s var(--ease-out), box-shadow .25s, opacity .25s, filter .25s;
  display:flex;align-items:center;justify-content:center;gap:10px;
  box-shadow:0 10px 32px -4px rgba(14,124,102,.45);
}
.submit-btn:disabled{
  opacity:.45;cursor:not-allowed;pointer-events:none;
  filter:grayscale(.5);
  box-shadow:none;
}
.submit-btn:not(:disabled):hover{background:var(--GD);transform:translateY(-2px);box-shadow:0 14px 36px -6px rgba(14,124,102,.55)}

/* ============================================
   SCREEN 5 — SUCCESS
   ============================================ */
.success-wrap{max-width:560px;margin:0 auto;padding:60px 5% 60px;text-align:center}
.success-icon{
  width:104px;height:104px;border-radius:50%;
  background:linear-gradient(135deg, var(--G), var(--GD));
  margin:0 auto 24px;
  display:flex;align-items:center;justify-content:center;
  font-size:44px;color:white;
  box-shadow:0 16px 40px rgba(14,124,102,.35);
  animation:popIn .55s var(--ease-spring) both;
  position:relative;
}
.success-icon::before{
  content:'';position:absolute;inset:-14px;border-radius:50%;
  border:2px solid var(--G);opacity:.25;
  animation:ringExpand 1.8s ease-out infinite;
}
@keyframes ringExpand{0%{transform:scale(.92);opacity:.6}100%{transform:scale(1.25);opacity:0}}
@keyframes popIn{from{transform:scale(.5);opacity:0}to{transform:scale(1);opacity:1}}
.success-title{font-size:26px;font-weight:900;color:var(--B);margin-bottom:10px;letter-spacing:-.02em}
.success-sub{font-size:14.5px;color:var(--MUT);line-height:1.7;margin-bottom:24px;font-weight:500}
.success-order-id{
  display:inline-block;
  background:linear-gradient(135deg, var(--GL), white);
  border:1px solid rgba(14,124,102,.25);border-radius:12px;
  padding:12px 28px;
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:18px;font-weight:900;color:var(--G);
  letter-spacing:.08em;margin-bottom:28px;
}
.success-steps{
  text-align:left;background:white;border-radius:16px;
  border:1px solid var(--BDR);overflow:hidden;margin-bottom:28px;
  box-shadow:var(--shadow-sm);
}
.ss-item{display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--BDR)}
.ss-item:last-child{border:0}
.ss-ico{
  width:38px;height:38px;border-radius:11px;
  background:var(--GL);color:var(--G);
  display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;
}
.ss-txt strong{display:block;font-size:13px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:2px}
.ss-txt span{font-size:11.5px;color:var(--MUT);font-weight:500}
.success-home{
  display:inline-flex;align-items:center;gap:9px;
  background:var(--G);color:white;
  padding:14px 32px;border-radius:13px;
  font-weight:800;font-size:14px;font-family:'Plus Jakarta Sans',sans-serif;
  cursor:pointer;border:none;
  transition:background .2s, transform .2s var(--ease-out);
}
.success-home:hover{background:var(--GD);transform:translateY(-1px)}

/* ============================================
   TOAST
   ============================================ */
.toast{
  position:fixed;bottom:24px;left:50%;
  transform:translateX(-50%) translateY(20px);
  background:var(--B);color:white;
  padding:12px 22px;border-radius:100px;
  font-size:13px;font-weight:700;z-index:9999;
  opacity:0;transition:opacity .3s, transform .3s var(--ease-spring);
  pointer-events:none;white-space:nowrap;
  box-shadow:var(--shadow-lg);
  font-family:'Plus Jakarta Sans',sans-serif;
}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}

/* ============================================
   RESPONSIVE
   ============================================ */
@media(max-width:640px){
  .search-wrap{padding:20px 14px 0}
  .search-hero h1{font-size:22px}
  .search-hero p{font-size:13px}
  .search-input-wrap input{padding:14px 16px;font-size:14px}
  .search-submit{padding:0 18px;height:52px;font-size:13px}
  .sec-head{padding:22px 14px 12px}
  .sec-head h2{font-size:16px}
  .med-wrap{padding:18px 14px 100px}
  .med-ph-card{padding:14px;gap:12px}
  .med-ph-img{width:62px;height:62px;border-radius:12px}
  .pm-section{margin:10px;padding:16px}
  .pm-hero{height:170px}
  .acc-img{height:100px}
  .recap-wrap{padding:20px 14px 60px}
  .recap-card-head{padding:16px 18px}
  .recap-ph-badge{margin:12px 18px}
  .recap-item{padding:12px 18px;gap:12px}
  .recap-item-ico{width:40px;height:40px;font-size:16px}
  .recap-total{padding:14px 18px}
  .recap-total-val{font-size:17px}
  .form-wrap{padding:20px 14px 60px}
  .form-card{padding:18px}
  .uir{padding:12px;gap:10px}
  .uir-icon{width:38px;height:38px}
  .uir-value{font-size:13.5px}
  .uir-verified{font-size:10px;padding:4px 9px}
  .terms-text{font-size:12.5px}
  .float-cmd{padding:14px 32px;font-size:14px;bottom:18px}
}

@media(prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
</style>
