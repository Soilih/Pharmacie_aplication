/* ============================================
   NAV
   ============================================ */
function showScreen(id){
  document.querySelectorAll('.screen').forEach(function(s){ s.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
  window.scrollTo(0, 0);
}
function pushScreen(id){ screenHistory.push(id); showScreen(id); }
function goBack(){
  if(document.getElementById('phModal').classList.contains('open')){ closePhModal(); return; }
  if(screenHistory.length > 1){
    screenHistory.pop();
    showScreen(screenHistory[screenHistory.length - 1]);
  } else { window.history.back(); }
}
function goHome(){ window.location.href = '/'; }

/* ============================================
   SEARCH TABS
   ============================================ */
function switchTab(tab){
  currentTab = tab;
  document.getElementById('tabMed').className = 'stab' + (tab === 'med' ? ' on' : '');
  document.getElementById('tabPh').className  = 'stab' + (tab === 'ph'  ? ' on' : '');
  var input = document.getElementById('mainSearchInput');
  input.placeholder = tab === 'med' ? 'Ex: Paracétamol, Amoxicilline…' : 'Ex: Pharmacie Centrale…';
  input.value = '';
  renderMainGrid(PH);
}

function onSearchInput(){
  var q = document.getElementById('mainSearchInput').value.toLowerCase().trim();
  if(currentTab === 'ph'){
    renderMainGrid(q ? PH.filter(function(p){ return p.name.toLowerCase().includes(q); }) : PH);
  }
}

function quickSearch(term){
  currentTab = 'med';
  document.getElementById('tabMed').className = 'stab on';
  document.getElementById('tabPh').className  = 'stab';
  document.getElementById('mainSearchInput').value = term;
  doSearch();
}

function doSearch(){
  var q = document.getElementById('mainSearchInput').value.trim();
  if(!q){ showToast('Entrez un terme de recherche'); return; }
  if(currentTab === 'ph'){
    var filtered = PH.filter(function(p){ return p.name.toLowerCase().includes(q.toLowerCase()); });
    renderMainGrid(filtered);
    document.getElementById('phCount').textContent = filtered.length;
    return;
  }
  // Med search → list pharmacies that have it
  selectedPharmaciesForMed = [];
  updateFloatBtn();
  var qn = normalizeStr(q);
  var results = PH.filter(function(p){
    return p.meds.some(function(m){ return normalizeStr(m).includes(qn); });
  });
  document.getElementById('medQueryTxt').textContent = q;
  document.getElementById('medQueryCount').textContent = results.length + ' pharmacie' + (results.length > 1 ? 's' : '') + ' disponible' + (results.length > 1 ? 's' : '');
  document.getElementById('medWarn').classList.remove('show');
  var list = document.getElementById('medPhList');
  var empty = document.getElementById('medEmpty');
  if(!results.length){
    list.innerHTML = ''; empty.style.display = 'block';
  } else {
    empty.style.display = 'none';
    list.innerHTML = results.map(function(ph){
      var matched = ph.meds.filter(function(m){ return normalizeStr(m).includes(qn); });
      return '<div class="med-ph-card" id="mpc-' + ph.id + '" onclick="toggleMedPh(' + ph.id + ')">' +
        '<img class="med-ph-img" src="' + ph.img + '" alt="' + ph.name + '" loading="lazy">' +
        '<div class="med-ph-info">' +
          '<div class="med-ph-name">' + ph.name + '</div>' +
          '<div class="med-ph-loc"><i class="fa-solid fa-location-dot"></i>' + ph.zone + ' · ' + ph.dist + '</div>' +
          '<div class="med-ph-stock"><i class="fa-solid fa-circle-check"></i>' + matched.join(', ') + '</div>' +
        '</div>' +
        '<div class="med-ph-check"><i class="fa-solid fa-check"></i></div>' +
      '</div>';
    }).join('');
  }
  pushScreen('screenMed');
}

function toggleMedPh(id){
  var idx = selectedPharmaciesForMed.indexOf(id);
  if(idx >= 0){
    selectedPharmaciesForMed.splice(idx, 1);
    document.getElementById('mpc-' + id).classList.remove('selected');
  } else {
    if(selectedPharmaciesForMed.length >= 3){
      document.getElementById('medWarn').classList.add('show');
      showToast('Maximum 3 pharmacies');
      return;
    }
    selectedPharmaciesForMed.push(id);
    document.getElementById('mpc-' + id).classList.add('selected');
  }
  updateFloatBtn();
}

function updateFloatBtn(){
  var n = selectedPharmaciesForMed.length;
  document.getElementById('fcBadge').textContent = n;
  document.getElementById('floatCmd').className = 'float-cmd' + (n > 0 ? ' show' : '');
}

function goRecapFromMed(){
  if(!selectedPharmaciesForMed.length) return;
  var q = document.getElementById('mainSearchInput').value.trim();
  orderData.pharmacies = PH.filter(function(p){ return selectedPharmaciesForMed.indexOf(p.id) >= 0; });
  // For med-search flow: 1 medicament across multiple pharmacies
  orderData.items = [{ id:'med1', name:q, price:0, icon:'fa-solid fa-pills', type:'medicament', rx:false }];
  orderData.source = 'med';
  renderRecap();
  pushScreen('screenRecap');
  document.getElementById('floatCmd').classList.remove('show');
}

/* ============================================
   PHARMACY GRID
   ============================================ */
function renderMainGrid(data){
  var grid = document.getElementById('mainPhGrid');
  var empty = document.getElementById('mainEmpty');
  document.getElementById('phCount').textContent = data.length;
  if(!data.length){ grid.innerHTML = ''; empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  grid.innerHTML = data.map(function(ph){
    return '<div class="ph-card" onclick="openPhModal(' + ph.id + ')">' +
      '<div class="ph-card-img">' +
        '<img src="' + ph.img + '" alt="' + ph.name + '" loading="lazy">' +
        '<span class="ph-card-badge b-' + ph.status + '"><i class="fa-solid ' + (ph.status === 'guard' ? 'fa-moon' : ph.status === 'open' ? 'fa-check' : 'fa-xmark') + '"></i>' + ph.label + '</span>' +
      '</div>' +
      '<div class="ph-card-body">' +
        '<div class="ph-card-name">' + ph.name + '</div>' +
        '<div class="ph-card-loc"><i class="fa-solid fa-location-dot"></i>' + ph.zone + ' · ' + ph.dist + '</div>' +
        '<button class="ph-btn-view" onclick="event.stopPropagation();openPhModal(' + ph.id + ')"><i class="fa-solid fa-store"></i>Voir produits</button>' +
      '</div></div>';
  }).join('');
}

/* ============================================
   PHARMACY MODAL
   ============================================ */
function openPhModal(id){
  var ph = PH.find(function(p){ return p.id === id; });
  if(!ph) return;
  currentPharmacy = ph;
  selectedAccessories = [];
  selectedMeds = [];
  updatePmFooter();
  document.getElementById('pmTitle').textContent = ph.name;
  document.getElementById('pmSub').textContent = ph.zone + ' · ' + ph.dist;

  var statusBg = ph.status === 'open' ? 'rgba(18,183,106,.95)' : ph.status === 'guard' ? 'rgba(244,196,48,.96)' : 'rgba(240,68,56,.9)';
  var statusColor = ph.status === 'guard' ? '#5B3F00' : 'white';

  var accGrid = ACCESSORIES.map(function(acc){
    return '<div class="acc-item" id="acc-' + acc.id + '" onclick="toggleAcc(\'' + acc.id + '\')">' +
      '<div class="acc-img">' +
        '<img src="' + acc.img + '" alt="' + acc.name + '" loading="lazy" onerror="this.classList.add(\'broken\')">' +
        '<div class="fallback"><i class="fa-solid ' + acc.icon + '"></i></div>' +
        '<div class="acc-check"><i class="fa-solid fa-check"></i></div>' +
      '</div>' +
      '<div class="acc-info">' +
        '<div class="acc-name">' + acc.name + '</div>' +
        '<div class="acc-price">' + acc.price.toLocaleString('fr-FR') + ' KMF</div>' +
      '</div>' +
    '</div>';
  }).join('');

  document.getElementById('pmBody').innerHTML =
    '<div class="pm-hero">' +
      '<img src="' + ph.img + '" alt="' + ph.name + '" loading="lazy">' +
      '<div class="pm-hero-overlay">' +
        '<h2>' + ph.name + '</h2>' +
        '<div class="meta"><i class="fa-solid fa-location-dot"></i> ' + ph.zone + ' · ' + ph.dist + '</div>' +
      '</div>' +
      '<span class="status" style="background:' + statusBg + ';color:' + statusColor + '">' + ph.label + '</span>' +
    '</div>' +

    '<div class="pm-section">' +
      '<div class="pm-section-title"><i class="fa-solid fa-magnifying-glass"></i>Rechercher un médicament</div>' +
      '<div class="med-search-input">' +
        '<i class="fa-solid fa-pills"></i>' +
        '<input type="text" id="medSearchInput" placeholder="Tapez un nom de médicament…" autocomplete="off" oninput="onMedSearch()">' +
      '</div>' +
      '<div class="med-results-count" id="searchResultsCount"></div>' +
      '<div id="medSearchResults" class="med-list"></div>' +
      '<div id="selectedMedsPreview" class="selected-meds-preview">' +
        '<div class="smp-title">Médicaments sélectionnés</div>' +
        '<div class="smp-tags" id="selectedMedsTags"></div>' +
      '</div>' +
    '</div>' +

    '<div class="pm-section">' +
      '<div class="pm-section-title"><i class="fa-solid fa-stethoscope"></i>Accessoires médicaux</div>' +
      '<div class="acc-grid">' + accGrid + '</div>' +
    '</div>' +

    '<div class="pm-section">' +
      '<div class="pm-section-title"><i class="fa-regular fa-clock"></i>Informations</div>' +
      '<div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--T);font-weight:600;margin-bottom:8px"><i class="fa-regular fa-clock" style="color:var(--G);width:16px"></i>Horaires : <strong style="color:var(--B);font-weight:800">' + ph.hours + '</strong></div>' +
      '<div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--T);font-weight:600"><i class="fa-solid fa-phone" style="color:var(--G);width:16px"></i>Téléphone : <strong style="color:var(--B);font-weight:800">' + ph.phone + '</strong></div>' +
    '</div>';

  document.getElementById('phModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closePhModal(){
  document.getElementById('phModal').classList.remove('open');
  document.body.style.overflow = '';
}

/* ============================================
   MED SEARCH INSIDE PHARMACY
   ============================================ */
function onMedSearch(){
  var input = document.getElementById('medSearchInput');
  var q = input.value.trim().toLowerCase();
  var resDiv = document.getElementById('medSearchResults');
  var cntDiv = document.getElementById('searchResultsCount');
  if(!q){
    resDiv.innerHTML = '';
    cntDiv.innerHTML = '';
    updateSelectedMedsPreview();
    return;
  }
  var filtered = MEDS_DB.filter(function(m){ return m.n.toLowerCase().includes(q); });
  if(!filtered.length){
    resDiv.innerHTML = '<div style="padding:14px;text-align:center;color:var(--MUT);font-size:12.5px;font-weight:600">Aucun médicament trouvé</div>';
    cntDiv.innerHTML = '';
  } else {
    cntDiv.innerHTML = filtered.length + ' médicament' + (filtered.length > 1 ? 's' : '') + ' trouvé' + (filtered.length > 1 ? 's' : '');
    resDiv.innerHTML = filtered.map(function(med){
      var sel = selectedMeds.some(function(s){ return s.n === med.n; });
      var rxBadge = med.rx
        ? '<span class="med-item-rx rx"><i class="fa-solid fa-file-prescription"></i>Ordonnance</span>'
        : '<span class="med-item-rx free"><i class="fa-solid fa-check"></i>Libre</span>';
      return '<div class="med-item' + (sel ? ' selected' : '') + '" onclick="toggleMedSel(' + escAttr(med.n) + ',' + med.rx + ')">' +
        '<span class="med-item-name">' + med.n + '</span>' +
        rxBadge +
        '<div class="med-item-check"><i class="fa-solid fa-check"></i></div>' +
      '</div>';
    }).join('');
  }
  updateSelectedMedsPreview();
}

function escAttr(s){ return "'" + s.replace(/'/g, "\\'") + "'"; }

function toggleMedSel(name, rx){
  var idx = selectedMeds.findIndex(function(m){ return m.n === name; });
  if(idx >= 0) selectedMeds.splice(idx, 1);
  else selectedMeds.push({n:name, rx:rx});
  onMedSearch();
  updatePmFooter();
}

function updateSelectedMedsPreview(){
  var preview = document.getElementById('selectedMedsPreview');
  var tags = document.getElementById('selectedMedsTags');
  if(!preview || !tags) return;
  if(!selectedMeds.length){ preview.classList.remove('show'); return; }
  preview.classList.add('show');
  tags.innerHTML = selectedMeds.map(function(m){
    var cls = m.rx ? 'med-tag rx' : 'med-tag';
    var dot = m.rx ? '<span class="rx-dot" title="Sur ordonnance"></span>' : '';
    return '<span class="' + cls + '">' + dot + m.n + ' <span class="x" onclick="event.stopPropagation();removeMedSel(' + escAttr(m.n) + ')"><i class="fa-solid fa-xmark"></i></span></span>';
  }).join('');
}

function removeMedSel(name){
  var idx = selectedMeds.findIndex(function(m){ return m.n === name; });
  if(idx >= 0) selectedMeds.splice(idx, 1);
  onMedSearch();
  updatePmFooter();
}

/* ============================================
   ACCESSORIES
   ============================================ */
function toggleAcc(id){
  var acc = ACCESSORIES.find(function(a){ return a.id === id; });
  if(!acc) return;
  var idx = selectedAccessories.findIndex(function(a){ return a.id === id; });
  if(idx >= 0){
    selectedAccessories.splice(idx, 1);
    document.getElementById('acc-' + id).classList.remove('selected');
  } else {
    if(selectedAccessories.length >= 6){ showToast('Maximum 6 accessoires'); return; }
    selectedAccessories.push(acc);
    document.getElementById('acc-' + id).classList.add('selected');
  }
  updatePmFooter();
}

function updatePmFooter(){
  var totalItems = selectedAccessories.length + selectedMeds.length;
  var totalPrice = selectedAccessories.reduce(function(s, a){ return s + a.price; }, 0);
  var footer = document.getElementById('pmFooter');
  if(totalItems > 0){
    footer.classList.add('show');
  } else {
    footer.classList.remove('show');
  }
  document.getElementById('pmSelCountTxt').textContent = totalItems + ' article' + (totalItems > 1 ? 's' : '');
  document.getElementById('pmSelTotal').textContent = totalPrice > 0 ? totalPrice.toLocaleString('fr-FR') + ' KMF' : '';
}

function goRecapFromPharmacy(){
  if(selectedAccessories.length === 0 && selectedMeds.length === 0){
    showToast('Sélectionnez au moins un médicament ou un accessoire');
    return;
  }
  var items = [];
  selectedMeds.forEach(function(m){
    items.push({
      id: 'med_' + m.n.replace(/\s/g, '_'),
      name: m.n,
      price: 0,
      icon: 'fa-solid fa-pills',
      type: 'medicament',
      rx: m.rx
    });
  });
  selectedAccessories.forEach(function(acc){
    items.push({
      id: acc.id,
      name: acc.name,
      price: acc.price,
      img: acc.img,
      icon: 'fa-solid ' + acc.icon,
      type: 'accessoire',
      rx: false
    });
  });
  orderData.pharmacies = [currentPharmacy];
  orderData.items = items;
  orderData.source = 'pharmacy';
  closePhModal();
  renderRecap();
  pushScreen('screenRecap');
}

/* ============================================
   RECAP RENDER
   ============================================ */
function renderRecap(){
  var totalPrice = orderData.items.reduce(function(s, i){ return s + (i.price || 0); }, 0);
  var html = '';
  orderData.pharmacies.forEach(function(ph){
    var itemsHtml = orderData.items.map(function(item){
      var typeLabel = item.type === 'medicament'
        ? (item.rx ? 'Médicament sur ordonnance' : 'Médicament')
        : 'Accessoire médical';
      var rxPill = item.rx ? '<span class="rx-pill"><i class="fa-solid fa-file-prescription"></i> Rx</span>' : '';
      var icoContent = item.img
        ? '<img src="' + item.img + '" alt="" style="width:46px;height:46px;border-radius:12px;object-fit:cover">'
        : '<i class="' + (item.icon || 'fa-solid fa-pills') + '"></i>';
      return '<div class="recap-item">' +
        (item.img
          ? '<div style="flex-shrink:0">' + icoContent + '</div>'
          : '<div class="recap-item-ico">' + icoContent + '</div>') +
        '<div class="recap-item-info">' +
          '<div class="recap-item-name">' + item.name + '</div>' +
          '<div class="recap-item-sub">' + typeLabel + (item.rx ? ' ' + rxPill : '') + '</div>' +
        '</div>' +
        '<div class="recap-item-price">' + (item.price > 0 ? item.price.toLocaleString('fr-FR') + ' KMF' : 'Sur devis') + '</div>' +
      '</div>';
    }).join('');

    html += '<div class="recap-card">' +
      '<div class="recap-card-head">' +
        '<div class="ico"><i class="fa-solid fa-store"></i></div>' +
        '<div class="txt"><h3>' + ph.name + '</h3><p>' + ph.zone + ' · ' + ph.hours + '</p></div>' +
      '</div>' +
      '<div class="recap-ph-badge">' +
        '<i class="fa-solid fa-phone"></i>' +
        '<div><strong>' + ph.name + '</strong><span>' + ph.phone + '</span></div>' +
      '</div>' +
      itemsHtml +
      (totalPrice > 0 && orderData.source === 'pharmacy'
        ? '<div class="recap-total"><span class="recap-total-lbl">Total estimé</span><span class="recap-total-val">' + totalPrice.toLocaleString('fr-FR') + ' KMF</span></div>'
        : '') +
    '</div>';
  });
  document.getElementById('recapContent').innerHTML = html;
}

/* ============================================
   ORDER FORM
   ============================================ */
function goOrderForm(){
  // Fill user info (locked)
  document.getElementById('uName').textContent  = USER.prenom + ' ' + USER.nom;
  document.getElementById('uTel').textContent   = USER.tel;
  document.getElementById('uEmail').textContent = USER.email;

  // Show Rx banner if any item requires ordonnance
  var hasRx = orderData.items.some(function(i){ return i.rx; });
  document.getElementById('rxBanner').style.display = hasRx ? 'flex' : 'none';

  // Mini summary
  var totalPrice = orderData.items.reduce(function(s, i){ return s + (i.price || 0); }, 0);
  var html = '<div class="osm-title"><i class="fa-solid fa-receipt"></i>Résumé de la commande</div>' +
    orderData.items.map(function(i){
      return '<div class="osm-row"><span>' + i.name + (i.rx ? ' <span style="color:var(--WARN);font-weight:800;font-size:10px"> · Rx</span>' : '') + '</span><span>' + (i.price > 0 ? i.price.toLocaleString('fr-FR') + ' KMF' : 'Sur devis') + '</span></div>';
    }).join('') +
    '<div class="osm-row total"><span>Total estimé</span><span>' + (totalPrice > 0 ? totalPrice.toLocaleString('fr-FR') + ' KMF' : 'Sur devis') + '</span></div>';
  document.getElementById('orderSummaryMini').innerHTML = html;

  // Reset terms
  document.getElementById('termsCheck').checked = false;
  document.getElementById('termsWrap').classList.remove('checked');
  document.getElementById('submitBtn').disabled = true;

  pushScreen('screenForm');
}

function selectDel(mode){
  orderData.deliveryMode = mode;
  document.getElementById('delRetrait').className   = 'del-opt' + (mode === 'retrait' ? ' on' : '');
  document.getElementById('delLivraison').className = 'del-opt' + (mode === 'livraison' ? ' on' : '');
  document.getElementById('addrGroup').style.display = mode === 'livraison' ? 'block' : 'block';
}

function handleFile(input){
  if(input.files && input.files[0]){
    var upload = document.getElementById('ordUpload');
    upload.classList.add('has-file');
    upload.querySelector('.ord-upload-txt').textContent = input.files[0].name;
    upload.querySelector('.ord-upload-ico').innerHTML = '<i class="fa-solid fa-circle-check"></i>';
  }
}

function toggleTerms(){
  var c = document.getElementById('termsCheck');
  var wrap = document.getElementById('termsWrap');
  var btn = document.getElementById('submitBtn');
  if(c.checked){
    wrap.classList.add('checked');
    btn.disabled = false;
  } else {
    wrap.classList.remove('checked');
    btn.disabled = true;
  }
}

function submitOrder(){
  if(!document.getElementById('termsCheck').checked){
    showToast('Vous devez accepter les conditions');
    return;
  }
  // Check Rx upload if needed
  var hasRx = orderData.items.some(function(i){ return i.rx; });
  if(hasRx && !document.getElementById('ordUpload').classList.contains('has-file')){
    showToast('Veuillez joindre votre ordonnance');
    return;
  }
  document.getElementById('successOrderId').textContent = '#LP-' + Math.floor(1000 + Math.random() * 9000);
  pushScreen('screenSuccess');
}

/* ============================================
   HELPERS
   ============================================ */
function normalizeStr(s){
  return s.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[-_\s]/g, '');
}

function showToast(msg){
  var t = document.getElementById('toastEl');
  t.textContent = msg;
  t.className = 'toast on';
  clearTimeout(t._t);
  t._t = setTimeout(function(){ t.className = 'toast'; }, 2800);
}

/* ============================================
   INIT
   ============================================ */
renderMainGrid(PH);
</script>
</body>
</html>
