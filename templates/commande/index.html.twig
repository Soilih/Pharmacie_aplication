{# ===== SCREEN 1 : Search Hub ===== #}
<div class="screen active" id="screenSearch">
  <div class="search-wrap">
    <div class="search-hero">
      <span class="sh-eyebrow">Commande en ligne · Locapharma</span>
      <h1>Que cherchez-vous aujourd'hui ?</h1>
      <p>Recherchez un médicament dans toutes les pharmacies, ou parcourez une pharmacie en particulier.</p>
    </div>

    <div class="search-box">
      <div class="search-tabs">
        <div class="stab on" id="tabMed" onclick="switchTab('med')"><i class="fa-solid fa-pills"></i>Par médicament</div>
        <div class="stab" id="tabPh" onclick="switchTab('ph')"><i class="fa-solid fa-store"></i>Par pharmacie</div>
      </div>
      <div class="search-input-wrap">
        <input type="text" id="mainSearchInput" placeholder="Ex: Paracétamol, Amoxicilline…" autocomplete="off" oninput="onSearchInput()" onkeydown="if(event.key==='Enter')doSearch()">
        <button class="search-submit" onclick="doSearch()"><i class="fa-solid fa-magnifying-glass"></i>Rechercher</button>
      </div>
    </div>

    <div class="search-hint">
      <span class="label">Suggestions :</span>
      <span class="chip" onclick="quickSearch('Paracetamol')"><i class="fa-solid fa-pills"></i>Paracétamol</span>
      <span class="chip" onclick="quickSearch('Amoxicilline')"><i class="fa-solid fa-capsules"></i>Amoxicilline</span>
      <span class="chip" onclick="quickSearch('Ibuprofene')"><i class="fa-solid fa-tablets"></i>Ibuprofène</span>
      <span class="chip" onclick="quickSearch('Doliprane')"><i class="fa-solid fa-pills"></i>Doliprane</span>
      <span class="chip" onclick="quickSearch('Sirop')"><i class="fa-solid fa-bottle-droplet"></i>Sirop</span>
    </div>
  </div>

  <div class="sec-head">
    <div>
      <h2><i class="fa-solid fa-store"></i>Toutes nos pharmacies partenaires <span class="badge-count" id="phCount">8</span></h2>
      <p>Cliquez sur une pharmacie pour voir ses médicaments et accessoires.</p>
    </div>
  </div>

  <div class="ph-grid-wrap">
    <div class="ph-grid" id="mainPhGrid"></div>
    <div class="empty-state" id="mainEmpty" style="display:none">
      <i class="fa-solid fa-binoculars"></i>
      <h3>Aucune pharmacie trouvée</h3>
      <p>Essayez un autre terme de recherche.</p>
    </div>
  </div>
</div>

{# ===== SCREEN 2 : Med results (multi-pharmacy) ===== #}
<div class="screen" id="screenMed">
  <div class="med-wrap">
    <button class="back-btn" onclick="goBack()"><i class="fa-solid fa-arrow-left"></i>Retour</button>

    <div class="med-query-badge">
      <div class="ico"><i class="fa-solid fa-pills"></i></div>
      <div class="txt">
        <span class="q" id="medQueryTxt">—</span>
        <span class="c" id="medQueryCount">— pharmacie(s) disponible(s)</span>
      </div>
    </div>

    <div class="med-limit-info">
      <i class="fa-solid fa-circle-info"></i>
      <span>Sélectionnez jusqu'à <strong>3 pharmacies</strong> pour comparer leurs offres et passer une commande groupée.</span>
    </div>

    <div class="med-limit-warn" id="medWarn">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span><strong>Maximum 3 pharmacies.</strong> Désélectionnez-en une pour en choisir une autre.</span>
    </div>

    <div id="medPhList"></div>
    <div class="empty-state" id="medEmpty" style="display:none">
      <i class="fa-solid fa-face-sad-tear"></i>
      <h3>Médicament non disponible</h3>
      <p>Aucune pharmacie partenaire ne dispose de ce médicament en ce moment.</p>
    </div>
  </div>
</div>

