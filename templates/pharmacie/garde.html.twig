</div>

{# ===== Call modal ===== #}
<div class="call-modal" id="callModal">
  <div class="call-sheet">
    <div class="call-avatar"><i class="fa-solid fa-phone"></i></div>
    <div class="call-label">Pharmacie de garde</div>
    <div class="call-name">Pharmacie Al-Amal</div>
    <div class="call-number">+269 773 90 11</div>
    <div class="call-buttons">
      <button class="call-cancel" onclick="closeCall()"><i class="fa-solid fa-xmark"></i> Annuler</button>
      <button class="call-confirm" id="callConfirm"><i class="fa-solid fa-phone"></i> Appeler maintenant</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ============================================
// DATA
// ============================================
const guardPharmacy = {
  phone: "+269 773 90 11",
  wa:    "26977390011",
  lat:   -11.6958,
  lng:   43.2590,
  start: new Date(2025, 4, 5),
  end:   new Date(2025, 4, 11, 23, 59, 59)
};

// ============================================
// DATES
// ============================================
const weekdays = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
const months   = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];
function formatDate(d){ return weekdays[d.getDay()] + ' ' + d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear(); }

document.getElementById('dateStart').textContent = formatDate(guardPharmacy.start);
document.getElementById('dateEnd').textContent   = formatDate(guardPharmacy.end);
const days = Math.max(1, Math.round((guardPharmacy.end - guardPharmacy.start) / 86400000));
document.getElementById('dateDuration').textContent = days + ' jour' + (days > 1 ? 's' : '');

// ============================================
// CAROUSEL
// ============================================
const slides = document.querySelectorAll('.car-slide');
let cur = 0;
let carouselTimer;

const dotsHost = document.getElementById('carDots');
slides.forEach((_, i) => {
  const d = document.createElement('button');
  d.className = 'car-dot' + (i === 0 ? ' on' : '');
  d.setAttribute('aria-label', 'Slide ' + (i + 1));
  d.onclick = () => setSlide(i);
  dotsHost.appendChild(d);
});

function setSlide(n){
  slides[cur].classList.remove('on');
  dotsHost.children[cur].classList.remove('on');
  cur = (n + slides.length) % slides.length;
  slides[cur].classList.add('on');
  dotsHost.children[cur].classList.add('on');
}
function galMove(dir){ clearInterval(carouselTimer); setSlide(cur + dir); startCarousel(); }
function startCarousel(){ carouselTimer = setInterval(() => setSlide(cur + 1), 5500); }
startCarousel();

// Pause on hover (desktop)
const carEl = document.getElementById('carousel');
carEl.addEventListener('mouseenter', () => clearInterval(carouselTimer));
carEl.addEventListener('mouseleave', startCarousel);

// ============================================
// MAP (Leaflet + routes)
// ============================================
let map, userLat = null, userLng = null, routeLines = [], userMarker = null;
const routeColors = [
  { color: '#4285F4',             weight: 6, opacity: 0.92, dashArray: null   },
  { color: 'rgba(66,133,244,.55)', weight: 4, opacity: 0.8,  dashArray: '9,7' },
  { color: '#1565C0',             weight: 4, opacity: 0.72, dashArray: '4,8' }
];
function lerp(a, b, t){ return a + (b - a) * t; }
function generateRoute(lat1, lng1, lat2, lng2, wLat, wLng){
  const pts = [];
  for(let i = 0; i <= 28; i++){
    const t = i / 28;
    const w = Math.sin(t * Math.PI);
    pts.push([ lerp(lat1, lat2, t) + wLat * w, lerp(lng1, lng2, t) + wLng * w ]);
  }
  return pts;
}
function haversine(lat1, lng1, lat2, lng2){
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2 +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
function fmtKm(km){ return km < 1 ? Math.round(km * 1000) + ' m' : km.toFixed(1) + ' km'; }

function drawRoutes(lat, lng){
  routeLines.forEach(l => map.removeLayer(l));
  routeLines = [];
  if(userMarker) map.removeLayer(userMarker);

  const { lat: tLat, lng: tLng } = guardPharmacy;
  const dLat = tLat - lat, dLng = tLng - lng;
  const routes = [
    generateRoute(lat, lng, tLat, tLng, dLat *  0.04, dLng * -0.05),
    generateRoute(lat, lng, tLat, tLng, dLat * -0.08, dLng *  0.07),
    generateRoute(lat, lng, tLat, tLng, dLat *  0.06, dLng *  0.09)
  ];
  [2, 1, 0].forEach(i => {
    const l = L.polyline(routes[i], { ...routeColors[i], lineCap: 'round', lineJoin: 'round' }).addTo(map);
    routeLines.push(l);
  });
  userMarker = L.marker([lat, lng], {
    icon: L.divIcon({
      html: '<div style="background:#4285F4;width:24px;height:24px;border-radius:50%;border:3px solid white;box-shadow:0 0 0 5px rgba(66,133,244,.25);display:flex;align-items:center;justify-content:center"><i class="fa-solid fa-user" style="color:white;font-size:9px"></i></div>',
      iconSize: [24, 24],
      className: 'user-marker'
    })
  }).addTo(map);

  const bounds = L.latLngBounds(routes.flat());
  map.fitBounds(bounds, { padding: [60, 60] });

  const km   = haversine(lat, lng, tLat, tLng);
  const mins = Math.max(1, Math.round(km / 30 * 60));
  document.getElementById('mapSub').textContent  = fmtKm(km) + ' · ~' + mins + ' min · 3 itinéraires';
  document.getElementById('heroDist').textContent = fmtKm(km) + ' · ~' + mins + ' min';
}

function initMap(){
  map = L.map('map', { zoomControl: true, scrollWheelZoom: false }).setView([guardPharmacy.lat, guardPharmacy.lng], 14);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB',
    subdomains: 'abcd', maxZoom: 19
  }).addTo(map);

  L.marker([guardPharmacy.lat, guardPharmacy.lng], {
    icon: L.divIcon({
      html: '<div style="background:linear-gradient(135deg,#0D9488,#0F766E);width:52px;height:52px;border-radius:50%;border:4px solid white;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 22px rgba(13,148,136,.5),0 0 0 6px rgba(13,148,136,.12)"><i class="fa-solid fa-shield-halved" style="color:white;font-size:20px"></i></div>',
      iconSize: [52, 52], className: 'pharmacy-marker'
    })
  }).addTo(map).bindPopup(
    `<div style="padding:14px;font-family:'Inter',sans-serif;min-width:220px">
      <div style="font-size:16px;font-weight:800;color:#0D9488;margin-bottom:6px;font-family:'Outfit',sans-serif">Pharmacie Al-Amal</div>
      <div style="font-size:12px;color:#64748B;margin-bottom:4px"><i class="fa-solid fa-shield-halved" style="color:#0D9488;margin-right:6px"></i>Garde 24h/24</div>
      <div style="font-size:12px;color:#64748B;margin-bottom:12px"><i class="fa-solid fa-phone" style="color:#0D9488;margin-right:6px"></i>+269 773 90 11</div>
      <div style="display:flex;gap:8px">
        <button onclick="window.openCallFromPopup()" style="flex:1;background:#10B981;color:#fff;border:none;padding:8px;border-radius:10px;cursor:pointer;font-size:12px;font-weight:700"><i class="fa-solid fa-phone"></i> Appeler</button>
        <button onclick="window.openGMapsFromPopup()" style="flex:1;background:#4285F4;color:#fff;border:none;padding:8px;border-radius:10px;cursor:pointer;font-size:12px;font-weight:700"><i class="fab fa-google"></i> Maps</button>
      </div>
    </div>`
  ).openPopup();
}
window.openCallFromPopup  = () => openCall();
window.openGMapsFromPopup = () => openGMaps();

function locUser(){
  showToast('Recherche de votre position…');
  if(!navigator.geolocation){ showToast('Géolocalisation non supportée'); return; }
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      userLat = pos.coords.latitude;
      userLng = pos.coords.longitude;
      drawRoutes(userLat, userLng);
      showToast('Position trouvée — itinéraire tracé');
    },
    (err) => {
      const msg = err.code === 1 ? 'Accès refusé' : err.code === 2 ? 'Position indisponible' : 'Délai expiré';
      showToast(msg);
    },
    { enableHighAccuracy: true, timeout: 12000 }
  );
}

// ============================================
// ACTIONS
// ============================================
function openCall(){
  const m = document.getElementById('callModal');
  m.classList.add('open');
  document.getElementById('callConfirm').onclick = () => {
    window.location.href = 'tel:' + guardPharmacy.phone;
    closeCall();
  };
}
function closeCall(){ document.getElementById('callModal').classList.remove('open'); }
document.getElementById('callModal').addEventListener('click', (e) => {
  if(e.target === document.getElementById('callModal')) closeCall();
});
document.addEventListener('keydown', (e) => {
  if(e.key === 'Escape' && document.getElementById('callModal').classList.contains('open')) closeCall();
});

function openWhatsApp(){
  window.open('https://wa.me/' + guardPharmacy.wa + '?text=' + encodeURIComponent('Bonjour, je vous contacte via Locapharma pour un besoin urgent.'), '_blank');
}
function openGMaps(){
  if(userLat && userLng){
    window.open('https://www.google.com/maps/dir/?api=1&origin=' + userLat + ',' + userLng + '&destination=' + guardPharmacy.lat + ',' + guardPharmacy.lng + '&travelmode=driving', '_blank');
  } else {
    window.open('https://www.google.com/maps/search/?api=1&query=' + guardPharmacy.lat + ',' + guardPharmacy.lng, '_blank');
  }
}
function goMap(){
  document.getElementById('mapSection').scrollIntoView({ behavior: 'smooth' });
  setTimeout(() => { if(!userLat) locUser(); }, 700);
}

// ============================================
// REVEAL ON SCROLL
// ============================================
const ro = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); ro.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => ro.observe(el));

// ============================================
// TOAST
// ============================================
let toastTm = null;
function showToast(message){
  const t = document.getElementById('toast');
  t.textContent = message;
  t.classList.add('show');
  if(toastTm) clearTimeout(toastTm);
  toastTm = setTimeout(() => t.classList.remove('show'), 2800);
}

// ============================================
// INIT
// ============================================
initMap();
setTimeout(locUser, 800);
</script>
</body>
</html>
