{# templates/pharmacie/garde.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Pharmacie de Garde — Locapharma</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
/* ============================================
   VARIABLES
   ============================================ */
:root {
  --primary:#0D9488; --primary-dark:#0F766E; --primary-darker:#115E59;
  --primary-light:#CCFBF1; --primary-bg:#F0FDFA;
  --secondary:#3B82F6;
  --accent:#F59E0B; --accent-dark:#D97706; --accent-light:#FEF3C7;
  --dark:#0F172A; --dark-soft:#1E293B;
  --gray-700:#334155; --gray-600:#475569; --gray-500:#64748B;
  --gray-400:#94A3B8; --gray-300:#CBD5E1; --gray-200:#E2E8F0; --gray-100:#F1F5F9; --gray-50:#F8FAFC;
  --white:#FFFFFF; --success:#10B981; --danger:#EF4444; --warning:#F59E0B;

  --shadow-sm: 0 1px 2px 0 rgb(15 23 42 / 0.05);
  --shadow:    0 1px 3px 0 rgb(15 23 42 / 0.08), 0 1px 2px -1px rgb(15 23 42 / 0.06);
  --shadow-md: 0 8px 18px -4px rgb(15 23 42 / 0.10), 0 4px 8px -4px rgb(15 23 42 / 0.06);
  --shadow-lg: 0 18px 32px -8px rgb(15 23 42 / 0.14), 0 8px 14px -8px rgb(15 23 42 / 0.08);
  --shadow-xl: 0 32px 56px -12px rgb(15 23 42 / 0.20), 0 14px 24px -12px rgb(15 23 42 / 0.10);
  --shadow-teal: 0 18px 40px -10px rgba(13,148,136,.55);

  --ease-out:cubic-bezier(.22,1,.36,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);

  --NAV:72px;
}

*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{
  font-family:'Inter',sans-serif;color:var(--dark);
  background:linear-gradient(180deg, var(--gray-50) 0%, #E8EEF5 100%);
  min-height:100vh;padding-top:var(--NAV);
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
h1,h2,h3,.brand-mark,.btn,.ph-name{font-family:'Outfit',sans-serif;letter-spacing:-.015em}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit}
:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(13,148,136,.36)}

/* ============================================
   PAGE WRAPPER
   ============================================ */
.container{
  max-width:1240px;margin:0 auto;
  padding:clamp(20px,3vw,40px) clamp(16px,3vw,28px) 80px;
}

/* ============================================
   HEADER BADGE — premium top eyebrow
   ============================================ */
.header-badge{text-align:center;margin-bottom:24px}
.live-badge{
  display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg, var(--primary-bg) 0%, white 100%);
  border:1px solid var(--primary-light);
  border-radius:100px;
  padding:9px 22px;
  font-size:13px;font-weight:800;
  color:var(--primary-dark);
  letter-spacing:.04em;
  box-shadow:0 4px 14px -4px rgba(13,148,136,.18);
  font-family:'Outfit',sans-serif;
}
.live-badge .live-dot{
  width:8px;height:8px;background:var(--success);border-radius:50%;position:relative;
}
.live-badge .live-dot::after{
  content:'';position:absolute;inset:0;border-radius:50%;background:var(--success);
  animation:ping 1.6s cubic-bezier(0,0,.2,1) infinite;
}
@keyframes ping{0%{transform:scale(1);opacity:.9}100%{transform:scale(3.2);opacity:0}}

/* ============================================
   HERO — Carousel + Floating Name Overlay
   ============================================ */
.hero-card{
  position:relative;
  background:var(--white);
  border-radius:28px;
  overflow:hidden;
  box-shadow:var(--shadow-xl);
  margin-bottom:24px;
}

.carousel{
  position:relative;
  height:clamp(360px, 56vh, 560px);
  overflow:hidden;
  background:var(--dark);
}
.car-slide{
  position:absolute;inset:0;
  background-size:cover;background-position:center;
  opacity:0;transition:opacity 1s var(--ease-out), transform 8s ease-out;
  transform:scale(1.04);
}
.car-slide.on{opacity:1;transform:scale(1.08)}

/* Strong gradient overlay so the floating name pops */
.car-overlay{
  position:absolute;inset:0;z-index:1;
  background:
    linear-gradient(180deg, rgba(15,23,42,.32) 0%, transparent 30%, transparent 50%, rgba(15,23,42,.55) 80%, rgba(15,23,42,.88) 100%);
}

/* Carousel arrows (glass) */
.car-btn{
  position:absolute;top:50%;transform:translateY(-50%);
  width:46px;height:46px;
  background:rgba(255,255,255,.18);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.28);
  border-radius:50%;color:white;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;cursor:pointer;z-index:3;
  transition:background .25s, transform .25s var(--ease-spring), border-color .25s;
}
.car-btn:hover{background:rgba(255,255,255,.3);border-color:rgba(255,255,255,.5);transform:translateY(-50%) scale(1.08)}
.cb-prev{left:18px}.cb-next{right:18px}

/* Carousel dots */
.car-dots{
  position:absolute;bottom:24px;right:24px;z-index:3;
  display:flex;gap:8px;
}
.car-dot{
  width:8px;height:8px;border-radius:50%;
  background:rgba(255,255,255,.45);
  border:none;cursor:pointer;padding:0;
  transition:width .35s var(--ease-out), background .25s;
}
.car-dot.on{background:white;width:26px;border-radius:4px}

/* Top-left guard badge */
.car-guard-badge{
  position:absolute;top:22px;left:22px;z-index:3;
  background:linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius:100px;
  padding:8px 16px;
  display:flex;align-items:center;gap:8px;
  color:white;font-size:12px;font-weight:800;font-family:'Outfit',sans-serif;
  letter-spacing:.03em;
  box-shadow:0 8px 20px -4px rgba(13,148,136,.5);
  border:1px solid rgba(255,255,255,.18);
}
.car-guard-badge .ld{
  width:7px;height:7px;background:var(--accent);border-radius:50%;
  box-shadow:0 0 0 3px rgba(245,158,11,.35);
}

/* Top-right small status pill */
.car-status-pill{
  position:absolute;top:22px;right:22px;z-index:3;
  background:rgba(255,255,255,.95);
  backdrop-filter:blur(10px);
  border-radius:100px;
  padding:7px 14px;
  display:inline-flex;align-items:center;gap:7px;
  font-size:11px;font-weight:800;color:var(--success);
  font-family:'Outfit',sans-serif;letter-spacing:.04em;
  box-shadow:0 4px 12px rgba(0,0,0,.15);
}
.car-status-pill::before{
  content:'';width:6px;height:6px;background:var(--success);border-radius:50%;
  box-shadow:0 0 0 3px rgba(16,185,129,.25);
}

/* === FLOATING TITLE OVERLAY === */
.hero-overlay{
  position:absolute;left:0;right:0;bottom:0;z-index:2;
  padding:clamp(22px,3vw,42px);
  color:white;
}
.ho-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
  color:rgba(255,255,255,.85);margin-bottom:10px;
  font-family:'Outfit',sans-serif;
}
.ho-eyebrow i{font-size:11px;color:var(--accent)}

.ho-name{
  font-family:'Outfit',sans-serif;
  font-size:clamp(30px, 4.5vw, 56px);
  font-weight:900;line-height:1.04;letter-spacing:-.025em;
  color:white;margin-bottom:14px;
  text-shadow:0 4px 24px rgba(0,0,0,.45);
  animation:slideUp .8s var(--ease-out) both;
}
@keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

.ho-meta{
  display:flex;gap:clamp(14px,2vw,28px);flex-wrap:wrap;align-items:center;
  font-size:14px;font-weight:500;color:rgba(255,255,255,.92);
  animation:slideUp .8s var(--ease-out) .15s both;
}
.ho-meta-item{
  display:inline-flex;align-items:center;gap:8px;
}
.ho-meta-item i{color:var(--accent);font-size:14px}
.ho-meta-item .v{font-weight:700;color:white}

/* ============================================
   CARD BODY — clean (no countdown)
   ============================================ */
.card-body{padding:clamp(22px,3vw,36px)}

/* Premium top row with rating + status */
.top-row{
  display:flex;justify-content:space-between;align-items:center;gap:18px;
  flex-wrap:wrap;
  padding-bottom:22px;
  margin-bottom:22px;
  border-bottom:1px solid var(--gray-200);
}
.rating-wrap{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.rating-stars{display:flex;align-items:center;gap:4px;color:var(--accent);font-size:14px}
.rating-num{font-family:'Outfit',sans-serif;font-size:18px;font-weight:800;color:var(--dark);margin-left:6px}
.rating-count{font-size:13px;color:var(--gray-500)}
.rating-sep{width:1px;height:18px;background:var(--gray-200)}
.rating-pill{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--primary-bg);color:var(--primary-dark);
  border:1px solid var(--primary-light);
  padding:4px 11px;border-radius:100px;
  font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
}

/* Dates card — premium, full-width since countdown removed */
.dates-strip{
  background:linear-gradient(135deg, var(--gray-50) 0%, white 100%);
  border:1px solid var(--gray-200);
  border-radius:20px;
  padding:22px clamp(20px,2.5vw,30px);
  margin-bottom:28px;
  display:grid;
  grid-template-columns:auto 1fr 1fr 1fr;
  gap:clamp(16px,3vw,32px);
  align-items:center;
  position:relative;
  overflow:hidden;
}
.dates-strip::before{
  content:'';position:absolute;top:0;left:0;bottom:0;width:4px;
  background:linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
}
.ds-icon{
  width:48px;height:48px;border-radius:14px;
  background:var(--primary-bg);color:var(--primary);
  display:flex;align-items:center;justify-content:center;
  font-size:20px;flex-shrink:0;
}
.ds-block .ds-label{
  font-size:10px;font-weight:800;color:var(--gray-500);
  text-transform:uppercase;letter-spacing:.1em;margin-bottom:4px;
}
.ds-block .ds-value{
  font-family:'Outfit',sans-serif;
  font-size:clamp(14px,1.4vw,17px);font-weight:800;color:var(--dark);
}
.ds-block .ds-value.grn{color:var(--primary)}
.ds-block.duration .ds-value{color:var(--accent-dark)}

/* Action buttons — bigger, more pro */
.actions{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:12px;
}
.abt{
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
  padding:18px 12px;border-radius:18px;border:none;cursor:pointer;
  font-family:'Outfit',sans-serif;font-size:13px;font-weight:800;letter-spacing:.01em;
  transition:transform .25s var(--ease-spring), box-shadow .25s, filter .25s;
  position:relative;overflow:hidden;
}
.abt::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(120deg, transparent 30%, rgba(255,255,255,.25) 50%, transparent 70%);
  transform:translateX(-100%);transition:transform .65s var(--ease-out);
}
.abt:hover::before{transform:translateX(100%)}
.abt:hover{transform:translateY(-3px)}
.abt i{font-size:22px}
.abt-call{background:linear-gradient(135deg, var(--success) 0%, #0E9F6E 100%);color:white;box-shadow:0 8px 22px -6px rgba(16,185,129,.55)}
.abt-call:hover{box-shadow:0 14px 32px -8px rgba(16,185,129,.7)}
.abt-wa{background:linear-gradient(135deg, #25D366 0%, #1EB857 100%);color:white;box-shadow:0 8px 22px -6px rgba(37,211,102,.5)}
.abt-wa:hover{box-shadow:0 14px 32px -8px rgba(37,211,102,.7)}
.abt-maps{background:linear-gradient(135deg, #4285F4 0%, #2563EB 100%);color:white;box-shadow:0 8px 22px -6px rgba(66,133,244,.55)}
.abt-maps:hover{box-shadow:0 14px 32px -8px rgba(66,133,244,.7)}
.abt-route{background:white;color:var(--dark);border:1.5px solid var(--gray-200);box-shadow:0 4px 10px -2px rgba(15,23,42,.06)}
.abt-route:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-bg)}

/* ============================================
   INFO GRID (Hours + Services)
   ============================================ */
.info-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:24px;margin-bottom:24px;
}
.info-card{
  background:var(--white);
  border-radius:24px;
  overflow:hidden;
  box-shadow:var(--shadow-md);
  border:1px solid var(--gray-200);
}
.info-header{
  display:flex;align-items:center;gap:14px;
  padding:18px 24px;
  background:linear-gradient(135deg, var(--gray-50) 0%, white 100%);
  border-bottom:1px solid var(--gray-200);
}
.info-icon{
  width:44px;height:44px;
  background:var(--primary-bg);color:var(--primary);
  border-radius:13px;
  display:flex;align-items:center;justify-content:center;
  font-size:18px;
}
.info-title-w h3{
  font-family:'Outfit',sans-serif;
  font-size:16px;font-weight:800;color:var(--dark);
  margin-bottom:2px;
}
.info-title-w p{font-size:12px;color:var(--gray-500);font-weight:500}

.info-body{padding:18px 24px 22px}

/* Hours */
.hour-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:10px 0;border-bottom:1px solid var(--gray-200);
  font-size:14px;
}
.hour-row:last-child{border-bottom:none}
.hour-row.today{
  background:var(--primary-bg);
  border-radius:12px;padding:12px 16px;margin:6px -16px;
  border:1px solid var(--primary-light);
  border-bottom:1px solid var(--primary-light);
}
.hour-day{color:var(--gray-600);font-weight:600}
.hour-day.today{color:var(--primary-dark);font-weight:800;display:inline-flex;align-items:center;gap:8px}
.hour-day.today::before{
  content:'';width:6px;height:6px;border-radius:50%;background:var(--success);
  box-shadow:0 0 0 3px rgba(16,185,129,.25);
}
.hour-time{font-weight:800;color:var(--dark)}
.hour-time.green{color:var(--primary)}
.hour-badge{
  background:var(--primary);color:white;border-radius:100px;
  padding:2px 9px;font-size:9px;font-weight:800;margin-left:8px;letter-spacing:.06em;
}

/* Services */
.service-row{
  display:flex;align-items:center;gap:14px;
  padding:14px 16px;
  background:var(--gray-50);
  border:1px solid transparent;
  border-radius:14px;
  margin-bottom:8px;
  transition:background .2s, transform .2s var(--ease-out), border-color .2s;
}
.service-row:hover{
  background:var(--primary-bg);
  transform:translateX(5px);
  border-color:var(--primary-light);
}
.service-row .si{
  width:36px;height:36px;
  background:white;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  color:var(--primary);font-size:14px;
  box-shadow:var(--shadow-sm);flex-shrink:0;
}
.service-row span{font-size:14px;font-weight:600;color:var(--gray-700)}

/* ============================================
   MAP CARD
   ============================================ */
.map-card{
  background:var(--white);
  border-radius:24px;overflow:hidden;
  box-shadow:var(--shadow-md);
  border:1px solid var(--gray-200);
}
.map-header{
  display:flex;justify-content:space-between;align-items:center;
  flex-wrap:wrap;gap:14px;
  padding:18px 24px;
  background:linear-gradient(135deg, var(--gray-50) 0%, white 100%);
  border-bottom:1px solid var(--gray-200);
}
.map-header-left{display:flex;align-items:center;gap:14px}
.map-icon{
  width:44px;height:44px;background:var(--primary-bg);color:var(--primary);
  border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:18px;
}
.map-title{font-family:'Outfit',sans-serif;font-size:16px;font-weight:800;color:var(--dark)}
.map-sub{font-size:12px;color:var(--gray-500);margin-top:3px}
.map-buttons{display:flex;gap:10px;flex-wrap:wrap}
.map-btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:10px 16px;border-radius:11px;
  font-size:13px;font-weight:800;
  border:1.5px solid var(--gray-200);
  background:white;color:var(--dark);
  cursor:pointer;font-family:'Outfit',sans-serif;
  transition:background .25s, color .25s, border-color .25s, transform .2s var(--ease-spring);
}
.map-btn:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-bg);transform:translateY(-1px)}
.map-btn-primary{background:var(--secondary);border-color:var(--secondary);color:white;box-shadow:0 4px 12px -2px rgba(59,130,246,.4)}
.map-btn-primary:hover{background:#2563EB;border-color:#2563EB;color:white}

#map{height:clamp(360px, 50vh, 460px); width:100%;position:relative}

.map-legend{
  position:absolute;bottom:16px;right:16px;
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(8px);
  border-radius:12px;padding:11px 14px;
  box-shadow:var(--shadow-md);
  z-index:1000;border:1px solid var(--gray-200);
}
.legend-item{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:700;margin-bottom:7px;color:var(--gray-700)}
.legend-item:last-child{margin-bottom:0}
.legend-color{width:26px;height:4px;border-radius:2px}

/* ============================================
   CALL MODAL
   ============================================ */
.call-modal{
  position:fixed;inset:0;
  background:rgba(15,23,42,.65);
  backdrop-filter:blur(10px);
  display:flex;align-items:center;justify-content:center;
  z-index:2000;
  opacity:0;visibility:hidden;
  transition:opacity .3s, visibility .3s;
  padding:20px;
}
.call-modal.open{opacity:1;visibility:visible}
.call-sheet{
  background:white;
  border-radius:28px;
  max-width:420px;width:100%;
  padding:36px 30px 32px;
  text-align:center;
  transform:scale(.94) translateY(8px);
  transition:transform .35s var(--ease-spring);
  box-shadow:var(--shadow-xl);
}
.call-modal.open .call-sheet{transform:scale(1) translateY(0)}
.call-avatar{
  width:86px;height:86px;
  background:linear-gradient(135deg, var(--success) 0%, #0E9F6E 100%);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 18px;
  font-size:36px;color:white;
  box-shadow:0 12px 28px -6px rgba(16,185,129,.5);
  position:relative;
}
.call-avatar::before{
  content:'';position:absolute;inset:-10px;border-radius:50%;
  border:2px solid rgba(16,185,129,.35);
  animation:ringPulse 1.8s ease-out infinite;
}
@keyframes ringPulse{0%{transform:scale(.9);opacity:1}100%{transform:scale(1.4);opacity:0}}
.call-label{font-size:11px;font-weight:800;color:var(--gray-500);text-transform:uppercase;letter-spacing:.14em;margin-bottom:6px}
.call-name{font-family:'Outfit',sans-serif;font-size:22px;font-weight:900;color:var(--dark);margin-bottom:8px;letter-spacing:-.02em}
.call-number{font-size:26px;font-weight:700;color:var(--primary-dark);margin-bottom:28px;letter-spacing:.04em}
.call-buttons{display:flex;gap:12px}
.call-cancel{
  flex:1;padding:14px;background:var(--gray-100);
  border:1.5px solid var(--gray-200);border-radius:14px;
  font-family:'Outfit',sans-serif;font-size:14px;font-weight:800;color:var(--gray-600);
  cursor:pointer;transition:background .2s;
}
.call-cancel:hover{background:var(--gray-200)}
.call-confirm{
  flex:2;padding:14px;background:var(--success);
  border:none;border-radius:14px;
  font-family:'Outfit',sans-serif;font-size:14px;font-weight:800;color:white;
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  transition:background .2s, transform .2s var(--ease-spring), box-shadow .25s;
  box-shadow:0 8px 20px -4px rgba(16,185,129,.5);
}
.call-confirm:hover{background:#0E9F6E;transform:translateY(-2px);box-shadow:0 12px 28px -6px rgba(16,185,129,.6)}

/* ============================================
   TOAST
   ============================================ */
.toast{
  position:fixed;bottom:24px;left:50%;
  transform:translateX(-50%) translateY(20px);
  background:var(--dark);color:white;
  padding:13px 24px;border-radius:100px;
  font-size:13px;font-weight:700;font-family:'Outfit',sans-serif;
  z-index:3000;opacity:0;
  transition:opacity .3s, transform .3s var(--ease-spring);
  pointer-events:none;white-space:nowrap;
  box-shadow:0 14px 32px rgba(15,23,42,.35);
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ============================================
   REVEAL ANIMATIONS
   ============================================ */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s var(--ease-out), transform .7s var(--ease-out)}
.reveal.in{opacity:1;transform:translateY(0)}

/* ============================================
   RESPONSIVE
   ============================================ */
@media(max-width:900px){
  .info-grid{grid-template-columns:1fr;gap:18px}
  .actions{grid-template-columns:repeat(2, 1fr)}
  .dates-strip{grid-template-columns:1fr 1fr;gap:14px;padding:18px 20px}
  .dates-strip .ds-icon{grid-column:1 / -1;width:100%;height:auto;background:transparent;color:var(--primary);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;justify-content:flex-start;border-radius:0}
  .dates-strip .ds-icon::before{content:'\f274';font-family:'Font Awesome 6 Free';font-weight:900;margin-right:8px;font-size:14px}
  .dates-strip .ds-icon i{display:none}
  .dates-strip .ds-icon::after{content:'Période de garde'}
  .map-header{flex-direction:column;align-items:stretch}
  .map-buttons{justify-content:stretch}
  .map-buttons .map-btn{flex:1;justify-content:center}
}
@media(max-width:640px){
  .container{padding:14px 12px 60px}
  .hero-card{border-radius:22px}
  .car-btn{width:38px;height:38px;font-size:12px}
  .cb-prev{left:10px}.cb-next{right:10px}
  .car-dots{bottom:16px;right:50%;transform:translateX(50%)}
  .car-guard-badge{top:14px;left:14px;padding:6px 12px;font-size:10px}
  .car-status-pill{top:14px;right:14px;padding:5px 10px;font-size:10px}
  .hero-overlay{padding:18px}
  .ho-name{margin-bottom:10px}
  .ho-meta{font-size:12.5px;gap:12px}
  .card-body{padding:18px}
  .top-row{flex-direction:column;align-items:flex-start;gap:10px}
  .dates-strip{padding:16px}
  .dates-strip .ds-block .ds-value{font-size:14px}
  .actions{gap:10px}
  .abt{padding:14px 8px;font-size:11.5px}
  .abt i{font-size:18px}
  .info-card{border-radius:20px}
  .info-header{padding:14px 18px}
  .info-body{padding:16px 18px 18px}
  .service-row{padding:11px 12px;gap:10px}
  .service-row .si{width:32px;height:32px}
  #map{height:340px}
  .map-legend{bottom:10px;right:10px;padding:8px 11px}
  .legend-item{font-size:10px}
}

@media(prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
</style>
