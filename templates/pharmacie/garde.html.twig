      <div class="info-body">
        <div class="service-row"><span class="si"><i class="fa-solid fa-kit-medical"></i></span><span>Urgences pharmaceutiques 24/7</span></div>
        <div class="service-row"><span class="si"><i class="fa-solid fa-baby"></i></span><span>Pédiatrie d'urgence</span></div>
        <div class="service-row"><span class="si"><i class="fa-solid fa-syringe"></i></span><span>Vaccinations sur place</span></div>
        <div class="service-row"><span class="si"><i class="fa-solid fa-truck-fast"></i></span><span>Livraison express (Moroni)</span></div>
        <div class="service-row"><span class="si"><i class="fa-solid fa-pills"></i></span><span>Médicaments sur ordonnance</span></div>
