{# templates/security/login.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Connexion — Locapharma</title>
<meta name="description" content="Connectez-vous à votre espace Locapharma pour gérer vos commandes et accéder aux pharmacies des Comores.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
:root {
  --G: #0E7C66; --GD: #0a5e4d; --GL: #e1f5ee; --GXL: #f0faf7;
  --B: #0B2545; --BD: #061632; --BM: #1a3a6e; --BL: #eef2f8;
  --GOLD: #F4C430; --GOLD-D: #d9a90f;
  --T: #1D2939; --MUT: #667085; --LT: #F2F4F7; --BDR: #E4E7EC;
  --W: #fff; --ERR: #F04438; --OK: #12B76A;
  --shadow: 0 2px 16px rgba(11,37,69,.07);
  --shadow-md: 0 8px 32px rgba(11,37,69,.13);
  --shadow-lg: 0 24px 64px rgba(11,37,69,.2);
  --shadow-glow: 0 18px 44px -12px rgba(14,124,102,.55);
  --ease-out: cubic-bezier(.22, 1, .36, 1);
  --ease-spring: cubic-bezier(.34, 1.56, .64, 1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  font-family:'Manrope',sans-serif;color:var(--T);background:var(--LT);
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(14,124,102,.4),0 0 0 5px rgba(14,124,102,.15);border-radius:10px}

.brand-mark{font-family:'Plus Jakarta Sans',sans-serif;font-weight:900;font-size:24px;line-height:1;letter-spacing:-.5px;display:inline-flex;align-items:center;gap:0}
.brand-mark .loca{color:var(--B)}
.brand-mark .pharma{color:var(--G)}

/* ============================================
   PAGE WRAPPER
   ============================================ */
.auth{
  min-height:100svh;
  display:grid;grid-template-columns:1.05fr 1fr;
  background:var(--LT);
}

/* ============================================
   LEFT — visual / branding side
   ============================================ */
.auth-visual{
  position:relative;overflow:hidden;
  background:#0B2545;
  color:white;
  padding:clamp(28px,4vw,56px);
  display:flex;flex-direction:column;
  isolation:isolate;
}
.auth-visual-bg{
  position:absolute;inset:0;z-index:0;
  background:url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=1800&q=85') center/cover no-repeat;
  filter:blur(1px) brightness(.32) saturate(1.1);
  transform:scale(1.06);
  animation:bgPan 28s ease-in-out infinite alternate;
}
@keyframes bgPan{
  from{transform:scale(1.06) translate3d(-1%,0,0)}
  to  {transform:scale(1.10) translate3d(1.5%,-1%,0)}
}
.auth-visual-ov{
  position:absolute;inset:0;z-index:0;
  background:
    radial-gradient(70% 60% at 100% 0%, rgba(14,124,102,.45) 0%, transparent 60%),
    radial-gradient(70% 60% at 0% 100%, rgba(244,196,48,.18) 0%, transparent 60%),
    linear-gradient(145deg, rgba(11,37,69,.88) 0%, rgba(11,37,69,.78) 55%, rgba(6,22,50,.94) 100%);
}
.auth-visual-mesh{
  position:absolute;inset:-10%;z-index:0;
  background:
    radial-gradient(38% 35% at 22% 28%, rgba(14,124,102,.55) 0%, transparent 60%),
    radial-gradient(30% 30% at 80% 18%, rgba(244,196,48,.28) 0%, transparent 60%),
    radial-gradient(45% 40% at 70% 85%, rgba(26,58,110,.55) 0%, transparent 60%);
  filter:blur(40px);
  animation:meshFloat 18s ease-in-out infinite alternate;
  mix-blend-mode:screen;opacity:.85;
}
@keyframes meshFloat{
  0%{transform:translate3d(0,0,0) scale(1)}
  50%{transform:translate3d(-2%,1%,0) scale(1.05)}
  100%{transform:translate3d(2%,-1%,0) scale(1.02)}
}
.auth-visual-dots{
  position:absolute;inset:0;z-index:0;opacity:.5;
  background-image:radial-gradient(circle,rgba(255,255,255,.08) 1px,transparent 1px);
  background-size:30px 30px;
  mask-image:radial-gradient(ellipse at center, black 30%, transparent 80%);
  -webkit-mask-image:radial-gradient(ellipse at center, black 30%, transparent 80%);
}
.auth-visual-cross{
  position:absolute;z-index:0;opacity:.06;color:white;pointer-events:none;
  animation:crossSpin 80s linear infinite;
}
.cross-tl{width:280px;height:280px;top:6%;right:8%}
.cross-bl{width:180px;height:180px;bottom:14%;left:4%;animation-direction:reverse;animation-duration:110s}
@keyframes crossSpin{from{transform:rotate(0)}to{transform:rotate(360deg)}}

/* Inner content */
.auth-visual-inner{
  position:relative;z-index:1;display:flex;flex-direction:column;height:100%;
  justify-content:space-between;gap:32px;
}
.auth-brand-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.auth-brand-row .brand-mark .loca{color:white}
.auth-brand-row .brand-mark .pharma{color:var(--GOLD)}
.auth-home-link{
  display:inline-flex;align-items:center;gap:7px;
  font-size:13px;font-weight:700;color:rgba(255,255,255,.78);
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);
  padding:7px 14px;border-radius:100px;
  transition:background .2s,color .2s,transform .2s var(--ease-spring);
  font-family:'Plus Jakarta Sans',sans-serif;
}
.auth-home-link:hover{background:rgba(255,255,255,.13);color:white;transform:translateX(-2px)}
.auth-home-link i{font-size:11px}

.auth-pitch{max-width:480px;animation:fadeUp .8s var(--ease-out) .1s both}
.auth-pitch-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.1);backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.18);border-radius:100px;
  padding:6px 14px;font-size:11px;font-weight:800;letter-spacing:.07em;
  text-transform:uppercase;color:rgba(255,255,255,.92);margin-bottom:20px;
}
.live-dot{width:7px;height:7px;background:var(--GOLD);border-radius:50%;position:relative}
.live-dot::after{content:'';position:absolute;inset:0;border-radius:50%;background:var(--GOLD);animation:pingRing 1.8s cubic-bezier(0,0,.2,1) infinite}
@keyframes pingRing{0%{transform:scale(1);opacity:.9}100%{transform:scale(3.2);opacity:0}}

.auth-h1{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:clamp(28px,3.4vw,42px);font-weight:900;line-height:1.08;
  letter-spacing:-.02em;margin-bottom:14px;color:white;
}
.auth-h1 .gold{
  background:linear-gradient(120deg,#FCD34D,var(--GOLD),#FBBF24);
  background-size:200% 100%;
  -webkit-background-clip:text;background-clip:text;color:transparent;
  animation:goldShimmer 5s linear infinite;
}
@keyframes goldShimmer{0%{background-position:0% 0%}100%{background-position:200% 0%}}
.auth-h1-sub{
  font-size:15px;color:rgba(255,255,255,.78);line-height:1.65;
  font-weight:500;margin-bottom:28px;
}
.auth-features{display:flex;flex-direction:column;gap:14px}
.auth-feat{
  display:flex;align-items:center;gap:12px;
  font-size:14px;color:rgba(255,255,255,.88);
  opacity:0;transform:translateX(-12px);
  animation:fadeInX .6s var(--ease-out) forwards;
}
.auth-feat:nth-child(1){animation-delay:.3s}
.auth-feat:nth-child(2){animation-delay:.4s}
.auth-feat:nth-child(3){animation-delay:.5s}
@keyframes fadeInX{to{opacity:1;transform:translateX(0)}}
.auth-feat i{
  width:32px;height:32px;flex-shrink:0;
  border-radius:9px;background:rgba(244,196,48,.15);
  border:1px solid rgba(244,196,48,.28);color:var(--GOLD);
  display:flex;align-items:center;justify-content:center;font-size:13px;
}

.auth-kpis{
  display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
  padding-top:24px;border-top:1px solid rgba(255,255,255,.12);
  animation:fadeUp .8s var(--ease-out) .6s both;
}
.auth-kpi-n{font-size:24px;font-weight:900;color:var(--GOLD);font-family:'Plus Jakarta Sans',sans-serif;line-height:1}
.auth-kpi-l{font-size:10px;color:rgba(255,255,255,.6);font-weight:600;margin-top:4px;letter-spacing:.05em;text-transform:uppercase}

@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

/* ============================================
   RIGHT — form side
   ============================================ */
.auth-form-side{
  position:relative;
  padding:clamp(28px,4vw,56px);
  display:flex;align-items:center;justify-content:center;
  background:var(--LT);
  overflow-y:auto;
}
.auth-form-side::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(60% 50% at 100% 0%, rgba(14,124,102,.045) 0%, transparent 60%),
    radial-gradient(60% 50% at 0% 100%, rgba(244,196,48,.045) 0%, transparent 60%);
  pointer-events:none;
}
.auth-form-wrap{
  width:100%;max-width:440px;position:relative;
  animation:fadeUp .7s var(--ease-out) .2s both;
}
.mobile-brand{display:none}

.auth-tag{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--GL);color:var(--G);border-radius:100px;padding:6px 14px;
  font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
  margin-bottom:14px;border:1px solid rgba(14,124,102,.15);
}
.auth-tag::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--G);box-shadow:0 0 0 3px rgba(14,124,102,.18)}

.auth-title{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:clamp(26px,2.6vw,32px);font-weight:900;letter-spacing:-.02em;
  color:var(--B);margin-bottom:8px;line-height:1.15;
}
.auth-subtitle{
  font-size:14px;color:var(--MUT);line-height:1.6;margin-bottom:28px;
}
.auth-subtitle a{color:var(--G);font-weight:700;text-decoration:none;position:relative}
.auth-subtitle a::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:1px;background:var(--G);transform:scaleX(0);transform-origin:right;transition:transform .25s var(--ease-out)}
.auth-subtitle a:hover::after{transform:scaleX(1);transform-origin:left}

/* Alerts */
.auth-alert{
  display:flex;align-items:center;gap:10px;
  padding:12px 14px;border-radius:12px;
  font-size:13px;font-weight:600;margin-bottom:18px;
  animation:fadeUp .4s var(--ease-out);
}
.auth-alert.err{background:rgba(240,68,56,.08);color:#a8201a;border:1px solid rgba(240,68,56,.22)}
.auth-alert.ok {background:rgba(18,183,106,.08);color:#0a7141;border:1px solid rgba(18,183,106,.22)}
.auth-alert i{font-size:15px;flex-shrink:0}

/* Floating label fields */
.field{position:relative;margin-bottom:14px}
.field-input{
  width:100%;padding:18px 16px 8px;
  font-size:15px;font-family:'Manrope',sans-serif;color:var(--T);
  background:white;border:1.5px solid var(--BDR);border-radius:12px;
  outline:none;transition:border-color .2s,box-shadow .2s,background .2s;
  font-weight:500;
}
.field-input:focus,
.field-input:not(:placeholder-shown){
  border-color:var(--G);
  background:white;
  box-shadow:0 0 0 4px rgba(14,124,102,.1);
}
.field-input:focus + .field-label,
.field-input:not(:placeholder-shown) + .field-label{
  top:6px;font-size:10.5px;color:var(--G);font-weight:800;letter-spacing:.04em;text-transform:uppercase;
}
.field-label{
  position:absolute;left:16px;top:50%;transform:translateY(-50%);
  font-size:14px;color:var(--MUT);font-weight:500;pointer-events:none;
  transition:top .2s var(--ease-out),font-size .2s,color .2s,transform .2s,letter-spacing .2s;
  background:transparent;font-family:'Manrope',sans-serif;
}
.field-input.has-icon{padding-left:46px}
.field-icon{
  position:absolute;left:16px;top:50%;transform:translateY(-50%);
  color:var(--MUT);font-size:15px;pointer-events:none;
  transition:color .2s;
}
.field-input.has-icon ~ .field-label{left:46px}
.field-input:focus ~ .field-icon{color:var(--G)}
.field-input.has-icon:focus + .field-label,
.field-input.has-icon:not(:placeholder-shown) + .field-label{left:46px}

/* Show / hide password */
.field-toggle{
  position:absolute;right:8px;top:50%;transform:translateY(-50%);
  width:36px;height:36px;border-radius:8px;border:none;background:transparent;
  color:var(--MUT);cursor:pointer;font-size:14px;
  display:flex;align-items:center;justify-content:center;
  transition:color .2s,background .2s;
}
.field-toggle:hover{color:var(--G);background:var(--LT)}

/* Row : remember / forgot */
.auth-row{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  flex-wrap:wrap;margin:8px 0 22px;
}
.checkbox{
  display:inline-flex;align-items:center;gap:9px;cursor:pointer;
  font-size:13px;color:var(--T);font-weight:600;user-select:none;
}
.checkbox input{position:absolute;opacity:0;width:0;height:0}
.checkbox .box{
  width:18px;height:18px;border-radius:6px;border:1.5px solid var(--BDR);
  background:white;display:inline-flex;align-items:center;justify-content:center;
  transition:background .2s,border-color .2s,transform .15s var(--ease-spring);
  flex-shrink:0;
}
.checkbox .box i{font-size:10px;color:white;opacity:0;transform:scale(.5);transition:opacity .15s,transform .2s var(--ease-spring)}
.checkbox input:checked ~ .box{background:var(--G);border-color:var(--G)}
.checkbox input:checked ~ .box i{opacity:1;transform:scale(1)}
.checkbox input:focus-visible ~ .box{box-shadow:0 0 0 3px rgba(14,124,102,.25)}
.forgot{font-size:13px;color:var(--G);font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;position:relative}
.forgot::after{content:'';position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--G);transform:scaleX(0);transform-origin:right;transition:transform .25s var(--ease-out)}
.forgot:hover::after{transform:scaleX(1);transform-origin:left}

/* Submit button */
.auth-submit{
  width:100%;padding:15px;border:none;border-radius:13px;cursor:pointer;
  background:linear-gradient(135deg,var(--G) 0%,var(--GD) 100%);
  color:white;font-size:15px;font-weight:900;
  font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:.01em;
  display:flex;align-items:center;justify-content:center;gap:10px;
  transition:transform .25s var(--ease-spring),box-shadow .25s;
  box-shadow:0 4px 18px rgba(14,124,102,.32);
  position:relative;overflow:hidden;isolation:isolate;
}
.auth-submit::before{
  content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.28) 50%,transparent 70%);
  transform:translateX(-100%);transition:transform .7s var(--ease-out);
}
.auth-submit:hover::before{transform:translateX(100%)}
.auth-submit:hover{transform:translateY(-2px);box-shadow:var(--shadow-glow)}
.auth-submit:active{transform:translateY(0)}
.auth-submit i.fa-arrow-right{transition:transform .25s var(--ease-out)}
.auth-submit:hover i.fa-arrow-right{transform:translateX(4px)}
.auth-submit.loading{pointer-events:none;opacity:.85}
.auth-submit.loading .auth-submit-txt,
.auth-submit.loading i.fa-arrow-right{visibility:hidden}
.auth-submit .spinner{
  position:absolute;width:20px;height:20px;border-radius:50%;
  border:2.5px solid rgba(255,255,255,.3);border-top-color:white;
  opacity:0;animation:spin 0.9s linear infinite;
}
.auth-submit.loading .spinner{opacity:1}
@keyframes spin{to{transform:rotate(360deg)}}

/* Divider */
.divider{
  display:flex;align-items:center;gap:14px;margin:24px 0;
  font-size:11px;color:var(--MUT);font-weight:800;letter-spacing:.1em;text-transform:uppercase;
}
.divider::before,
.divider::after{content:'';flex:1;height:1px;background:var(--BDR)}

/* Social buttons */
.social-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:24px}
.social-btn{
  display:flex;align-items:center;justify-content:center;gap:9px;
  padding:12px;border-radius:12px;border:1.5px solid var(--BDR);background:white;
  color:var(--T);font-size:13px;font-weight:700;cursor:pointer;
  font-family:'Plus Jakarta Sans',sans-serif;
  transition:background .2s,border-color .2s,transform .25s var(--ease-spring),box-shadow .2s;
}
.social-btn:hover{background:var(--LT);border-color:#cdd5e1;transform:translateY(-1px);box-shadow:var(--shadow)}
.social-btn .ico{width:18px;height:18px;display:inline-block}
.social-btn.google .ico{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='%234285F4' d='M21.35 11.1H12v3.2h5.35c-.23 1.5-1.7 4.4-5.35 4.4-3.22 0-5.85-2.66-5.85-5.95S8.78 6.8 12 6.8c1.83 0 3.06.78 3.76 1.45l2.56-2.46C16.78 4.3 14.62 3.4 12 3.4 7.03 3.4 3 7.43 3 12.4S7.03 21.4 12 21.4c6.93 0 9.35-4.85 9.35-7.35 0-.5-.05-.93-.13-1.35z'/></svg>") center/contain no-repeat}
.social-btn.facebook .ico{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='%231877F2' d='M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07C2 17.09 5.66 21.25 10.44 22v-7.02H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.47H15.2c-1.24 0-1.63.77-1.63 1.56v1.88h2.77l-.44 2.91h-2.33V22C18.34 21.25 22 17.09 22 12.07z'/></svg>") center/contain no-repeat}

/* Signup row */
.auth-signup{
  text-align:center;font-size:14px;color:var(--MUT);
}
.auth-signup a{color:var(--G);font-weight:800;font-family:'Plus Jakarta Sans',sans-serif;position:relative}
.auth-signup a::after{content:'';position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--G);transform:scaleX(0);transform-origin:right;transition:transform .25s var(--ease-out)}
.auth-signup a:hover::after{transform:scaleX(1);transform-origin:left}

.auth-footer{
  margin-top:28px;padding-top:20px;border-top:1px solid var(--BDR);
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;
  font-size:11px;color:var(--MUT);
}
.auth-footer a{transition:color .2s}
.auth-footer a:hover{color:var(--G)}

/* ============================================
   RESPONSIVE
   ============================================ */
@media(max-width:1024px){
  .auth{grid-template-columns:1fr}
  .auth-visual{display:none}
  .mobile-brand{
    display:flex;align-items:center;justify-content:space-between;
    margin-bottom:24px;animation:fadeUp .6s var(--ease-out) both;
  }
  .mobile-brand .brand-mark{font-size:22px}
  .auth-form-side{align-items:flex-start;padding-top:max(28px,env(safe-area-inset-top))}
  .auth-form-wrap{margin-top:8px}
}
@media(max-width:640px){
  .auth-form-side{padding:22px 18px 32px}
  .auth-title{font-size:24px}
  .auth-subtitle{font-size:13px;margin-bottom:22px}
  .field-input{padding:17px 14px 7px;font-size:14px}
  .field-input.has-icon{padding-left:42px}
  .field-icon{left:14px;font-size:14px}
  .field-input.has-icon ~ .field-label,
  .field-input.has-icon:focus + .field-label,
  .field-input.has-icon:not(:placeholder-shown) + .field-label{left:42px}
  .field-label{left:14px;font-size:13px}
  .auth-submit{padding:14px;font-size:14px}
  .social-row{grid-template-columns:1fr}
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
  .auth-pitch,.auth-features,.auth-feat,.auth-kpis,.auth-form-wrap{opacity:1!important;transform:none!important}
}
</style>
</head>

<body>

<div class="auth">

  {# ============================================
     LEFT — Visual / branding
     ============================================ #}
  <aside class="auth-visual" aria-hidden="true">
    <div class="auth-visual-bg"></div>
    <div class="auth-visual-ov"></div>
    <div class="auth-visual-mesh"></div>
    <div class="auth-visual-dots"></div>

    <svg class="auth-visual-cross cross-tl" viewBox="0 0 100 100" fill="currentColor"><path d="M40 10h20v30h30v20H60v30H40V60H10V40h30z"/></svg>
    <svg class="auth-visual-cross cross-bl" viewBox="0 0 100 100" fill="currentColor"><path d="M40 10h20v30h30v20H60v30H40V60H10V40h30z"/></svg>

    <div class="auth-visual-inner">
      <div class="auth-brand-row">
        <div class="brand-mark"><span class="loca">Loca</span><span class="pharma">pharma</span></div>
        <a href="/" class="auth-home-link"><i class="fa-solid fa-arrow-left"></i>Retour à l'accueil</a>
      </div>

      <div class="auth-pitch">
        <div class="auth-pitch-eyebrow"><span class="live-dot"></span>Plateforme officielle · Comores</div>
        <h1 class="auth-h1">
          Bienvenue sur<br>la <span class="gold">santé numérique</span><br>des Comores.
        </h1>
        <p class="auth-h1-sub">
          Connectez-vous pour gérer vos commandes, retrouver vos pharmacies favorites et accéder aux services d'urgence 24/7 — sur les 3 îles de l'archipel.
        </p>

        <div class="auth-features">
          <div class="auth-feat"><i class="fa-solid fa-check"></i>Accès instantané à 30+ pharmacies partenaires</div>
          <div class="auth-feat"><i class="fa-solid fa-check"></i>Pharmacie de garde 24h/24, 7j/7</div>
          <div class="auth-feat"><i class="fa-solid fa-check"></i>Commande en ligne avec ou sans ordonnance</div>
        </div>
      </div>

      <div class="auth-kpis">
        <div><div class="auth-kpi-n">30+</div><div class="auth-kpi-l">Pharmacies</div></div>
        <div><div class="auth-kpi-n">24/7</div><div class="auth-kpi-l">Disponibilité</div></div>
        <div><div class="auth-kpi-n">3 Îles</div><div class="auth-kpi-l">Couverture</div></div>
      </div>
    </div>
  </aside>

  {# ============================================
     RIGHT — Form
     ============================================ #}
  <main class="auth-form-side">
    <div class="auth-form-wrap">

      {# Visible only on mobile (when the visual panel is hidden) #}
      <div class="mobile-brand">
        <div class="brand-mark"><span class="loca">Loca</span><span class="pharma">pharma</span></div>
        <a href="/" class="auth-home-link" style="background:var(--LT);border-color:var(--BDR);color:var(--MUT)">
          <i class="fa-solid fa-arrow-left"></i>Accueil
        </a>
      </div>

      <span class="auth-tag">Espace Membre</span>
      <h2 class="auth-title">Bon retour parmi nous</h2>
      <p class="auth-subtitle">
        Pas encore de compte ?
        {# TODO: remplacer par path('app_register') quand la route existe #}
        <a href="#">Créer un compte gratuit</a>
      </p>

      {% if error is defined and error %}
        <div class="auth-alert err" role="alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
      {% endif %}

      {% if app is defined %}
        {% for message in app.flashes('success') %}
          <div class="auth-alert ok"><i class="fa-solid fa-circle-check"></i><span>{{ message }}</span></div>
        {% endfor %}
      {% endif %}

      <form method="post" action="{{ path('app_login') }}" id="loginForm" novalidate>

        <div class="field">
          <i class="fa-solid fa-envelope field-icon"></i>
          <input
            type="email" id="inputEmail" name="_username"
            class="field-input has-icon"
            placeholder=" " autocomplete="email" inputmode="email" autofocus required
            value="{{ last_username|default('') }}"
          >
          <label for="inputEmail" class="field-label">Adresse email</label>
        </div>

        <div class="field">
          <i class="fa-solid fa-lock field-icon"></i>
          <input
            type="password" id="inputPassword" name="_password"
            class="field-input has-icon"
            placeholder=" " autocomplete="current-password" required minlength="6"
          >
          <label for="inputPassword" class="field-label">Mot de passe</label>
          <button type="button" class="field-toggle" id="pwToggle" aria-label="Afficher / masquer le mot de passe">
            <i class="fa-regular fa-eye"></i>
          </button>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="auth-row">
          <label class="checkbox">
            <input type="checkbox" name="_remember_me" checked>
            <span class="box"><i class="fa-solid fa-check"></i></span>
            <span>Rester connecté</span>
          </label>
          {# TODO: remplacer par path('app_forgot_password_request') #}
          <a href="#" class="forgot">Mot de passe oublié ?</a>
        </div>

        <button type="submit" class="auth-submit" id="submitBtn">
          <span class="spinner" aria-hidden="true"></span>
          <span class="auth-submit-txt">Se connecter</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>

        <div class="divider"><span>ou continuer avec</span></div>

        <div class="social-row">
          <button type="button" class="social-btn google" onclick="showToast('Connexion Google bientôt disponible')">
            <span class="ico"></span>Google
          </button>
          <button type="button" class="social-btn facebook" onclick="showToast('Connexion Facebook bientôt disponible')">
            <span class="ico"></span>Facebook
          </button>
        </div>

        <p class="auth-signup">
          {# TODO: remplacer par path('app_register_pharmacien') #}
          Vous êtes pharmacien ? <a href="#">Inscription pharmacie</a>
        </p>
      </form>

      <div class="auth-footer">
        <span>© 2026 Locapharma — Tous droits réservés</span>
        <span><a href="#">Aide</a> · <a href="#">CGU</a> · <a href="#">Confidentialité</a></span>
      </div>

    </div>
  </main>

</div>

<!-- Toast -->
<div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--B);color:white;padding:12px 22px;border-radius:100px;font-size:13px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;box-shadow:var(--shadow-lg);opacity:0;transition:opacity .3s,transform .3s var(--ease-spring);pointer-events:none;z-index:1000"></div>

<script>
// Password show/hide
(function(){
  const btn = document.getElementById('pwToggle');
  const inp = document.getElementById('inputPassword');
  if(!btn || !inp) return;
  btn.addEventListener('click', () => {
    const isPw = inp.type === 'password';
    inp.type = isPw ? 'text' : 'password';
    btn.querySelector('i').className = isPw ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
  });
})();

// Form submit -> loading state (visual only, browser submits as normal)
(function(){
  const f = document.getElementById('loginForm');
  const b = document.getElementById('submitBtn');
  if(!f || !b) return;
  f.addEventListener('submit', () => {
    if(f.checkValidity()) b.classList.add('loading');
  });
})();

// Toast helper
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._tm);
  t._tm = setTimeout(() => {
    t.style.opacity = '0';
    t.style.transform = 'translateX(-50%) translateY(20px)';
  }, 2600);
}
</script>

</body>
</html>
