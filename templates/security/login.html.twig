<!-- TOAST -->
<div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:#0B2545;color:white;padding:13px 22px;border-radius:100px;font-size:13px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;box-shadow:0 12px 32px rgba(11,37,69,.35);opacity:0;transition:opacity .3s, transform .3s cubic-bezier(.22,1,.36,1);pointer-events:none;z-index:1000"></div>

<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ============================================
// 1) Time-aware greeting (no live ticking)
// ============================================
(function(){
  const el = document.getElementById('greeting');
  if(!el) return;
  const h = new Date().getHours();
  if(h < 5)        el.textContent = 'Bonne nuit';
  else if(h < 12)  el.textContent = 'Bonjour';
  else if(h < 18)  el.textContent = 'Bon après-midi';
  else             el.textContent = 'Bonsoir';
})();

// ============================================
// 2) Floating pharmacy icons (slow, subtle)
// ============================================
(function(){
  if(reduceMotion) return;
  const root = document.getElementById('floatIcons');
  if(!root) return;
  // Icon set (matches the SVG <symbol> ids above)
  const ICONS = ['ic-pill','ic-cap','ic-cross','ic-heart','ic-steth','ic-mortar','ic-plus'];
  // Tint variations — kept very low opacity for a calm feel
  const TINTS = [
    'rgba(14,124,102,.085)',   // teal
    'rgba(14,124,102,.07)',
    'rgba(244,196,48,.07)',    // soft gold
    'rgba(11,37,69,.05)',      // navy
    'rgba(14,124,102,.06)',
  ];
  const N = window.innerWidth < 640 ? 6 : 12;
  for(let i = 0; i < N; i++){
    const wrap = document.createElement('div');
    wrap.className = 'fi';
    const size  = 28 + Math.random() * 36;          // 28-64px
    const left  = Math.random() * 100;              // 0-100% x
    const dur   = 55 + Math.random() * 50;          // 55-105s (very slow)
    const delay = -Math.random() * dur;             // staggered start
    const tint  = TINTS[Math.floor(Math.random() * TINTS.length)];
    const icon  = ICONS[Math.floor(Math.random() * ICONS.length)];
    wrap.style.cssText =
      'left:' + left + '%; ' +
      'width:' + size + 'px; height:' + size + 'px; ' +
      'animation-duration:' + dur + 's; ' +
      'animation-delay:' + delay + 's; ' +
      'color:' + tint + ';';
    wrap.innerHTML = '<svg><use href="#' + icon + '"/></svg>';
    root.appendChild(wrap);
  }
})();

// ============================================
// 3) Password show/hide
// ============================================
(function(){
  const btn = document.getElementById('pwToggle');
  const inp = document.getElementById('inputPassword');
  if(!btn || !inp) return;
  btn.addEventListener('click', () => {
    const isPw = inp.type === 'password';
    inp.type = isPw ? 'text' : 'password';
    btn.querySelector('i').className = isPw ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
  });
})();

// ============================================
// 4) Form submit -> loading state
// ============================================
(function(){
  const f = document.getElementById('loginForm');
  const b = document.getElementById('submitBtn');
  if(!f || !b) return;
  f.addEventListener('submit', () => {
    if(f.checkValidity()) b.classList.add('loading');
  });
})();

// ============================================
// 5) Toast helper
// ============================================
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._tm);
  t._tm = setTimeout(() => {
    t.style.opacity = '0';
    t.style.transform = 'translateX(-50%) translateY(20px)';
  }, 2600);
}
</script>

</body>
</html>
