{# templates/security/login.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Connexion — Locapharma</title>
<meta name="description" content="Connectez-vous à votre espace Locapharma.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
:root {
  --G:#0E7C66; --GD:#0a5e4d; --GL:#34d399; --GXL:#6ee7b7;
  --B:#0B2545; --BD:#061632; --BM:#1a3a6e;
  --GOLD:#F4C430; --GOLD-D:#d9a90f;
  --T:#1D2939; --MUT:#667085; --LT:#F2F4F7; --BDR:#E4E7EC;
  --W:#fff; --ERR:#F04438; --OK:#12B76A;

  /* Page bg : pas trop blanc, légèrement grisé/bleuté */
  --page:#eef2f7;
  --page-2:#e6ecf3;
  /* Card bg : blanc mais doux, pas pur 100% blanc */
  --card:#fcfcfd;

  --ease-out:cubic-bezier(.22, 1, .36, 1);
  --ease-spring:cubic-bezier(.34, 1.56, .64, 1);
  --ease-soft:cubic-bezier(.4, 0, .2, 1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  font-family:'Manrope',sans-serif;color:var(--T);
  background:var(--page);
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  overflow-x:hidden;
  min-height:100svh;
  position:relative;
}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button{font-family:inherit}
:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(14,124,102,.32)}

/* ============================================
   BACKGROUND — light, static, soft
   ============================================ */
.bg{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(70% 60% at 50% -10%, rgba(14,124,102,.07) 0%, transparent 60%),
    radial-gradient(50% 50% at 0% 100%, rgba(244,196,48,.05) 0%, transparent 60%),
    radial-gradient(60% 60% at 100% 100%, rgba(11,37,69,.05) 0%, transparent 60%),
    linear-gradient(180deg, var(--page) 0%, var(--page-2) 100%);
}
.bg-grid{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:
    linear-gradient(rgba(11,37,69,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(11,37,69,.04) 1px, transparent 1px);
  background-size:54px 54px;
  mask-image:radial-gradient(ellipse 75% 65% at 50% 50%, black 30%, transparent 80%);
  -webkit-mask-image:radial-gradient(ellipse 75% 65% at 50% 50%, black 30%, transparent 80%);
}

/* ============================================
   FLOATING PILLS — VISIBLE, SLOW
   ============================================ */
.pills{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.pill{
  position:absolute;
  width:42px;height:18px;border-radius:18px;
  opacity:.6;
  animation:floatPill linear infinite;
  will-change:transform;
  box-shadow:0 6px 16px rgba(11,37,69,.10),inset 0 1px 0 rgba(255,255,255,.4);
}
.pill::before{
  content:'';position:absolute;left:0;top:0;width:50%;height:100%;
  border-radius:18px 0 0 18px;
}
.pill.p1{background:#34d399}.pill.p1::before{background:#10b981}
.pill.p2{background:#fbbf24}.pill.p2::before{background:#f59e0b}
.pill.p3{background:#67e8f9}.pill.p3::before{background:#22d3ee}
.pill.p4{background:#fda4af}.pill.p4::before{background:#fb7185}
.pill.p5{background:#a78bfa}.pill.p5::before{background:#8b5cf6}
.pill.p6{background:#4ade80}.pill.p6::before{background:#22c55e}
@keyframes floatPill{
  0%   {transform:translate3d(0, 110vh, 0) rotate(0)}
  100% {transform:translate3d(50px, -15vh, 0) rotate(180deg)}
}

/* ============================================
   PAGE WRAPPER
   ============================================ */
.shell{
  position:relative;z-index:10;min-height:100svh;
  display:flex;flex-direction:column;
}
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:clamp(18px,2.5vw,28px) clamp(20px,4vw,44px);
  position:relative;z-index:11;
}
.brand{
  display:inline-flex;align-items:center;gap:12px;
  font-family:'Plus Jakarta Sans',sans-serif;font-weight:900;font-size:22px;letter-spacing:-.02em;
  color:var(--B);
}
.brand-mark{
  width:40px;height:40px;border-radius:11px;
  background:linear-gradient(135deg,#34d399,#0E7C66 60%,#0a5e4d);
  display:inline-flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;
  box-shadow:0 8px 22px rgba(14,124,102,.32),inset 0 1px 0 rgba(255,255,255,.25);
}
.brand-mark::after{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 30% 25%, rgba(255,255,255,.35) 0%, transparent 50%);
}
.brand-mark svg{width:18px;height:18px;color:white;position:relative;z-index:1}
.brand .loca{color:var(--B)}
.brand .pharma{color:var(--G)}

.back-link{
  display:inline-flex;align-items:center;gap:8px;
  font-size:13px;font-weight:700;color:var(--MUT);
  background:white;border:1px solid var(--BDR);
  padding:9px 16px;border-radius:100px;
  transition:background .25s,color .25s,border-color .25s,transform .25s var(--ease-out);
  font-family:'Plus Jakarta Sans',sans-serif;
}
.back-link:hover{background:var(--LT);color:var(--B);border-color:#cdd5e1;transform:translateX(-2px)}
.back-link i{font-size:11px}

/* ============================================
   MAIN — centered card
   ============================================ */
.main{
  flex:1;display:flex;align-items:center;justify-content:center;
  padding:20px clamp(16px,3vw,32px) 40px;
}
.card-stack{position:relative;width:100%;max-width:480px}

.card{
  position:relative;z-index:2;
  background:var(--card);
  border:1px solid var(--BDR);
  border-radius:24px;
  padding:clamp(24px,3vw,40px);
  box-shadow:
    0 1px 2px rgba(11,37,69,.05),
    0 14px 32px -8px rgba(11,37,69,.12),
    0 30px 60px -20px rgba(11,37,69,.14);
  animation:cardIn .55s var(--ease-out) both;
  overflow:hidden;
}
@keyframes cardIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

/* Subtle gold accent on top edge */
.card::after{
  content:'';position:absolute;left:0;right:0;top:0;height:3px;
  background:linear-gradient(90deg, transparent 0%, var(--G) 30%, var(--GOLD) 70%, transparent 100%);
  opacity:.5;
}

/* Live status pill */
.live-pill{
  display:inline-flex;align-items:center;gap:8px;
  font-size:11px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;
  background:#ecfdf5;color:var(--G);
  border:1px solid rgba(14,124,102,.2);
  padding:5px 12px;border-radius:100px;
  margin-bottom:22px;
  font-family:'Plus Jakarta Sans',sans-serif;
}
.live-pill .live-dot{
  width:7px;height:7px;background:var(--G);border-radius:50%;
  box-shadow:0 0 0 3px rgba(14,124,102,.18);
}

/* Greeting */
.greeting{
  font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
  color:var(--MUT);margin-bottom:6px;
  font-family:'JetBrains Mono',monospace;
}
.greeting .now{color:var(--G)}

.title{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:clamp(26px,2.6vw,34px);font-weight:900;line-height:1.12;letter-spacing:-.025em;
  color:var(--B);margin-bottom:8px;
}
.subtitle{
  font-size:14px;color:var(--MUT);line-height:1.55;margin-bottom:28px;
}

/* Alerts */
.alert{
  display:flex;align-items:center;gap:10px;
  padding:12px 14px;border-radius:12px;
  font-size:13px;font-weight:600;margin-bottom:18px;
}
.alert.err{background:rgba(240,68,56,.08);color:#a8201a;border:1px solid rgba(240,68,56,.22)}
.alert.ok {background:rgba(18,183,106,.08);color:#0a7141;border:1px solid rgba(18,183,106,.22)}
.alert i{flex-shrink:0;font-size:14px}

/* ============================================
   FIELDS — clean, light
   ============================================ */
.field{position:relative;margin-bottom:14px}
.field-wrap{
  position:relative;
  background:#f5f7fa;
  border:1.5px solid var(--BDR);
  border-radius:14px;
  transition:border-color .25s var(--ease-soft), background .25s, box-shadow .25s;
}
.field-wrap:focus-within{
  background:white;
  border-color:var(--G);
  box-shadow:0 0 0 4px rgba(14,124,102,.1);
}
.field-input{
  width:100%;padding:18px 16px 8px;
  font-size:15px;font-family:'Manrope',sans-serif;color:var(--T);
  background:transparent;border:none;outline:none;
  font-weight:500;
}
.field-input::placeholder{color:transparent}
.field-input.has-icon{padding-left:48px}
.field-icon{
  position:absolute;left:16px;top:50%;transform:translateY(-50%);
  color:var(--MUT);font-size:15px;pointer-events:none;
  transition:color .25s;z-index:1;
}
.field-wrap:focus-within .field-icon{color:var(--G)}

.field-label{
  position:absolute;left:48px;top:50%;transform:translateY(-50%);
  font-size:14px;color:var(--MUT);font-weight:500;pointer-events:none;
  transition:top .25s var(--ease-out),font-size .25s,color .25s,letter-spacing .25s,transform .25s;
  font-family:'Manrope',sans-serif;
}
.field-input:focus + .field-label,
.field-input:not(:placeholder-shown) + .field-label{
  top:8px;transform:translateY(0);
  font-size:10px;color:var(--G);font-weight:800;letter-spacing:.12em;text-transform:uppercase;
}

/* Toggle pw */
.field-toggle{
  position:absolute;right:8px;top:50%;transform:translateY(-50%);
  width:36px;height:36px;border-radius:9px;border:none;background:transparent;
  color:var(--MUT);cursor:pointer;font-size:14px;
  display:flex;align-items:center;justify-content:center;
  transition:color .2s,background .2s;z-index:2;
}
.field-toggle:hover{color:var(--G);background:rgba(14,124,102,.06)}

/* Row : remember / forgot */
.row{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  flex-wrap:wrap;margin:6px 0 22px;
}
.checkbox{
  display:inline-flex;align-items:center;gap:10px;cursor:pointer;
  font-size:13px;color:var(--T);font-weight:600;user-select:none;
}
.checkbox input{position:absolute;opacity:0;width:0;height:0}
.checkbox .box{
  width:18px;height:18px;border-radius:6px;
  border:1.5px solid var(--BDR);background:white;
  display:inline-flex;align-items:center;justify-content:center;
  transition:background .2s,border-color .2s;
  flex-shrink:0;
}
.checkbox .box i{font-size:10px;color:white;opacity:0;transition:opacity .15s}
.checkbox input:checked ~ .box{background:var(--G);border-color:var(--G)}
.checkbox input:checked ~ .box i{opacity:1}
.checkbox input:focus-visible ~ .box{box-shadow:0 0 0 3px rgba(14,124,102,.22)}
.forgot{
  font-size:13px;color:var(--G);font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;
  position:relative;transition:color .2s;
}
.forgot::after{
  content:'';position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--G);
  transform:scaleX(0);transform-origin:right;transition:transform .25s var(--ease-out);
}
.forgot:hover{color:var(--GD)}
.forgot:hover::after{transform:scaleX(1);transform-origin:left}

/* Submit */
.submit{
  width:100%;padding:15px;border:none;border-radius:14px;cursor:pointer;
  color:white;font-size:15px;font-weight:900;
  font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:.01em;
  display:flex;align-items:center;justify-content:center;gap:10px;
  transition:background .25s, transform .2s var(--ease-out), box-shadow .25s;
  position:relative;overflow:hidden;
  background:var(--G);
  box-shadow:0 8px 20px -4px rgba(14,124,102,.5);
}
.submit:hover{background:var(--GD);transform:translateY(-2px);box-shadow:0 14px 28px -6px rgba(14,124,102,.55)}
.submit:active{transform:translateY(0)}
.submit i.fa-arrow-right{transition:transform .25s var(--ease-out)}
.submit:hover i.fa-arrow-right{transform:translateX(4px)}
.submit.loading{pointer-events:none}
.submit.loading .submit-txt,
.submit.loading i.fa-arrow-right{visibility:hidden}
.submit .spinner{
  position:absolute;width:20px;height:20px;border-radius:50%;
  border:2.5px solid rgba(255,255,255,.3);border-top-color:white;
  opacity:0;animation:spin .9s linear infinite;
}
.submit.loading .spinner{opacity:1}
@keyframes spin{to{transform:rotate(360deg)}}

/* Divider */
.divider{
  display:flex;align-items:center;gap:14px;margin:22px 0;
  font-size:10px;color:var(--MUT);font-weight:800;letter-spacing:.16em;text-transform:uppercase;
}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--BDR)}

/* Social */
.social{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}
.soc-btn{
  display:flex;align-items:center;justify-content:center;gap:9px;
  padding:13px;border-radius:12px;
  background:white;border:1.5px solid var(--BDR);
  color:var(--T);font-size:13px;font-weight:700;cursor:pointer;
  font-family:'Plus Jakarta Sans',sans-serif;
  transition:background .25s,border-color .25s,transform .2s var(--ease-out);
}
.soc-btn:hover{background:var(--LT);border-color:#cdd5e1;transform:translateY(-1px)}
.soc-btn .ico{width:18px;height:18px;display:inline-block}
.soc-btn.google .ico{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='%234285F4' d='M21.35 11.1H12v3.2h5.35c-.23 1.5-1.7 4.4-5.35 4.4-3.22 0-5.85-2.66-5.85-5.95S8.78 6.8 12 6.8c1.83 0 3.06.78 3.76 1.45l2.56-2.46C16.78 4.3 14.62 3.4 12 3.4 7.03 3.4 3 7.43 3 12.4S7.03 21.4 12 21.4c6.93 0 9.35-4.85 9.35-7.35 0-.5-.05-.93-.13-1.35z'/></svg>") center/contain no-repeat}
.soc-btn.facebook .ico{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='%231877F2' d='M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07C2 17.09 5.66 21.25 10.44 22v-7.02H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.47H15.2c-1.24 0-1.63.77-1.63 1.56v1.88h2.77l-.44 2.91h-2.33V22C18.34 21.25 22 17.09 22 12.07z'/></svg>") center/contain no-repeat}

.signup{text-align:center;font-size:13px;color:var(--MUT)}
.signup a{color:var(--G);font-weight:800;font-family:'Plus Jakarta Sans',sans-serif;position:relative}
.signup a::after{
  content:'';position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--G);
  transform:scaleX(0);transform-origin:right;transition:transform .25s var(--ease-out);
}
.signup a:hover::after{transform:scaleX(1);transform-origin:left}

/* Card meta strip */
.card-meta{
  margin-top:24px;padding-top:18px;
  border-top:1px dashed var(--BDR);
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;
  font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--MUT);
  letter-spacing:.06em;
}
.card-meta .key{color:var(--T);font-weight:700}

/* Footer */
.foot{
  padding:18px clamp(20px,4vw,44px);
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;
  font-size:11px;color:var(--MUT);position:relative;z-index:11;
  font-family:'JetBrains Mono',monospace;letter-spacing:.04em;
}
.foot strong{color:var(--ERR);font-weight:700}
.foot a{transition:color .2s}
.foot a:hover{color:var(--G)}

/* ============================================
   RESPONSIVE
   ============================================ */
@media(max-width:640px){
  .topbar{padding:14px 16px}
  .brand{font-size:18px}
  .brand-mark{width:34px;height:34px;border-radius:9px}
  .brand-mark svg{width:15px;height:15px}
  .back-link{padding:7px 12px;font-size:12px}
  .main{padding:8px 14px 24px}
  .card{padding:22px 18px;border-radius:22px}
  .title{font-size:23px}
  .subtitle{font-size:13px;margin-bottom:22px}
  .live-pill{font-size:10px;padding:4px 10px;margin-bottom:18px}
  .greeting{margin-bottom:4px;font-size:10px}
  .field-input{padding:16px 14px 6px;font-size:14px}
  .field-input.has-icon{padding-left:44px}
  .field-icon{left:14px}
  .field-label{left:44px;font-size:13px}
  .submit{padding:14px;font-size:14px}
  .social{grid-template-columns:1fr 1fr}
  .foot{padding:14px 16px;font-size:10px}
  .pill{width:34px;height:14px}
}

@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
  .pill{display:none}
}
</style>
</head>

<body>

<!-- LIGHT BG -->
<div class="bg" aria-hidden="true"></div>
<div class="bg-grid" aria-hidden="true"></div>

<!-- FLOATING PILLS (visible) -->
<div class="pills" aria-hidden="true" id="pills"></div>

<div class="shell">

  <!-- TOP BAR -->
  <header class="topbar">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 2h6v7h7v6h-7v7H9v-7H2V9h7z"/></svg>
      </span>
      <span><span class="loca">Loca</span><span class="pharma">pharma</span></span>
    </a>
    <a href="/" class="back-link"><i class="fa-solid fa-arrow-left"></i>Accueil</a>
  </header>

  <!-- MAIN -->
  <main class="main">
    <div class="card-stack">
      <div class="card" id="loginCard">

        <div class="live-pill">
          <span class="live-dot"></span>
          <span>5 pharmacies de garde — maintenant</span>
        </div>

        <div class="greeting" id="greeting">— Bienvenue &nbsp;·&nbsp; <span class="now" id="nowTime">--:--</span></div>
        <h1 class="title">Reconnectez-vous<br>à votre santé.</h1>
        <p class="subtitle">Entrez vos identifiants pour accéder à votre espace personnel Locapharma.</p>

        {% if error is defined and error %}
          <div class="alert err" role="alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
          </div>
        {% endif %}

        {% if app is defined %}
          {% for message in app.flashes('success') %}
            <div class="alert ok"><i class="fa-solid fa-circle-check"></i><span>{{ message }}</span></div>
          {% endfor %}
        {% endif %}

        <form method="post" action="{{ path('app_login') }}" id="loginForm" novalidate>

          <div class="field">
            <div class="field-wrap">
              <i class="fa-solid fa-envelope field-icon"></i>
              <input
                type="email" id="inputEmail" name="_username"
                class="field-input has-icon"
                placeholder=" " autocomplete="email" inputmode="email" autofocus required
                value="{{ last_username|default('') }}"
              >
              <label for="inputEmail" class="field-label">Adresse email</label>
            </div>
          </div>

          <div class="field">
            <div class="field-wrap">
              <i class="fa-solid fa-lock field-icon"></i>
              <input
                type="password" id="inputPassword" name="_password"
                class="field-input has-icon"
                placeholder=" " autocomplete="current-password" required minlength="6"
              >
              <label for="inputPassword" class="field-label">Mot de passe</label>
              <button type="button" class="field-toggle" id="pwToggle" aria-label="Afficher / masquer le mot de passe">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

          <div class="row">
            <label class="checkbox">
              <input type="checkbox" name="_remember_me" checked>
              <span class="box"><i class="fa-solid fa-check"></i></span>
              <span>Rester connecté</span>
            </label>
            {# TODO: path('app_forgot_password_request') #}
            <a href="#" class="forgot">Mot de passe oublié ?</a>
          </div>

          <button type="submit" class="submit" id="submitBtn">
            <span class="spinner" aria-hidden="true"></span>
            <span class="submit-txt">Continuer</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>

          <div class="divider"><span>ou continuer avec</span></div>

          <div class="social">
            <button type="button" class="soc-btn google" onclick="showToast('Connexion Google bientôt disponible')">
              <span class="ico"></span>Google
            </button>
            <button type="button" class="soc-btn facebook" onclick="showToast('Connexion Facebook bientôt disponible')">
              <span class="ico"></span>Facebook
            </button>
          </div>

          <p class="signup">
            Nouveau ici ? <a href="#">Créer un compte</a>
            &nbsp;·&nbsp; <a href="#">Pharmacien ?</a>
          </p>
        </form>

        <div class="card-meta">
          <span><span class="key">SESSION</span> #LOC-<span id="sessId">XXXXX</span></span>
          <span><span class="key">SECURE</span> TLS 1.3 · CSRF ✓</span>
        </div>

      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="foot">
    <span>© 2026 Locapharma · Technopole Numérique des Comores</span>
    <span>SAMU <strong>773</strong> · <a href="#">Aide</a> · <a href="#">CGU</a></span>
  </footer>

</div>

<!-- TOAST -->
<div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:#0B2545;color:white;padding:13px 24px;border-radius:100px;font-size:13px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;box-shadow:0 12px 32px rgba(11,37,69,.35);opacity:0;transition:opacity .3s,transform .3s cubic-bezier(.22,1,.36,1);pointer-events:none;z-index:1000"></div>

<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ============================================
// 1) Time-aware greeting (computed once, no ticking)
// ============================================
(function(){
  const g = document.getElementById('greeting');
  if(!g) return;
  const d = new Date();
  const h = d.getHours();
  let label;
  if(h < 5)        label = 'Bonne nuit';
  else if(h < 12)  label = 'Bonjour';
  else if(h < 18)  label = 'Bon après-midi';
  else             label = 'Bonsoir';
  const hh = String(d.getHours()).padStart(2,'0');
  const mm = String(d.getMinutes()).padStart(2,'0');
  g.innerHTML = '— ' + label + ' &nbsp;·&nbsp; <span class="now">' + hh + ':' + mm + '</span>';
})();

// ============================================
// 2) Static fake session ID for ID-card vibe
// ============================================
(function(){
  const el = document.getElementById('sessId');
  if(el) el.textContent = Math.random().toString(36).substring(2, 7).toUpperCase();
})();

// ============================================
// 3) Floating pills — visible, slow
// ============================================
(function(){
  if(reduceMotion) return;
  const root = document.getElementById('pills');
  if(!root) return;
  const types = ['p1','p2','p3','p4','p5','p6'];
  const N = window.innerWidth < 640 ? 10 : 18;
  for(let i = 0; i < N; i++){
    const el = document.createElement('div');
    el.className = 'pill ' + types[Math.floor(Math.random() * types.length)];
    const left  = Math.random() * 100;
    const dur   = 40 + Math.random() * 35;   // 40-75s (lent)
    const delay = -Math.random() * dur;
    const scale = .7 + Math.random() * .8;   // 0.7 - 1.5
    el.style.cssText =
      'left:' + left + '%; ' +
      'animation-duration:' + dur + 's; ' +
      'animation-delay:' + delay + 's; ' +
      'transform:scale(' + scale + ');';
    root.appendChild(el);
  }
})();

// ============================================
// 4) Password show/hide
// ============================================
(function(){
  const btn = document.getElementById('pwToggle');
  const inp = document.getElementById('inputPassword');
  if(!btn || !inp) return;
  btn.addEventListener('click', () => {
    const isPw = inp.type === 'password';
    inp.type = isPw ? 'text' : 'password';
    btn.querySelector('i').className = isPw ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
  });
})();

// ============================================
// 5) Form submit -> loading state
// ============================================
(function(){
  const f = document.getElementById('loginForm');
  const b = document.getElementById('submitBtn');
  if(!f || !b) return;
  f.addEventListener('submit', () => {
    if(f.checkValidity()) b.classList.add('loading');
  });
})();

// ============================================
// 6) Toast helper
// ============================================
function showToast(msg){
  const t = document.getElementById('toast');
  if(!t) return;
  t.textContent = msg;
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._tm);
  t._tm = setTimeout(() => {
    t.style.opacity = '0';
    t.style.transform = 'translateX(-50%) translateY(20px)';
  }, 2600);
}
</script>

</body>
</html>
