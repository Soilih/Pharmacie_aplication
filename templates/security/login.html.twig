{# templates/security/login.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Connexion · Locapharma</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
/* ============================================
   VARIABLES & RESET
   ============================================ */
:root{
  --G:#0E7C66; --GD:#0a5e4d; --GL:#e1f5ee; --GXL:#f0faf7;
  --B:#0B2545; --BM:#1a3a6e; --BL:#eef2f8;
  --GOLD:#F4C430;
  --T:#1D2939; --MUT:#5A6A85; --LT:#F8FAFE; --BDR:#E2E8F0;
  --W:#fff; --ERR:#F04438; --OK:#12B76A;
  --shadow-sm: 0 4px 12px rgba(11,37,69,.04);
  --shadow-md: 0 12px 28px rgba(11,37,69,.08);
  --shadow-lg: 0 24px 48px rgba(11,37,69,.12);
  --glass-border: rgba(255,255,255,.22);
  --ease-out: cubic-bezier(.22, 1, .36, 1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  font-family:'Manrope',sans-serif;
  background:var(--B);
  min-height:100svh;
  display:flex;align-items:center;justify-content:center;
  overflow-x:hidden;
  padding:20px;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit}

/* ============================================
   BACKGROUND — pharmacy photo + navy/teal overlay + slow dots
   ============================================ */
.login-bg{
  position:fixed;inset:0;z-index:0;
  background:url('https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=1800&q=80') center/cover no-repeat;
  filter:blur(6px) brightness(.4);
  transform:scale(1.06);
}
.login-overlay{
  position:fixed;inset:0;z-index:0;
  background:linear-gradient(135deg, rgba(11,37,69,.92) 0%, rgba(14,124,102,.7) 55%, rgba(11,37,69,.94) 100%);
}
.hero-dots{
  position:fixed;inset:0;z-index:0;
  background-image:radial-gradient(circle, rgba(255,255,255,.06) 1px, transparent 1px);
  background-size:34px 34px;
  animation:dotsMove 40s linear infinite;
  opacity:.7;
  mask-image:radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 80%);
  -webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 80%);
}
@keyframes dotsMove{0%{background-position:0 0}100%{background-position:34px 34px}}

/* ============================================
   FLOATING PHARMACY ICONS — slow & subtle
   ============================================ */
.float-icons{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.fi{
  position:absolute;
  color:rgba(255,255,255,.06);
  animation:floatSlow linear infinite;
  will-change:transform;
}
.fi svg{width:100%;height:100%;display:block}
@keyframes floatSlow{
  0%   {transform:translate3d(0, 110vh, 0) rotate(0deg)}
  100% {transform:translate3d(40px, -15vh, 0) rotate(180deg)}
}

/* ============================================
   ANIMATIONS
   ============================================ */
@keyframes fadeSlideUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeSlideRight{from{opacity:0;transform:translateX(-28px)}to{opacity:1;transform:translateX(0)}}
@keyframes fadeSlideLeft{from{opacity:0;transform:translateX(28px)}to{opacity:1;transform:translateX(0)}}

/* ============================================
   LAYOUT
   ============================================ */
.login-wrapper{
  position:relative;z-index:10;width:100%;max-width:1120px;margin:0 auto;
  display:flex;align-items:center;justify-content:center;
  min-height:calc(100svh - 40px);
}
.login-card{
  display:grid;grid-template-columns:1fr 1fr;
  background:rgba(255,255,255,.1);
  backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
  border-radius:42px;
  border:1px solid var(--glass-border);
  overflow:hidden;
  box-shadow:var(--shadow-lg), 0 0 0 1px rgba(255,255,255,.05) inset;
  animation:fadeSlideUp .55s var(--ease-out);
  width:100%;
}

/* ============================================
   LEFT — BRANDING
   ============================================ */
.brand-side{
  padding:2.8rem 2.5rem;
  color:white;
  display:flex;flex-direction:column;justify-content:center;
  animation:fadeSlideRight .5s ease-out;
}
.logo-block{display:flex;align-items:center;gap:18px;margin-bottom:2.2rem}
.logo-img{
  width:74px;height:74px;border-radius:22px;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.25);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
  backdrop-filter:blur(10px);
}
.logo-img img{width:100%;height:100%;object-fit:cover}
.logo-img .fallback{
  width:100%;height:100%;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg, var(--G), var(--GD));
}
.logo-img .fallback svg{width:28px;height:28px;color:#fff}
.logo-text{font-family:'Plus Jakarta Sans',sans-serif;font-weight:900;font-size:1.9rem;letter-spacing:-.02em;line-height:1}
.logo-text .loca{color:white;text-shadow:0 1px 2px rgba(0,0,0,.1)}
.logo-text .pharma{color:var(--GOLD);text-shadow:0 1px 2px rgba(0,0,0,.1)}

.brand-side h2{
  font-size:1.95rem;font-weight:800;line-height:1.25;
  margin-bottom:1rem;font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em;
}
.brand-side .highlight{color:var(--GOLD)}
.brand-desc{font-size:.95rem;line-height:1.6;opacity:.85;margin-bottom:1.8rem;max-width:95%}

.badges{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:1.8rem}
.badge-item{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.09);
  border:1px solid rgba(255,255,255,.16);
  padding:.45rem 1rem;border-radius:100px;
  font-size:.78rem;font-weight:700;
  backdrop-filter:blur(8px);
}
.badge-item i{color:var(--GOLD);font-size:.8rem}

.partner-strip{display:flex;flex-wrap:wrap;gap:10px}
.partner-strip span{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(255,255,255,.06);
  border-radius:24px;padding:.42rem 1rem;
  font-size:.78rem;font-weight:600;
  backdrop-filter:blur(5px);
  border:1px solid rgba(255,255,255,.08);
}
.partner-strip i{font-size:.75rem;color:rgba(255,255,255,.7)}

/* ============================================
   RIGHT — FORM (white card nested)
   ============================================ */
.form-side{
  background:var(--W);
  padding:2.4rem 2.4rem;
  margin:1.4rem;
  border-radius:30px;
  box-shadow:var(--shadow-md);
  animation:fadeSlideLeft .5s ease-out .08s both;
}
.form-header{text-align:center;margin-bottom:2rem}
.form-header h3{
  font-family:'Plus Jakarta Sans',sans-serif;
  font-size:1.85rem;font-weight:800;color:var(--B);
  margin-bottom:.45rem;letter-spacing:-.02em;
}
.form-header p{color:var(--MUT);font-size:.92rem}

.alert{
  display:flex;align-items:center;gap:10px;
  padding:12px 14px;border-radius:14px;
  font-size:13px;font-weight:600;margin-bottom:18px;
  animation:fadeSlideUp .4s var(--ease-out);
}
.alert.err{background:rgba(240,68,56,.08);color:#a8201a;border:1px solid rgba(240,68,56,.22)}
.alert.ok {background:rgba(18,183,106,.08);color:#0a7141;border:1px solid rgba(18,183,106,.22)}
.alert i{flex-shrink:0;font-size:14px}

.input-group{margin-bottom:1.3rem}
.input-label{
  display:block;font-size:.85rem;font-weight:700;
  margin-bottom:.5rem;color:var(--T);letter-spacing:-.2px;
}
.input-field{
  width:100%;padding:.95rem 1.1rem;
  border:1.5px solid var(--BDR);border-radius:18px;
  font-family:'Manrope',sans-serif;font-size:.95rem;
  transition:border-color .25s var(--ease-out), background .25s, box-shadow .25s;
  background:var(--LT);outline:none;font-weight:500;color:var(--T);
}
.input-field:focus{
  border-color:var(--G);background:white;
  box-shadow:0 0 0 4px rgba(14,124,102,.12);
}
.pwd-wrap{position:relative}
.toggle-eye{
  position:absolute;right:.7rem;top:50%;transform:translateY(-50%);
  background:transparent;border:none;cursor:pointer;
  color:var(--MUT);font-size:1.05rem;
  width:36px;height:36px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  transition:color .2s,background .2s;
}
.toggle-eye:hover{color:var(--G);background:rgba(14,124,102,.06)}

.remember-row{
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;flex-wrap:wrap;margin:.4rem 0 1.4rem;
}
.checkbox{
  display:inline-flex;align-items:center;gap:9px;cursor:pointer;
  font-size:.85rem;color:var(--T);font-weight:600;user-select:none;
}
.checkbox input{position:absolute;opacity:0;width:0;height:0}
.checkbox .box{
  width:18px;height:18px;border-radius:6px;
  border:1.5px solid var(--BDR);background:white;
  display:inline-flex;align-items:center;justify-content:center;
  transition:background .2s,border-color .2s;
}
.checkbox .box i{font-size:9px;color:white;opacity:0;transition:opacity .15s}
.checkbox input:checked ~ .box{background:var(--G);border-color:var(--G)}
.checkbox input:checked ~ .box i{opacity:1}
.checkbox input:focus-visible ~ .box{box-shadow:0 0 0 3px rgba(14,124,102,.22)}
.forgot-link{
  font-size:.85rem;color:var(--G);font-weight:700;
  font-family:'Plus Jakarta Sans',sans-serif;
  transition:color .2s;
}
.forgot-link:hover{color:var(--GD);text-decoration:underline}

.login-submit{
  width:100%;padding:1rem;border:none;border-radius:22px;cursor:pointer;
  background:var(--G);color:white;
  font-weight:800;font-size:1rem;font-family:'Plus Jakarta Sans',sans-serif;
  display:flex;align-items:center;justify-content:center;gap:10px;
  margin-bottom:1.4rem;
  transition:background .25s, transform .2s var(--ease-out), box-shadow .25s;
  box-shadow:0 6px 18px -4px rgba(14,124,102,.45);
  position:relative;overflow:hidden;
}
.login-submit:hover{background:var(--GD);transform:translateY(-2px);box-shadow:0 12px 28px -6px rgba(14,124,102,.55)}
.login-submit:active{transform:translateY(0)}
.login-submit i.fa-arrow-right-to-bracket{transition:transform .2s var(--ease-out)}
.login-submit:hover i.fa-arrow-right-to-bracket{transform:translateX(3px)}
.login-submit.loading{pointer-events:none;opacity:.85}
.login-submit.loading .lbl{visibility:hidden}
.login-submit.loading i.fa-arrow-right-to-bracket{visibility:hidden}
.login-submit .spinner{
  position:absolute;width:20px;height:20px;border-radius:50%;
  border:2.5px solid rgba(255,255,255,.3);border-top-color:white;
  opacity:0;animation:spin .9s linear infinite;
}
.login-submit.loading .spinner{opacity:1}
@keyframes spin{to{transform:rotate(360deg)}}

.divider-light{
  display:flex;align-items:center;gap:1rem;
  color:var(--MUT);font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  margin:1.2rem 0;
}
.divider-light .line{flex:1;height:1px;background:var(--BDR)}

.social-icons{display:flex;justify-content:center;gap:1rem;margin-bottom:1.4rem}
.social-btn{
  width:54px;height:54px;border-radius:50%;
  background:white;border:1.5px solid var(--BDR);
  display:flex;align-items:center;justify-content:center;
  font-size:1.25rem;cursor:pointer;
  transition:background .25s, color .25s, border-color .25s, transform .2s var(--ease-out), box-shadow .25s;
}
.social-btn.google{color:#DB4437;border-color:#FFD9D4}
.social-btn.google:hover{background:#DB4437;color:white;border-color:#DB4437;transform:translateY(-3px);box-shadow:0 8px 18px rgba(219,68,55,.28)}
.social-btn.microsoft{color:#2B579A;border-color:#C8DCF5}
.social-btn.microsoft:hover{background:#2B579A;color:white;border-color:#2B579A;transform:translateY(-3px);box-shadow:0 8px 18px rgba(43,87,154,.28)}
.social-btn.cps{color:var(--G);border-color:#C8E6E0}
.social-btn.cps:hover{background:var(--G);color:white;border-color:var(--G);transform:translateY(-3px);box-shadow:0 8px 18px rgba(14,124,102,.28)}

.signup-text{text-align:center;font-size:.88rem;color:var(--MUT)}
.signup-text a{color:var(--G);font-weight:800;font-family:'Plus Jakarta Sans',sans-serif}
.signup-text a:hover{text-decoration:underline}

.toast-notif{
  position:fixed;bottom:2rem;left:50%;
  transform:translateX(-50%) translateY(24px);
  background:rgba(11,37,69,.96);color:white;
  padding:.85rem 1.6rem;border-radius:60px;
  font-size:.88rem;font-weight:600;z-index:2000;
  opacity:0;transition:opacity .25s ease, transform .3s ease;
  pointer-events:none;backdrop-filter:blur(16px);
  font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.2px;
  box-shadow:var(--shadow-md);
  white-space:nowrap;
}
.toast-notif.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ============================================
   RESPONSIVE
   ============================================ */
@media(max-width:780px){
  body{padding:12px}
  .login-wrapper{min-height:auto;padding:0}
  .login-card{grid-template-columns:1fr;border-radius:32px}
  .brand-side{
    padding:1.7rem 1.5rem .8rem;text-align:center;
  }
  .brand-side h2, .brand-side .brand-desc,
  .brand-side .badges, .brand-side .partner-strip{display:none}
  .logo-block{justify-content:center;margin-bottom:.5rem;gap:12px}
  .logo-img{width:62px;height:62px;border-radius:18px}
  .logo-text{font-size:1.75rem}
  .form-side{margin:.8rem 1rem 1.4rem;padding:1.7rem 1.4rem;border-radius:26px}
  .form-header h3{font-size:1.6rem}
  .form-header p{font-size:.88rem}
  .input-field{padding:.95rem 1rem;font-size:.95rem;border-radius:16px}
  .toggle-eye{right:.55rem}
  .login-submit{padding:1rem;font-size:.95rem;border-radius:20px}
  .social-btn{width:52px;height:52px;font-size:1.2rem}
  .toast-notif{font-size:.82rem;padding:.75rem 1.3rem;white-space:normal;text-align:center;max-width:88vw;bottom:1.2rem}
}
@media(max-width:400px){
  .form-side{margin:.5rem .7rem 1.1rem;padding:1.4rem 1.1rem}
  .form-header h3{font-size:1.5rem}
  .logo-img{width:56px;height:56px;border-radius:16px}
  .logo-text{font-size:1.55rem}
  .social-btn{width:48px;height:48px;font-size:1.1rem}
}
@media(max-width:780px) and (orientation:landscape){
  .brand-side{padding:.9rem 1rem .1rem}
  .logo-img{width:48px;height:48px}
  .form-side{margin:.7rem 1rem 1rem;padding:1rem 1.1rem}
  .form-header{margin-bottom:1rem}
}
@media(min-width:781px){
  .login-card{max-width:1080px}
  .form-side{max-width:460px;margin:1.4rem 1.4rem 1.4rem auto;width:100%}
}

/* Accessibility & reduced motion */
input, button, .social-btn, .toggle-eye{touch-action:manipulation}
button:focus-visible, .social-btn:focus-visible, .toggle-eye:focus-visible{
  outline:2px solid var(--G);outline-offset:2px;
}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
  .fi{display:none}
}
</style>
</head>
<body>

<div class="login-bg" aria-hidden="true"></div>
<div class="login-overlay" aria-hidden="true"></div>
<div class="hero-dots" aria-hidden="true"></div>

<!-- Floating pharma icons (slow + subtle) -->
<div class="float-icons" id="floatIcons" aria-hidden="true"></div>

<!-- SVG symbol library for floating icons + brand fallback -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="ic-pill"   viewBox="0 0 64 64"><rect x="6"  y="22" width="52" height="20" rx="10" fill="currentColor"/><rect x="6"  y="22" width="26" height="20" rx="10" fill="currentColor" opacity=".5"/></symbol>
    <symbol id="ic-cap"    viewBox="0 0 64 64"><rect x="22" y="6"  width="20" height="52" rx="10" fill="currentColor"/><rect x="22" y="6"  width="20" height="26" rx="10" fill="currentColor" opacity=".5"/></symbol>
    <symbol id="ic-cross"  viewBox="0 0 64 64"><path d="M24 6h16v18h18v16H40v18H24V40H6V24h18z" fill="currentColor"/></symbol>
    <symbol id="ic-heart"  viewBox="0 0 64 64"><path d="M32 56s-22-12-22-28a12 12 0 0 1 22-7 12 12 0 0 1 22 7c0 16-22 28-22 28z" fill="currentColor"/></symbol>
    <symbol id="ic-steth"  viewBox="0 0 64 64"><path d="M14 8v18c0 8 7 14 14 14s14-6 14-14V8h-6v18a8 8 0 0 1-16 0V8z" fill="currentColor"/><circle cx="50" cy="46" r="8" fill="none" stroke="currentColor" stroke-width="4"/><path d="M28 40v8" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/></symbol>
    <symbol id="ic-mortar" viewBox="0 0 64 64"><path d="M10 26h44l-6 24a6 6 0 0 1-6 4H22a6 6 0 0 1-6-4z" fill="currentColor"/><rect x="34" y="6" width="6" height="22" rx="2" fill="currentColor" transform="rotate(20 37 17)"/></symbol>
    <symbol id="ic-plus"   viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="4"/><path d="M32 18v28M18 32h28" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></symbol>
    <symbol id="ic-brand"  viewBox="0 0 24 24"><path d="M9 2h6v7h7v6h-7v7H9v-7H2V9h7z" fill="currentColor"/></symbol>
  </defs>
</svg>

<div class="login-wrapper">
  <div class="login-card">

    {# ============================================
       LEFT — BRANDING
       ============================================ #}
    <div class="brand-side">
      <div class="logo-block">
        <div class="logo-img">
          <img src="{{ asset('images/locapharma.jpeg') }}" alt="Locapharma"
               onerror="this.onerror=null;this.parentElement.innerHTML='<span class=\'fallback\'><svg><use href=\'#ic-brand\'/></svg></span>'">
        </div>
        <div class="logo-text">
          <span class="loca">Loca</span><span class="pharma">pharma</span>
        </div>
      </div>

      <h2>La <span class="highlight">santé numérique</span><br>des Comores.</h2>
      <p class="brand-desc">
        Accédez à votre espace personnel pour gérer vos commandes, retrouver vos pharmacies favorites et l'accès garde 24/7 — sur les 3 îles.
      </p>

      <div class="badges">
        <div class="badge-item"><i class="fa-regular fa-circle-check"></i>Plateforme certifiée</div>
        <div class="badge-item"><i class="fa-solid fa-shield-halved"></i>Données chiffrées</div>
        <div class="badge-item"><i class="fa-regular fa-clock"></i>Service 24/7</div>
      </div>

      <div class="partner-strip">
        <span><i class="fa-regular fa-building"></i>30+ pharmacies</span>
        <span><i class="fa-solid fa-map-location-dot"></i>3 îles couvertes</span>
        <span><i class="fa-regular fa-calendar"></i>Planning de garde</span>
      </div>
    </div>

    {# ============================================
       RIGHT — FORM
       ============================================ #}
    <div class="form-side">
      <div class="form-header">
        <h3>Connexion</h3>
        <p>Bon retour parmi nous</p>
      </div>

      {% if error is defined and error %}
        <div class="alert err" role="alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
      {% endif %}

      {% if app is defined %}
        {% for message in app.flashes('success') %}
          <div class="alert ok"><i class="fa-solid fa-circle-check"></i><span>{{ message }}</span></div>
        {% endfor %}
      {% endif %}

      <form method="post" action="{{ path('app_login') }}" id="loginForm" novalidate>

        <div class="input-group">
          <label class="input-label" for="email">Adresse e-mail</label>
          <input
            type="email" id="email" name="_username"
            class="input-field"
            placeholder="vous@locapharma.km"
            autocomplete="email" inputmode="email" required autofocus
            value="{{ last_username|default('') }}"
          >
        </div>

        <div class="input-group">
          <label class="input-label" for="password">Mot de passe</label>
          <div class="pwd-wrap">
            <input
              type="password" id="password" name="_password"
              class="input-field"
              placeholder="••••••••"
              autocomplete="current-password" required minlength="4"
            >
            <button type="button" class="toggle-eye" id="togglePwd" aria-label="Afficher / masquer le mot de passe">
              <i class="fa-regular fa-eye-slash" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="remember-row">
          <label class="checkbox">
            <input type="checkbox" name="_remember_me" checked>
            <span class="box"><i class="fa-solid fa-check"></i></span>
            <span>Rester connecté</span>
          </label>
          {# TODO: path('app_forgot_password_request') #}
          <a href="#" class="forgot-link">Mot de passe oublié ?</a>
        </div>

        <button type="submit" class="login-submit" id="submitBtn">
          <span class="spinner" aria-hidden="true"></span>
          <span class="lbl">Se connecter</span>
          <i class="fa-solid fa-arrow-right-to-bracket"></i>
        </button>

        <div class="divider-light">
          <div class="line"></div>
          <span>Accès sécurisé</span>
          <div class="line"></div>
        </div>

        <div class="social-icons">
          <button type="button" class="social-btn google" onclick="showNotif('Connexion Google bientôt disponible')" aria-label="Connexion avec Google">
            <i class="fab fa-google"></i>
          </button>
          <button type="button" class="social-btn microsoft" onclick="showNotif('Connexion Microsoft bientôt disponible')" aria-label="Connexion avec Microsoft">
            <i class="fab fa-microsoft"></i>
          </button>
          <button type="button" class="social-btn cps" onclick="showNotif('Authentification carte professionnelle bientôt disponible')" aria-label="Connexion avec carte professionnelle">
            <i class="fa-solid fa-id-card"></i>
          </button>
        </div>

        <p class="signup-text">
          Pas encore de compte ? <a href="#">Créer un compte</a>
        </p>
      </form>
    </div>

  </div>
</div>

<div id="toastNotif" class="toast-notif" role="status" aria-live="polite"></div>

<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ============================================
// 1) Floating pharmacy icons (slow + subtle)
// ============================================
(function(){
  if(reduceMotion) return;
  const root = document.getElementById('floatIcons');
  if(!root) return;
  const ICONS = ['ic-pill','ic-cap','ic-cross','ic-heart','ic-steth','ic-mortar','ic-plus'];
  const N = window.innerWidth < 640 ? 6 : 12;
  for(let i = 0; i < N; i++){
    const wrap = document.createElement('div');
    wrap.className = 'fi';
    const size  = 30 + Math.random() * 38;      // 30-68px
    const left  = Math.random() * 100;          // 0-100% x
    const dur   = 55 + Math.random() * 50;      // 55-105s (très lent)
    const delay = -Math.random() * dur;
    const icon  = ICONS[Math.floor(Math.random() * ICONS.length)];
    wrap.style.cssText =
      'left:' + left + '%; ' +
      'width:' + size + 'px; height:' + size + 'px; ' +
      'animation-duration:' + dur + 's; ' +
      'animation-delay:' + delay + 's;';
    wrap.innerHTML = '<svg><use href="#' + icon + '"/></svg>';
    root.appendChild(wrap);
  }
})();

// ============================================
// 2) Password show/hide
// ============================================
(function(){
  const btn = document.getElementById('togglePwd');
  const inp = document.getElementById('password');
  const ico = document.getElementById('eyeIcon');
  if(!btn || !inp || !ico) return;
  btn.addEventListener('click', () => {
    const isPw = inp.type === 'password';
    inp.type = isPw ? 'text' : 'password';
    ico.className = isPw ? 'fa-regular fa-eye' : 'fa-regular fa-eye-slash';
  });
})();

// ============================================
// 3) Submit -> loading state (form submits natively)
// ============================================
(function(){
  const f = document.getElementById('loginForm');
  const b = document.getElementById('submitBtn');
  if(!f || !b) return;
  f.addEventListener('submit', () => {
    if(f.checkValidity()) b.classList.add('loading');
  });
})();

// ============================================
// 4) Toast helper
// ============================================
let toastTimer = null;
function showNotif(msg, isErr){
  const el = document.getElementById('toastNotif');
  if(!el) return;
  if(toastTimer) clearTimeout(toastTimer);
  el.textContent = msg;
  el.style.background = isErr ? 'rgba(240,68,56,.96)' : 'rgba(11,37,69,.96)';
  el.classList.add('show');
  toastTimer = setTimeout(() => el.classList.remove('show'), 2800);
}
</script>

</body>
</html>
