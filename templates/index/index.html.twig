/* ============================================
   RENDER PHARMACIES
   ============================================ */
function render(data){
  const grid = document.getElementById('phGrid');
  const noR  = document.getElementById('noRes');
  const smW  = document.getElementById('smWrap');
  grid.innerHTML = ''; noR.style.display = 'none';
  if(!data.length){
    noR.style.display = 'block'; smW.style.display = 'none';
    document.getElementById('srchCount').textContent = '0 résultat';
    return;
  }
  document.getElementById('srchCount').textContent = data.length + ' pharmacie' + (data.length > 1 ? 's' : '');
  data.forEach((ph, i) => {
    const card = document.createElement('div');
    card.className = 'ph-card' + (i >= 4 && !showAll ? ' hidden-card' : '');
    card.dataset.tilt = '';
    const fav = favs.has(ph.id);
    card.innerHTML = `
      <div class="ph-card-img">
        <img src="${ph.imgs[0]}" alt="${ph.name}" loading="lazy">
        <span class="ph-badge b-${ph.status}">${ph.label}</span>
        <button class="ph-fav${fav ? ' on' : ''}" onclick="toggleFav(event,${ph.id})" aria-label="Favoris">
          <i class="fa-${fav ? 'solid' : 'regular'} fa-heart"${fav ? ' style="color:var(--ERR)"' : ''}></i>
        </button>
      </div>
      <div class="ph-body">
        <div class="ph-name">${ph.name}</div>
        <div class="ph-loc"><i class="fa-solid fa-location-dot"></i>${ph.zone} · ${ph.dist}</div>
        <div class="ph-foot">
          <button class="ph-btn ph-btn-view" onclick="openModal(${ph.id})"><i class="fa-solid fa-eye"></i>Détails</button>
          <button class="ph-btn ph-btn-call" onclick="openCall(${ph.id})" aria-label="Appeler"><i class="fa-solid fa-phone"></i></button>
        </div>
      </div>`;
    grid.appendChild(card);
    setTimeout(() => card.classList.add('in'), 55 * i);
    attachTilt(card);
  });
  smW.style.display = (!showAll && data.length > 4) ? 'block' : 'none';
  document.getElementById('smBtn').innerHTML = showAll
    ? '<i class="fa-solid fa-chevron-up"></i>Afficher moins'
    : '<i class="fa-solid fa-th-large"></i>Voir toutes les pharmacies';
}

function filterPharma(){
  const q = document.getElementById('mainSearch').value.toLowerCase().trim();
  showAll = false;
  let data = PH;
  if(currentIsland !== 'all') data = data.filter(p => p.island === currentIsland);
  if(q) data = data.filter(p => p.name.toLowerCase().includes(q) || p.zone.toLowerCase().includes(q));
  render(data);
}

/* ============================================
   ISLAND FILTER — change the platform scope
   ============================================ */
function selectIsland(code){
  if(!ISLAND_LABELS[code]) return;
  currentIsland = code;

  // Toggle active button
  document.querySelectorAll('.island-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.island === code);
  });

  // Update pharmacy section title + subtitle
  const lbl = ISLAND_LABELS[code];
  const ttl = document.getElementById('phSecTitle');
  const sub = document.getElementById('phSecSub');
  if(ttl) ttl.textContent = lbl.title;
  if(sub) sub.textContent = code === 'all'
    ? "Toutes nos pharmacies partenaires, vérifiées et certifiées par l'Ordre des Pharmaciens des Comores"
    : `Pharmacies certifiées sur l'île de ${lbl.fr} — Capitale : ${lbl.capital}`;

  // Re-apply filter (clears search if it'd hide everything)
  filterPharma();

  // Smooth scroll to pharmacies
  goTo('pharmacies');

  // Toast feedback
  showToast('Filtre activé : ' + lbl.fr);

  // Persist choice in URL hash for shareability
  try { history.replaceState(null, '', '#ile=' + code); } catch(_){}
}

// Restore from URL hash on load (e.g. shared link)
(function initIslandFromHash(){
  const m = (location.hash || '').match(/#ile=(all|ngazidja|ndzwani|mwali)/);
  if(m){
    // defer so render() has run first
    setTimeout(() => selectIsland(m[1]), 50);
  }
})();
