      <button class="fs-call-btn" onclick="openCall(${ph.id})">
        <i class="fa-solid fa-phone-volume"></i>Appeler la pharmacie
      </button>
    </div>`;

  document.getElementById('fsModal').classList.add('open');
  document.body.style.overflow = 'hidden';
  startGal();

  // Place la gallery au bon endroit selon l'écran :
  //  - Desktop (>=641px) : DANS fs-modal-content -> elle scroll avec le contenu
  //  - Mobile  (<641px)  : EN DEHORS -> elle reste fixe en haut (comportement d'origine)
  placeGallery();

  const content = document.querySelector('.fs-modal-content');
  content.scrollTop = 0;
  content.onscroll = () => {
    const sb = document.getElementById('fsStickyBar');
    sb.classList.toggle('visible', content.scrollTop > 160);
  };
}

function placeGallery(){
  const gal = document.getElementById('fsGal');
  const wrapper = document.querySelector('.fs-modal-content');
  const stickyBar = document.getElementById('fsStickyBar');
  if(!gal || !wrapper || !stickyBar) return;
  const desktop = window.matchMedia('(min-width: 641px)').matches;
  if(desktop){
    // Insère la gallery comme premier enfant du wrapper scrollable
    if(gal.parentNode !== wrapper){
      wrapper.insertBefore(gal, wrapper.firstChild);
    }
  } else {
    // Remet la gallery juste avant fs-modal-content (sibling, comportement original)
    if(gal.parentNode === wrapper){
      stickyBar.parentNode.insertBefore(gal, wrapper);
    }
  }
}

// Réagit au resize si l'utilisateur passe PC <-> mobile pendant que le modal est ouvert
window.addEventListener('resize', () => {
  if(document.getElementById('fsModal').classList.contains('open')){
    placeGallery();
  }
});

function closeModal(){
  document.getElementById('fsModal').classList.remove('open');
  document.body.style.overflow = '';
  stopGal();
  const sb = document.getElementById('fsStickyBar');
  if(sb) sb.classList.remove('visible');
}

