  { id:4,name:"Pharmacie Salama",status:"open",label:"Ouverte", address:"Centre Commercial Coulée, Moroni",zone:"Coulée",dist:"1.4 km", phone:"+269 773 22 33",email:"salama@pharma.km",rating:4.4,reviews:96, lat:-11.7082,lng:43.2502, desc:"Pharmacie Salama au cœur du quartier Coulée. Cosmétique naturelle, compléments alimentaires et produits de parapharmacie sélectionnés. Ambiance chaleureuse, conseils bienveillants, accueil professionnel.", hours:[{d:"Lundi – Samedi",t:"09h00 – 19h30"},{d:"Dimanche",t:"Fermé"}], imgs:["https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=900&q=80","https://images.unsplash.com/photo-1563213126-a4273aed2016?w=900&q=80"] },
  { id:5,name:"Pharmacie Ibn Sina",status:"open",label:"Ouverte", address:"Rue des Djins, Badjanani, Moroni",zone:"Badjanani",dist:"1.8 km", phone:"+269 773 44 55",email:"ibnsina@pharma.km",rating:4.9,reviews:428, lat:-11.7050,lng:43.2570, desc:"Référence en phytothérapie et médecine traditionnelle complémentaire aux Comores. Pharmaciens chercheurs passionnés, produits locaux et importés de qualité premium. Conseil expert pour les traitements naturels.", hours:[{d:"Lundi – Vendredi",t:"07h00 – 21h00"},{d:"Samedi",t:"08h00 – 20h00"},{d:"Dimanche",t:"10h00 – 14h00"}], imgs:["https://images.unsplash.com/photo-1563213126-a4273aed2016?w=900&q=80","https://images.unsplash.com/photo-1626863905121-3b0c0ed7b94a?w=900&q=80"] },
  { id:6,name:"Pharmacie Hilal",status:"closed",label:"Fermée", address:"Quartier Magudju, Moroni",zone:"Magudju",dist:"2.2 km", phone:"+269 773 66 77",email:"hilal@pharma.km",rating:4.2,reviews:53, lat:-11.7100,lng:43.2470, desc:"Pharmacie Hilal au service du quartier Magudju. Médicaments génériques, produits d'hygiène et articles de puériculture. Équipe accueillante et tarifs accessibles. Réouverture demain à 08h00.", hours:[{d:"Lundi – Samedi",t:"08h00 – 18h00"},{d:"Dimanche",t:"Fermé"}], imgs:["https://images.unsplash.com/photo-1580281780460-82d277b0e3f8?w=900&q=80"] },
  { id:7,name:"Pharmacie Tropicale",status:"open",label:"Ouverte", address:"Rue du Port, Volo-Volo, Moroni",zone:"Volo-Volo",dist:"2.7 km", phone:"+269 773 88 99",email:"tropical@pharma.km",rating:4.7,reviews:201, lat:-11.6990,lng:43.2620, desc:"Spécialiste en pathologies tropicales et vaccins de voyage. Partenaire officiel du Centre de Médecine du Voyage de Moroni. Anti-paludéens en stock permanent, traitements prophylactiques certifiés.", hours:[{d:"Lundi – Vendredi",t:"08h00 – 19h00"},{d:"Samedi",t:"09h00 – 17h00"},{d:"Dimanche",t:"Sur RDV"}], imgs:["https://images.unsplash.com/photo-1626863905121-3b0c0ed7b94a?w=900&q=80","https://images.unsplash.com/photo-1587854692152-cbe660dbde88?w=900&q=80"] },
  { id:8,name:"Pharmacie Nour",status:"open",label:"Ouverte", address:"Cité des Orangers, Hamramba, Moroni",zone:"Hamramba",dist:"3.3 km", phone:"+269 773 11 22",email:"nour@pharma.km",rating:4.5,reviews:118, lat:-11.7140,lng:43.2530, desc:"Pharmacie Nour, votre pharmacie de quartier à Hamramba. Livraison rapide sous 30 minutes dans le quartier. Produits naturels, cosmétique bio et articles de maternité soigneusement sélectionnés.", hours:[{d:"Lundi – Samedi",t:"08h30 – 19h30"},{d:"Dimanche",t:"09h00 – 12h00"}], imgs:["https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=900&q=80","https://images.unsplash.com/photo-1580281780460-82d277b0e3f8?w=900&q=80"] }
];

let showAll = false, favs = new Set(), curImgs = [], curIdx = 0, galTimer = null, curPh = null;
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ============================================
   RENDER / FILTER
   ============================================ */
function render(data){
  const grid = document.getElementById('phGrid');
  const noR  = document.getElementById('noRes');
  const smW  = document.getElementById('smWrap');
  grid.innerHTML = ''; noR.style.display = 'none';
  if(!data.length){
    noR.style.display = 'block'; smW.style.display = 'none';
    document.getElementById('srchCount').textContent = '0 résultat';
    return;
  }
  document.getElementById('srchCount').textContent = data.length + ' pharmacie' + (data.length > 1 ? 's' : '');
  data.forEach((ph, i) => {
    const card = document.createElement('div');
    card.className = 'ph-card' + (i >= 4 && !showAll ? ' hidden-card' : '');
    card.dataset.tilt = '';
    const fav = favs.has(ph.id);
    card.innerHTML = `
      <div class="ph-card-img">
        <img src="${ph.imgs[0]}" alt="${ph.name}" loading="lazy">
        <span class="ph-badge b-${ph.status}">${ph.label}</span>
        <button class="ph-fav${fav ? ' on' : ''}" onclick="toggleFav(event,${ph.id})" aria-label="Favoris">
          <i class="fa-${fav ? 'solid' : 'regular'} fa-heart"${fav ? ' style="color:var(--danger)"' : ''}></i>
        </button>
      </div>
      <div class="ph-body">
        <div class="ph-name">${ph.name}</div>
        <div class="ph-loc"><i class="fa-solid fa-location-dot"></i>${ph.zone} · ${ph.dist}</div>
        <div class="ph-foot">
          <button class="ph-btn ph-btn-view" onclick="openModal(${ph.id})"><i class="fa-solid fa-eye"></i>Détails</button>
          <button class="ph-btn ph-btn-call" onclick="openCall(${ph.id})" aria-label="Appeler"><i class="fa-solid fa-phone"></i></button>
        </div>
      </div>`;
    grid.appendChild(card);
    setTimeout(() => card.classList.add('in'), 60 * i);
    attachTilt(card);
  });
  smW.style.display = (!showAll && data.length > 4) ? 'block' : 'none';
  document.getElementById('smBtn').innerHTML = showAll
    ? '<i class="fa-solid fa-chevron-up"></i>Afficher moins'
    : '<i class="fa-solid fa-th-large"></i>Voir toutes les pharmacies';
}

function filterPharma(){
  const q = document.getElementById('mainSearch').value.toLowerCase().trim();
  showAll = false;
  render(q ? PH.filter(p => p.name.toLowerCase().includes(q) || p.zone.toLowerCase().includes(q)) : PH);
}
function heroSearch(){
  const q = document.getElementById('heroInput').value.trim();
  if(!q) return;
  document.getElementById('mainSearch').value = q;
  goTo('pharmacies');
  setTimeout(filterPharma, 500);
}
document.getElementById('heroInput').addEventListener('keydown', e => { if(e.key === 'Enter') heroSearch(); });
document.getElementById('mainSearch').addEventListener('keydown', e => { if(e.key === 'Enter') filterPharma(); });
function toggleAll(){ showAll = !showAll; render(PH); if(showAll) goTo('pharmacies'); }
function toggleFav(e, id){
  e.stopPropagation();
  if(favs.has(id)){ favs.delete(id); showToast('Retiré des favoris'); }
  else { favs.add(id); showToast('Ajouté aux favoris'); }
  filterPharma();
}

/* ============================================
   MODAL
   ============================================ */
function openModal(id){
  const ph = PH.find(p => p.id === id);
  if(!ph) return;
  curPh = ph; curImgs = ph.imgs; curIdx = 0;

  document.getElementById('fsTopTitle').textContent = ph.name;
  document.getElementById('fsStickyName').textContent = ph.name;
  const stickyStatusEl = document.getElementById('fsStickyStatus');
  stickyStatusEl.textContent = ph.label;
  stickyStatusEl.className = 'fs-sticky-status b-' + ph.status;

  const img = document.getElementById('fsGalImg');
  img.src = ph.imgs[0]; img.style.opacity = '1';
  if(!reduceMotion){ img.classList.remove('kenburns'); requestAnimationFrame(() => img.classList.add('kenburns')); }
  const badge = document.getElementById('fsBadge');
  badge.textContent = ph.label;
  badge.className = 'fs-badge b-' + ph.status;
  buildDots();

  const bbox = `${ph.lng - .014},${ph.lat - .009},${ph.lng + .014},${ph.lat + .009}`;
  const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${ph.lat},${ph.lng}`;
  const hHtml = ph.hours.map(h => `<div class="fs-hr"><span class="fs-hr-day">${h.d}</span><span class="${h.t === 'Fermé' ? 'fs-hr-closed' : 'fs-hr-time'}">${h.t}</span></div>`).join('');

  document.getElementById('fsContent').innerHTML = `
    <div class="fs-body">
      <div class="fs-ph-header">
        <div>
          <div class="fs-ph-name">${ph.name}</div>
        </div>
      </div>
      <p class="fs-desc">${ph.desc}</p>
      <div class="fs-info-grid">
        <div class="fs-info-blk"><div class="fs-info-lbl"><i class="fa-solid fa-location-dot"></i>Adresse</div><div class="fs-info-val">${ph.address}</div></div>
        <div class="fs-info-blk"><div class="fs-info-lbl"><i class="fa-solid fa-route"></i>Distance</div><div class="fs-info-val">${ph.dist}</div></div>
        <div class="fs-info-blk"><div class="fs-info-lbl"><i class="fa-solid fa-phone"></i>Téléphone</div><div class="fs-info-val"><a href="tel:${ph.phone}">${ph.phone}</a></div></div>
        <div class="fs-info-blk"><div class="fs-info-lbl"><i class="fa-solid fa-envelope"></i>Email</div><div class="fs-info-val"><a href="mailto:${ph.email}">${ph.email}</a></div></div>
      </div>
      <div class="fs-sec-title"><i class="fa-solid fa-clock"></i>Horaires d'ouverture</div>
      <div class="fs-hours">${hHtml}</div>
      <div class="fs-sec-title"><i class="fa-solid fa-map-location-dot"></i>Position sur la carte</div>
      <div class="fs-map">
        <iframe src="${mapSrc}" title="Carte ${ph.name}" loading="lazy"></iframe>
        <button class="fs-map-fs-btn" onclick="openMapFs('${ph.name.replace(/'/g, "\\'")}','${mapSrc}')">
          <i class="fa-solid fa-expand"></i>Plein écran
        </button>
      </div>
      <button class="fs-call-btn" onclick="openCall(${ph.id})">
        <i class="fa-solid fa-phone-volume"></i>Appeler la pharmacie
      </button>
    </div>`;

  document.getElementById('fsModal').classList.add('open');
  document.body.style.overflow = 'hidden';
  startGal();

  const content = document.getElementById('fsModalContent') || document.querySelector('.fs-modal-content');
  content.scrollTop = 0;
  content.onscroll = () => {
    const sb = document.getElementById('fsStickyBar');
    sb.classList.toggle('visible', content.scrollTop > 160);
  };
}

function closeModal(){
  document.getElementById('fsModal').classList.remove('open');
  document.body.style.overflow = '';
  stopGal();
  const sb = document.getElementById('fsStickyBar');
  if(sb) sb.classList.remove('visible');
}

/* ============================================
   LIGHTBOX
   ============================================ */
let lbImgs = [], lbIdx = 0;
function openLightbox(startIdx){
  lbImgs = curImgs; lbIdx = startIdx || 0;
  updateLb();
  document.getElementById('lbThumbs').innerHTML = lbImgs.map((src, i) =>
    `<div class="lightbox-thumb${i === lbIdx ? ' active' : ''}" onclick="lbGo(${i})"><img src="${src}" alt=""></div>`).join('');
  document.getElementById('lightbox').classList.add('open');
}
function closeLightbox(){ document.getElementById('lightbox').classList.remove('open'); }
function lbGo(i){ lbIdx = i; updateLb(); }
function lbMove(dir){ lbIdx = (lbIdx + dir + lbImgs.length) % lbImgs.length; updateLb(); }
function updateLb(){
  const img = document.getElementById('lbImg');
  img.style.opacity = '0';
  setTimeout(() => { img.src = lbImgs[lbIdx]; img.style.opacity = '1'; }, 150);
  document.getElementById('lbCounter').textContent = (lbIdx + 1) + ' / ' + lbImgs.length;
  document.querySelectorAll('.lightbox-thumb').forEach((t, i) => t.classList.toggle('active', i === lbIdx));
}
document.getElementById('lightbox').addEventListener('click', e => {
  if(e.target === document.getElementById('lightbox')) closeLightbox();
});
document.getElementById('lbImg').style.transition = 'opacity .2s';

document.addEventListener('keydown', e => {
  if(e.key === 'Escape'){
    if(document.getElementById('lightbox').classList.contains('open')) closeLightbox();
    else closeModal();
  }
  if(document.getElementById('lightbox').classList.contains('open')){
    if(e.key === 'ArrowLeft') lbMove(-1);
    if(e.key === 'ArrowRight') lbMove(1);
  }
});

/* ============================================
   GALLERY
   ============================================ */
function buildDots(){
  document.getElementById('fsDots').innerHTML = curImgs.map((_, i) => `<button class="fs-dot${i === 0 ? ' on' : ''}" onclick="galMove(0,${i})" aria-label="Image ${i + 1}"></button>`).join('');
}
function setGalImg(){
  const img = document.getElementById('fsGalImg');
  img.style.opacity = '0';
  img.classList.remove('kenburns');
  setTimeout(() => {
    img.src = curImgs[curIdx];
    img.style.opacity = '1';
    if(!reduceMotion) requestAnimationFrame(() => img.classList.add('kenburns'));
  }, 200);
  document.querySelectorAll('.fs-dot').forEach((d, i) => d.classList.toggle('on', i === curIdx));
}
function galMove(dir, forceTo){
  if(forceTo !== undefined){ curIdx = forceTo; }
  else { curIdx = (curIdx + dir + curImgs.length) % curImgs.length; }
  setGalImg(); stopGal(); if(curImgs.length > 1) startGal();
}
function startGal(){ stopGal(); if(curImgs.length > 1 && !reduceMotion) galTimer = setInterval(() => galMove(1), 4500); }
function stopGal(){ clearInterval(galTimer); galTimer = null; }

/* ============================================
   MAP FS
   ============================================ */
function openMapFs(name, src){
  document.getElementById('mapFsTitle').textContent = name;
  document.getElementById('mapFsIframe').src = src;
  document.getElementById('mapFs').classList.add('open');
}
function closeMapFs(){
  document.getElementById('mapFs').classList.remove('open');
  document.getElementById('mapFsIframe').src = '';
}

/* ============================================
   CALL
   ============================================ */
function openCall(id){
  const ph = PH.find(p => p.id === id);
  if(!ph) return;
  document.getElementById('callName').textContent = ph.name;
  document.getElementById('callNum').textContent = ph.phone;
  document.getElementById('callOkBtn').onclick = () => { window.location.href = 'tel:' + ph.phone; closeCall(); };
  document.getElementById('callOverlay').classList.add('open');
}
function handleCallOvl(e){ if(e.target === document.getElementById('callOverlay')) closeCall(); }
function closeCall(){ document.getElementById('callOverlay').classList.remove('open'); }

/* ============================================
   TOAST
   ============================================ */
function showToast(msg){
  const t = document.getElementById('toastEl');
  t.textContent = msg; t.classList.add('on');
  clearTimeout(t._t); t._t = setTimeout(() => t.classList.remove('on'), 2800);
}

/* ============================================
   SCROLL HELPERS & PROGRESS
   ============================================ */
function goTo(id){
  const el = document.getElementById(id);
  if(el) el.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
}
const scrollProgress = document.getElementById('scrollProgress');
function updateProgress(){
  const h = document.documentElement;
  const max = h.scrollHeight - h.clientHeight;
  const p = max > 0 ? (h.scrollTop / max) * 100 : 0;
  scrollProgress.style.setProperty('--p', p.toFixed(1) + '%');
  const deskNav = document.querySelector('.desk-nav');
  if(deskNav) deskNav.classList.toggle('scrolled', scrollY > 50);
}
window.addEventListener('scroll', updateProgress, { passive: true });
updateProgress();

/* ============================================
   REVEAL OBSERVER
   ============================================ */
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(e.isIntersecting){
      e.target.classList.add('in');
      obs.unobserve(e.target);
    }
  });
}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.rev, .rev-l, .rev-r').forEach(el => obs.observe(el));

/* ============================================
   KPI COUNTER (count-up on view)
   ============================================ */
const counterObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(!e.isIntersecting) return;
    const el = e.target;
    counterObs.unobserve(el);
    if(reduceMotion){ el.textContent = (el.dataset.prefix || '') + el.dataset.count + (el.dataset.suffix || ''); return; }
    const target = parseInt(el.dataset.count, 10);
    const dur = 1200;
    const start = performance.now();
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    function frame(now){
      const t = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = prefix + Math.round(target * eased) + suffix;
      if(t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  });
}, { threshold: 0.5 });
document.querySelectorAll('[data-count]').forEach(el => counterObs.observe(el));

/* ============================================
   3D TILT on cards (mouse)
   ============================================ */
function attachTilt(el){
  if(reduceMotion || matchMedia('(hover: none)').matches) return;
  let raf = 0;
  el.addEventListener('mousemove', ev => {
    const r = el.getBoundingClientRect();
    const x = (ev.clientX - r.left) / r.width  - 0.5;
    const y = (ev.clientY - r.top)  / r.height - 0.5;
    if(raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      el.style.transform = `perspective(900px) rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg) translateY(-4px)`;
    });
  });
  el.addEventListener('mouseleave', () => {
    if(raf) cancelAnimationFrame(raf);
    el.style.transform = '';
  });
}
document.querySelectorAll('[data-tilt]').forEach(attachTilt);

/* ============================================
   MAGNETIC BUTTONS
   ============================================ */
if(!reduceMotion && !matchMedia('(hover: none)').matches){
  document.querySelectorAll('[data-magnetic]').forEach(btn => {
    btn.addEventListener('mousemove', ev => {
      const r = btn.getBoundingClientRect();
      const x = (ev.clientX - r.left - r.width / 2)  * 0.18;
      const y = (ev.clientY - r.top  - r.height / 2) * 0.22;
      btn.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
    });
    btn.addEventListener('mouseleave', () => { btn.style.transform = ''; });
  });
}

/* ============================================
   INIT
   ============================================ */
render(PH);
</script>
</body>
</html>
