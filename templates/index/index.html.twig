{# templates/index/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Locapharma — La Santé à Portée de Main</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
/* ============================================
   VARIABLES & BASE
   ============================================ */
:root {
  --G: #0E7C66; --GD: #0a5e4d; --GL: #e1f5ee; --GXL: #f0faf7;
  --B: #0B2545; --BD: #061632; --BM: #1a3a6e; --BL: #eef2f8;
  --GOLD: #F4C430; --GOLD-D: #d9a90f;
  --T: #1D2939; --MUT: #667085; --LT: #F2F4F7; --BDR: #E4E7EC;
  --W: #fff; --ERR: #F04438; --OK: #12B76A;
  --NAV: 68px; --BOT: 72px;
  --shadow: 0 2px 16px rgba(11,37,69,.07);
  --shadow-md: 0 8px 32px rgba(11,37,69,.13);
  --shadow-lg: 0 24px 64px rgba(11,37,69,.2);
  --shadow-glow: 0 18px 44px -12px rgba(14,124,102,.55);
  --shadow-gold: 0 18px 44px -12px rgba(244,196,48,.6);

  --ease-out: cubic-bezier(.22, 1, .36, 1);
  --ease-spring: cubic-bezier(.34, 1.56, .64, 1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;overscroll-behavior-y:contain}
body{
  font-family:'Manrope',sans-serif;color:var(--T);background:var(--W);
  overflow-x:hidden;padding-top:var(--NAV);
  -webkit-overflow-scrolling:touch;
  text-rendering:optimizeLegibility;
  -webkit-font-smoothing:antialiased;
}
body{overscroll-behavior-y:auto}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--LT)}
::-webkit-scrollbar-thumb{background:var(--G);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--GD)}
img{display:block;max-width:100%}
a{text-decoration:none;color:inherit}
:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(14,124,102,.4),0 0 0 5px rgba(14,124,102,.15);border-radius:8px}

/* Scroll progress */
.scroll-progress{position:fixed;top:0;left:0;right:0;height:3px;background:transparent;z-index:9999;pointer-events:none}
.scroll-progress::before{
  content:'';display:block;height:100%;width:var(--p,0%);
  background:linear-gradient(90deg,var(--G) 0%,var(--GOLD) 100%);
  transition:width .08s linear;
  box-shadow:0 0 14px rgba(14,124,102,.6);
}

/* ============================================
   BRAND WORDMARK
   ============================================ */
.brand-mark{font-family:'Plus Jakarta Sans',sans-serif;font-weight:900;font-size:24px;line-height:1;letter-spacing:-.5px;display:flex;align-items:center;gap:0}
.brand-mark .loca{color:var(--B)}
.brand-mark .pharma{color:var(--G)}
.brand-mark.sm{font-size:20px}
.brand-mark.lg{font-size:32px}

/* ============================================
   HERO — bg image subtle + mesh + grid
   ============================================ */
.hero{
  position:relative;overflow:hidden;
  min-height:calc(100vh - var(--NAV));
  display:flex;align-items:center;
  background:#0B2545;
  isolation:isolate;
}
.hero-bg{
  position:absolute;inset:0;z-index:0;
  background:url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=2000&q=85') center/cover no-repeat;
  filter:blur(2px) brightness(.28) saturate(1.15) contrast(1.05);
  transform:scale(1.05);
  animation:bgPan 30s ease-in-out infinite alternate;
}
@keyframes bgPan{
  from{transform:scale(1.05) translate3d(-1%,0,0)}
  to  {transform:scale(1.08) translate3d(1%, -1%,0)}
}
.hero-overlay{
  position:absolute;inset:0;z-index:0;
  background:
    radial-gradient(80% 60% at 100% 0%, rgba(14,124,102,.42) 0%, transparent 60%),
    radial-gradient(70% 60% at 0% 100%, rgba(244,196,48,.18) 0%, transparent 60%),
    linear-gradient(145deg, rgba(11,37,69,.86) 0%, rgba(11,37,69,.78) 55%, rgba(6,22,50,.92) 100%);
}
.hero-mesh{
  position:absolute;inset:-10%;z-index:0;
  background:
    radial-gradient(40% 35% at 20% 30%, rgba(14,124,102,.5) 0%, transparent 60%),
    radial-gradient(30% 30% at 80% 20%, rgba(244,196,48,.28) 0%, transparent 60%),
    radial-gradient(45% 40% at 70% 85%, rgba(26,58,110,.55) 0%, transparent 60%);
  filter:blur(40px);
  animation:meshFloat 16s ease-in-out infinite alternate;
  mix-blend-mode:screen;
  opacity:.85;
}
@keyframes meshFloat{
  0%   {transform:translate3d(0,0,0) scale(1)}
  50%  {transform:translate3d(-2%, 1%,0) scale(1.04)}
  100% {transform:translate3d(2%,-1%,0) scale(1.02)}
}
.hero-dots{
  position:absolute;inset:0;z-index:0;
  background-image:radial-gradient(circle,rgba(255,255,255,.07) 1px,transparent 1px);
  background-size:32px 32px;
  animation:dotsMove 35s linear infinite;
  mask-image:radial-gradient(ellipse at center, black 30%, transparent 80%);
  -webkit-mask-image:radial-gradient(ellipse at center, black 30%, transparent 80%);
}
@keyframes dotsMove{0%{background-position:0 0}100%{background-position:32px 32px}}

/* Medical cross SVG accent */
.hero-cross{
  position:absolute;z-index:0;opacity:.06;color:#fff;pointer-events:none;
  animation:crossSpin 90s linear infinite;
}
.hero-cross-1{width:340px;height:340px;top:8%;right:6%}
.hero-cross-2{width:200px;height:200px;bottom:10%;left:3%;animation-direction:reverse;animation-duration:120s}
@keyframes crossSpin{from{transform:rotate(0)}to{transform:rotate(360deg)}}

.hero-ring{position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.07);animation:ringPulse 6s ease-in-out infinite}
.ring-1{width:600px;height:600px;top:-200px;right:-150px;animation-delay:0s}
.ring-2{width:400px;height:400px;top:-100px;right:-50px;animation-delay:1.5s;border-color:rgba(14,124,102,.18)}
.ring-3{width:800px;height:800px;bottom:-400px;left:-200px;animation-delay:3s}
.ring-4{width:300px;height:300px;bottom:-50px;left:30%;animation-delay:1s;border-color:rgba(244,196,48,.12)}
@keyframes ringPulse{0%,100%{transform:scale(1);opacity:.6}50%{transform:scale(1.04);opacity:1}}

.hero-shape{position:absolute;border-radius:50%;filter:blur(70px);animation:shapeDrift 9s ease-in-out infinite alternate;z-index:0}
.shape-1{width:450px;height:450px;background:rgba(14,124,102,.22);top:-60px;right:-80px}
.shape-2{width:350px;height:350px;background:rgba(244,196,48,.12);bottom:-100px;left:5%;animation-delay:3s}
.shape-3{width:250px;height:250px;background:rgba(11,37,69,.35);top:40%;right:20%;animation-delay:5s}
@keyframes shapeDrift{from{transform:translate(0,0) scale(1)}to{transform:translate(24px,18px) scale(1.06)}}

.hero{min-height:calc(100svh - var(--NAV))}
.hero-inner{
  position:relative;z-index:1;max-width:1280px;margin:0 auto;width:100%;
  display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,3vw,44px);align-items:center;
  padding:clamp(20px,4vh,52px) 5%;
}
@media(max-width:1024px){
  .hero-inner{grid-template-columns:1fr;gap:24px;padding:clamp(20px,4vh,44px) 5%}
  .hero-h1{font-size:clamp(26px,4.5vw,44px) !important}
  .hero-card{max-width:560px;margin:0 auto}
}
@media(max-width:640px){
  .hero{min-height:auto}
  .hero-inner{padding:16px 4% 22px;display:flex;flex-direction:column;width:100%;gap:18px}
  .hero-eyebrow{margin-bottom:8px;padding:4px 11px;font-size:10px}
  .hero-h1{font-size:22px !important;line-height:1.1;margin-bottom:6px}
  .hero-sub{font-size:13px;line-height:1.55;margin-bottom:12px;max-width:none}
  .hero-ctas{gap:8px;flex-direction:column;align-items:stretch;margin-bottom:14px}
  .hero-ctas .btn{width:100%;justify-content:center;padding:10px 16px;font-size:13px}
  .hero-kpis{gap:14px;margin-top:0;justify-content:space-between}
  .kpi-n{font-size:18px}
  .kpi-l{font-size:9px;margin-top:3px}
  .kpi-sep{display:none}
  .hero-card{display:block;width:100%;margin:0;padding:16px}
  .quick-grid{grid-template-columns:1fr 1fr;gap:7px}
  .hero-cross-1,.hero-cross-2{display:none}
}
@media(max-width:380px){
  .hero-h1{font-size:20px !important}
  .hero-sub{font-size:12px;margin-bottom:10px}
  .hero-card{padding:14px}
}

.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;margin-bottom:24px;
  background:rgba(255,255,255,.1);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.2);border-radius:100px;
  padding:7px 18px;color:rgba(255,255,255,.92);font-size:12px;font-weight:800;
  letter-spacing:.07em;text-transform:uppercase;animation:fadeUp .6s var(--ease-out) both;
}
.live-dot{width:8px;height:8px;background:var(--GOLD);border-radius:50%;flex-shrink:0;position:relative}
.live-dot::after{content:'';position:absolute;inset:0;border-radius:50%;background:var(--GOLD);animation:pingRing 1.8s cubic-bezier(0,0,.2,1) infinite}
@keyframes pingRing{0%{transform:scale(1);opacity:.9}100%{transform:scale(3.2);opacity:0}}

.hero-h1{
  font-size:clamp(28px,3.6vw,50px);font-weight:900;line-height:1.06;
  color:white;margin-bottom:14px;font-family:'Plus Jakarta Sans',sans-serif;
  letter-spacing:-.02em;
}
.hero-h1 .word{display:inline-block;opacity:0;transform:translateY(20px);animation:wordIn .7s var(--ease-out) forwards}
.hero-h1 .word:nth-child(1){animation-delay:.05s}
.hero-h1 .word:nth-child(2){animation-delay:.12s}
.hero-h1 .word:nth-child(3){animation-delay:.19s}
.hero-h1 .word:nth-child(4){animation-delay:.26s}
.hero-h1 .word:nth-child(5){animation-delay:.33s}
.hero-h1 .word:nth-child(6){animation-delay:.40s}
.hero-h1 .word:nth-child(7){animation-delay:.47s}
.hero-h1 .word:nth-child(8){animation-delay:.54s}
@keyframes wordIn{to{opacity:1;transform:translateY(0)}}
.hero-h1 .gold{
  background:linear-gradient(120deg,#FCD34D 0%,var(--GOLD) 50%,#FBBF24 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  position:relative;display:inline-block;
  background-size:200% 100%;
  animation:goldShimmer 5s linear infinite;
}
@keyframes goldShimmer{0%{background-position:0% 0%}100%{background-position:200% 0%}}
.hero-h1 .gold::after{
  content:'';position:absolute;left:0;right:0;bottom:-6px;height:4px;border-radius:4px;
  background:linear-gradient(90deg,transparent,var(--GOLD),transparent);
  opacity:0;transform:scaleX(0);transform-origin:left;
  animation:underlineDraw 1.2s .8s var(--ease-out) forwards;
}
@keyframes underlineDraw{to{opacity:1;transform:scaleX(1)}}

.hero-sub{
  font-size:clamp(13px,1.05vw,15px);color:rgba(255,255,255,.78);line-height:1.6;
  margin-bottom:22px;max-width:480px;animation:fadeUp .7s var(--ease-out) .5s both;font-weight:500;
}
.hero-ctas{display:flex;gap:10px;flex-wrap:wrap;animation:fadeUp .7s var(--ease-out) .65s both}
.hero-kpis{display:flex;gap:clamp(14px,1.5vw,24px);flex-wrap:wrap;margin-top:clamp(20px,3vh,32px);animation:fadeUp .7s var(--ease-out) .85s both}
.kpi{text-align:center}
.kpi-n{font-size:clamp(22px,2vw,28px);font-weight:900;color:var(--GOLD);font-family:'Plus Jakarta Sans',sans-serif;line-height:1;display:inline-block}
.kpi-l{font-size:10px;color:rgba(255,255,255,.65);font-weight:600;margin-top:5px;letter-spacing:.05em;text-transform:uppercase}
.kpi-sep{width:1px;height:32px;background:linear-gradient(180deg,transparent,rgba(255,255,255,.25),transparent);align-self:center}

.hero-card{
  background:rgba(255,255,255,.09);backdrop-filter:blur(32px);-webkit-backdrop-filter:blur(32px);
  border:1px solid rgba(255,255,255,.17);border-radius:18px;
  padding:18px 18px;animation:fadeRight .8s var(--ease-out) .25s both;
  box-shadow:0 30px 60px -20px rgba(0,0,0,.45);
}
.hero-card-ttl{font-size:13px;font-weight:800;color:white;margin-bottom:10px;font-family:'Plus Jakarta Sans',sans-serif;display:flex;align-items:center;gap:8px}

/* ============================================
   ISLAND FILTER BUTTONS (hero card)
   ============================================ */
.island-filters{
  display:grid;grid-template-columns:repeat(4,1fr);gap:6px;
  margin-bottom:14px;padding:5px;
  background:rgba(0,0,0,.22);border-radius:12px;border:1px solid rgba(255,255,255,.08);
}
.island-btn{
  position:relative;padding:8px 6px;border-radius:8px;border:none;cursor:pointer;
  background:transparent;color:rgba(255,255,255,.78);
  font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;
  font-size:11px;letter-spacing:.02em;
  transition:background .25s,color .25s,transform .2s var(--ease-spring);
  display:flex;flex-direction:column;align-items:center;gap:2px;line-height:1.1;
  min-height:42px;justify-content:center;
}
.island-btn small{font-size:9px;font-weight:600;opacity:.65;letter-spacing:.03em;text-transform:uppercase}
.island-btn:hover{background:rgba(255,255,255,.08);color:white}
.island-btn.active{
  background:linear-gradient(135deg,var(--GOLD) 0%,var(--GOLD-D) 100%);
  color:var(--B);
  box-shadow:0 4px 14px rgba(244,196,48,.4);
  transform:translateY(-1px);
}
.island-btn.active small{opacity:.7}
.island-btn .dot{
  position:absolute;top:5px;right:6px;width:5px;height:5px;border-radius:50%;
  background:var(--GOLD);box-shadow:0 0 0 2px rgba(244,196,48,.2);
  opacity:0;transition:opacity .25s;
}
.island-btn.active .dot{display:none}
.hero-search-bar{display:flex;background:white;border-radius:11px;overflow:hidden;margin-bottom:16px;box-shadow:0 4px 24px rgba(11,37,69,.25);transition:box-shadow .25s}
.hero-search-bar:focus-within{box-shadow:0 0 0 3px rgba(244,196,48,.4),0 4px 24px rgba(11,37,69,.25)}
.hero-search-bar input{flex:1;border:none;outline:none;padding:13px 14px;font-size:14px;color:var(--T);font-family:'Manrope',sans-serif;background:transparent;min-width:0}
.hero-search-bar button{background:var(--G);color:white;border:none;padding:0 20px;font-size:14px;font-weight:800;font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;transition:.2s;flex-shrink:0}
.hero-search-bar button:hover{background:var(--GD)}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:14px}
.quick-tile{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14);border-radius:12px;padding:11px 12px;color:white;cursor:pointer;transition:.25s var(--ease-out);text-decoration:none}
.quick-tile:hover{background:rgba(255,255,255,.17);transform:translateY(-2px);border-color:rgba(255,255,255,.3)}
.quick-tile-ico{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;transition:transform .25s var(--ease-spring)}
.quick-tile:hover .quick-tile-ico{transform:scale(1.1) rotate(-4deg)}
.quick-tile-txt strong{display:block;font-size:12px;font-weight:800;font-family:'Plus Jakarta Sans',sans-serif}
.quick-tile-txt span{font-size:10px;opacity:.6;font-weight:500}
.hero-live{display:flex;align-items:center;gap:10px;background:rgba(18,183,106,.13);border:1px solid rgba(18,183,106,.28);border-radius:11px;padding:11px 13px}
.av-dot{width:9px;height:9px;background:var(--OK);border-radius:50%;flex-shrink:0;position:relative;box-shadow:0 0 0 4px rgba(18,183,106,.22)}
.av-dot::after{content:'';position:absolute;inset:0;border-radius:50%;background:var(--OK);animation:pingRing 2s cubic-bezier(0,0,.2,1) infinite}
.av-txt{font-size:12px;color:rgba(255,255,255,.85);font-weight:600}

@keyframes fadeUp{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeRight{from{opacity:0;transform:translateX(32px)}to{opacity:1;transform:translateX(0)}}

/* ============================================
   SEARCH STICKY
   ============================================ */
.srch-bar{
  padding:22px 5%;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid var(--BDR);
  position:sticky;top:var(--NAV);z-index:100;box-shadow:0 2px 12px rgba(11,37,69,.05);
}
.srch-inner{max-width:1280px;margin:0 auto;display:flex;gap:12px;align-items:center}
.srch-field{flex:1;display:flex;align-items:center;gap:10px;background:var(--LT);border:1.5px solid var(--BDR);border-radius:10px;padding:11px 15px;transition:.25s}
.srch-field:focus-within{border-color:var(--G);background:white;box-shadow:0 0 0 4px rgba(14,124,102,.12)}
.srch-field i{color:var(--MUT);font-size:15px;flex-shrink:0}
.srch-field input{flex:1;border:none;outline:none;font-size:14px;color:var(--T);background:transparent;font-family:'Manrope',sans-serif;min-width:0}
.srch-field input::placeholder{color:var(--MUT)}
.srch-count{font-size:13px;color:var(--MUT);font-weight:700;white-space:nowrap;flex-shrink:0}

/* ============================================
   SECTION COMMON
   ============================================ */
section{padding:72px 5%;position:relative}
.ctr{max-width:1280px;margin:0 auto}
.sec-hdr{margin-bottom:48px}
.sec-hdr.center{text-align:center}
.sec-hdr.center .sec-sub{margin:0 auto}
.sec-tag{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--GL);color:var(--G);border-radius:100px;padding:6px 16px;
  font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;
  border:1px solid rgba(14,124,102,.15);
}
.sec-tag::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--G);box-shadow:0 0 0 3px rgba(14,124,102,.18)}
.sec-ttl{font-size:clamp(26px,3.5vw,42px);font-weight:900;color:var(--B);line-height:1.12;margin-bottom:12px;font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em}
.sec-sub{font-size:15px;color:var(--MUT);line-height:1.76;max-width:580px}

/* ============================================
   PHARMACY GRID
   ============================================ */
.ph-section{background:linear-gradient(180deg,var(--LT) 0%,#fafbfc 100%)}
.ph-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1280px;margin:0 auto}
.ph-card{
  background:white;border-radius:16px;overflow:hidden;
  box-shadow:var(--shadow);
  transition:transform .4s var(--ease-out), box-shadow .4s var(--ease-out);
  opacity:0;transform:translateY(22px);
  will-change:transform,opacity;
  border:1px solid var(--BDR);
  position:relative;
  transform-style:preserve-3d;
}
.ph-card.in{opacity:1;transform:translateY(0)}
.ph-card:hover{box-shadow:var(--shadow-md)}
.ph-card-img{position:relative;height:188px;overflow:hidden;background:var(--LT)}
.ph-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease-out),filter .4s}
.ph-card:hover .ph-card-img img{transform:scale(1.08);filter:saturate(1.08)}
.ph-card-img::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(11,37,69,.35) 100%);pointer-events:none}
.ph-badge{position:absolute;top:10px;left:10px;padding:5px 11px;border-radius:100px;font-size:10px;font-weight:800;letter-spacing:.04em;z-index:2;box-shadow:0 4px 12px rgba(0,0,0,.2);display:inline-flex;align-items:center;gap:6px}
.ph-badge::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.6}
.b-open{background:rgba(18,183,106,.92);color:white}
.b-guard{background:rgba(244,196,48,.95);color:#5b3f00}
.b-closed{background:rgba(240,68,56,.88);color:white}
.ph-fav{position:absolute;top:10px;right:10px;width:32px;height:32px;background:rgba(255,255,255,.92);border-radius:50%;border:none;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--MUT);cursor:pointer;transition:transform .25s var(--ease-spring),background .2s,color .2s;z-index:2;backdrop-filter:blur(6px)}
.ph-fav.on{color:var(--ERR)}
.ph-fav.on i{animation:heartBeat .6s var(--ease-spring)}
@keyframes heartBeat{0%,100%{transform:scale(1)}40%{transform:scale(1.35)}60%{transform:scale(.92)}}
.ph-fav:hover{background:white;transform:scale(1.12)}
.ph-body{padding:15px}
.ph-name{font-size:14px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:5px;line-height:1.3;letter-spacing:-.01em}
.ph-loc{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--MUT);margin-bottom:13px}
.ph-loc i{color:var(--G);font-size:11px}
.ph-foot{display:flex;gap:8px}
.ph-btn{flex:1;padding:9px 8px;border-radius:9px;font-size:12px;font-weight:800;border:none;transition:background .2s,color .2s,transform .2s var(--ease-spring);font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px}
.ph-btn-view{background:var(--G);color:white}
.ph-btn-view:hover{background:var(--GD);transform:translateY(-1px)}
.ph-btn-call{background:var(--BL);color:var(--B);flex:0 0 42px}
.ph-btn-call:hover{background:var(--B);color:white;transform:translateY(-1px)}
.hidden-card{display:none}
.show-more-wrap{text-align:center;margin-top:40px}
#noRes{display:none;text-align:center;padding:56px 20px;color:var(--MUT)}
#noRes i{font-size:56px;margin-bottom:16px;opacity:.25;display:block}
#noRes p{font-size:15px;font-weight:600}

/* ============================================
   HOW IT WORKS
   ============================================ */
.how-section{background:white}
.how-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;max-width:1280px;margin:0 auto;position:relative}
.how-grid::before{
  content:'';position:absolute;top:50px;left:calc(12.5% + 28px);right:calc(12.5% + 28px);height:2px;
  background:linear-gradient(90deg,var(--GL) 0%,var(--G) 50%,var(--GOLD) 100%);
  background-size:200% 100%;
  animation:lineShimmer 4s linear infinite;
  z-index:0;
}
@keyframes lineShimmer{0%{background-position:0% 0%}100%{background-position:200% 0%}}
.how-step{text-align:center;padding:0 16px;position:relative;z-index:1}
.how-ico-wrap{width:100px;height:100px;margin:0 auto 20px;position:relative}
.how-ico-bg{
  width:100px;height:100px;border-radius:50%;background:white;
  border:3px solid var(--GL);display:flex;align-items:center;justify-content:center;
  transition:transform .35s var(--ease-spring),border-color .3s,box-shadow .3s;
  position:relative;
}
.how-ico-bg::before{
  content:'';position:absolute;inset:-7px;border-radius:50%;
  border:1px dashed rgba(14,124,102,.3);
  opacity:0;transform:scale(.92);transition:opacity .3s,transform .3s var(--ease-spring);
}
.how-step:hover .how-ico-bg{border-color:var(--G);transform:scale(1.08);box-shadow:var(--shadow-glow)}
.how-step:hover .how-ico-bg::before{opacity:1;transform:scale(1)}
.how-ico-bg i{font-size:28px;color:var(--G);transition:transform .3s var(--ease-spring)}
.how-step:hover .how-ico-bg i{transform:scale(1.1) rotate(-4deg)}
.how-num{
  position:absolute;top:-2px;right:-2px;width:28px;height:28px;
  background:var(--G);color:white;border-radius:50%;font-size:11px;font-weight:900;
  display:flex;align-items:center;justify-content:center;
  border:3px solid white;font-family:'Plus Jakarta Sans',sans-serif;
  box-shadow:0 4px 12px rgba(14,124,102,.4);
}
.how-step:last-child .how-num{background:var(--GOLD);color:var(--B);box-shadow:0 4px 12px rgba(244,196,48,.4)}
.how-step h3{font-size:15px;font-weight:800;color:var(--B);margin-bottom:8px;font-family:'Plus Jakarta Sans',sans-serif}
.how-step p{font-size:13px;color:var(--MUT);line-height:1.7}

/* ============================================
   GARDE BANNER
   ============================================ */
.garde-section{
  background:
    radial-gradient(60% 70% at 50% 40%, rgba(14,124,102,.45) 0%, transparent 70%),
    linear-gradient(140deg,var(--B) 0%,var(--BM) 100%);
  position:relative;overflow:hidden;
}
.garde-section::before{
  content:'';position:absolute;inset:0;
  background-image:radial-gradient(circle,rgba(255,255,255,.05) 1px,transparent 1px);
  background-size:24px 24px;
}
.garde-section::after{
  content:'';position:absolute;width:380px;height:380px;border-radius:50%;
  background:radial-gradient(circle,rgba(244,196,48,.25) 0%, transparent 70%);
  top:50%;left:50%;transform:translate(-50%,-50%);
  animation:glowPulse 4s ease-in-out infinite;pointer-events:none;
}
@keyframes glowPulse{
  0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.6}
  50%    {transform:translate(-50%,-50%) scale(1.15);opacity:1}
}
.garde-inner{position:relative;z-index:1;max-width:740px;margin:0 auto;text-align:center}
.garde-icon{
  width:88px;height:88px;background:rgba(244,196,48,.15);
  border:1px solid rgba(244,196,48,.35);border-radius:50%;
  margin:0 auto 24px;display:flex;align-items:center;justify-content:center;
  position:relative;
}
.garde-icon::before{
  content:'';position:absolute;inset:-12px;border-radius:50%;
  border:2px solid rgba(244,196,48,.3);
  animation:pulseRing 2.4s ease-out infinite;
}
@keyframes pulseRing{0%{transform:scale(.9);opacity:1}100%{transform:scale(1.4);opacity:0}}
.garde-icon i{font-size:36px;color:var(--GOLD)}
.garde-section h2{font-size:clamp(24px,3.5vw,40px);font-weight:900;color:white;margin-bottom:16px;font-family:'Plus Jakarta Sans',sans-serif;line-height:1.15;letter-spacing:-.02em}
.garde-section p{font-size:16px;color:rgba(255,255,255,.78);line-height:1.78;margin-bottom:36px}
.garde-cta{
  display:inline-flex;align-items:center;gap:10px;background:var(--GOLD);color:var(--B);
  padding:16px 36px;border-radius:13px;font-weight:900;font-size:16px;border:none;cursor:pointer;
  font-family:'Plus Jakarta Sans',sans-serif;transition:transform .25s var(--ease-spring),background .25s,box-shadow .25s;
  position:relative;overflow:hidden;
}
.garde-cta::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.45) 50%,transparent 70%);
  transform:translateX(-100%);transition:transform .7s var(--ease-out);
}
.garde-cta:hover::after{transform:translateX(100%)}
.garde-cta:hover{background:var(--GOLD-D);transform:translateY(-3px);box-shadow:var(--shadow-gold)}
.garde-cta i:last-child{transition:transform .25s var(--ease-out)}
.garde-cta:hover i:last-child{transform:translateX(4px)}

/* ============================================
   COMMANDER SECTION
   ============================================ */
.cmd-section{
  background:
    radial-gradient(70% 60% at 0% 50%, rgba(14,124,102,.06) 0%, transparent 60%),
    var(--GXL);
  border-top:1px solid rgba(14,124,102,.1);
}
.cmd-inner{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.cmd-content .sec-tag{background:white}
.cmd-content h2{font-size:clamp(26px,3.5vw,40px);font-weight:900;color:var(--B);margin-bottom:16px;font-family:'Plus Jakarta Sans',sans-serif;line-height:1.15;letter-spacing:-.02em}
.cmd-content p{font-size:15px;color:var(--MUT);line-height:1.78;margin-bottom:28px}
.cmd-steps{display:flex;flex-direction:column;gap:14px;margin-bottom:32px}
.cmd-step-item{display:flex;align-items:center;gap:14px;padding:6px 6px 6px 0;transition:transform .3s var(--ease-out)}
.cmd-step-item:hover{transform:translateX(6px)}
.cmd-step-ico{width:42px;height:42px;border-radius:12px;background:white;border:1px solid var(--BDR);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;box-shadow:var(--shadow);transition:transform .3s var(--ease-spring),box-shadow .3s}
.cmd-step-item:hover .cmd-step-ico{transform:scale(1.08) rotate(-3deg);box-shadow:var(--shadow-md)}
.cmd-step-item p{font-size:14px;color:var(--T);font-weight:600;margin:0}
.cmd-visual{background:white;border-radius:20px;padding:28px;box-shadow:var(--shadow-md);border:1px solid var(--BDR)}
.cmd-visual-ttl{font-size:15px;font-weight:800;color:var(--B);margin-bottom:18px;font-family:'Plus Jakarta Sans',sans-serif;display:flex;align-items:center;gap:8px}
.cmd-types{display:flex;flex-direction:column;gap:12px}
.cmd-type{display:flex;align-items:center;gap:14px;padding:14px;border-radius:12px;background:var(--LT);border:1px solid var(--BDR);transition:transform .25s var(--ease-out),background .25s,border-color .25s,box-shadow .25s;cursor:pointer}
.cmd-type:hover{border-color:var(--G);background:white;transform:translateX(6px);box-shadow:var(--shadow)}
.cmd-type-ico{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.cmd-type-txt strong{display:block;font-size:13px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif}
.cmd-type-txt span{font-size:12px;color:var(--MUT)}
.cmd-type-arr{margin-left:auto;color:var(--MUT);font-size:13px;flex-shrink:0;transition:transform .25s var(--ease-out),color .25s}
.cmd-type:hover .cmd-type-arr{transform:translateX(4px);color:var(--G)}

/* ============================================
   COVERAGE — NOUVELLE SECTION
   ============================================ */
.cov-section{
  background:
    radial-gradient(60% 50% at 100% 0%, rgba(14,124,102,.04) 0%, transparent 60%),
    radial-gradient(60% 50% at 0% 100%, rgba(244,196,48,.04) 0%, transparent 60%),
    white;
  border-top:1px solid var(--BDR);
}
.cov-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1280px;margin:0 auto}
.cov-card{
  position:relative;border-radius:20px;overflow:hidden;
  background:var(--B);min-height:380px;
  box-shadow:var(--shadow);
  cursor:pointer;
  transition:transform .45s var(--ease-out), box-shadow .45s var(--ease-out);
}
.cov-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
.cov-card-bg{
  position:absolute;inset:0;background-size:cover;background-position:center;
  transition:transform .8s var(--ease-out),filter .5s;
  filter:brightness(.7) saturate(1.1);
}
.cov-card:hover .cov-card-bg{transform:scale(1.08);filter:brightness(.78) saturate(1.2)}
.cov-card-ov{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(11,37,69,.15) 0%,rgba(11,37,69,.55) 55%,rgba(11,37,69,.92) 100%);
}
.cov-card-body{position:relative;padding:24px;display:flex;flex-direction:column;height:100%;min-height:380px;color:white}
.cov-card-tag{
  align-self:flex-start;
  background:rgba(244,196,48,.95);color:var(--B);
  padding:5px 12px;border-radius:100px;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;
  display:inline-flex;align-items:center;gap:6px;
}
.cov-card-tag::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--B)}
.cov-card-name{
  margin-top:auto;font-size:30px;font-weight:900;font-family:'Plus Jakarta Sans',sans-serif;
  letter-spacing:-.02em;line-height:1.1;
}
.cov-card-sub{font-size:13px;color:rgba(255,255,255,.7);margin-top:4px;font-style:italic}
.cov-card-stats{
  margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.15);
  display:grid;grid-template-columns:1fr 1fr;gap:12px;
}
.cov-stat .cov-n{
  font-size:26px;font-weight:900;color:var(--GOLD);font-family:'Plus Jakarta Sans',sans-serif;line-height:1;
}
.cov-stat .cov-l{font-size:10px;color:rgba(255,255,255,.65);font-weight:600;margin-top:5px;letter-spacing:.06em;text-transform:uppercase}
.cov-card-cities{margin-top:14px;font-size:12px;color:rgba(255,255,255,.7);font-weight:500;display:flex;align-items:center;gap:6px}
.cov-card-cities i{color:var(--GOLD);font-size:10px}
@media(max-width:900px){.cov-grid{grid-template-columns:1fr;gap:16px}.cov-card{min-height:320px}.cov-card-body{min-height:320px}}

/* Coverage carousel (announces / images / stats) */
.cov-carousel{
  margin-top:36px;max-width:1280px;margin-left:auto;margin-right:auto;
  position:relative;height:180px;border-radius:20px;overflow:hidden;
  box-shadow:var(--shadow-glow);
  background:var(--B);
}
.cov-slide{
  position:absolute;inset:0;display:flex;align-items:center;
  opacity:0;visibility:hidden;
  transition:opacity .6s var(--ease-out),visibility .6s,transform .8s var(--ease-out);
  transform:scale(1.02);
}
.cov-slide.active{opacity:1;visibility:visible;transform:scale(1)}
/* Variant 1 : stats */
.cs-stats{
  background:linear-gradient(135deg,var(--G) 0%,var(--GD) 100%);
  padding:28px 36px;color:white;
  display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;
}
.cs-stats::before{
  content:'';position:absolute;top:-50%;right:-10%;width:400px;height:400px;
  background:radial-gradient(circle,rgba(244,196,48,.28) 0%, transparent 70%);
  pointer-events:none;
}
.cs-stats-txt h3{font-size:22px;font-weight:900;font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:6px;letter-spacing:-.01em}
.cs-stats-txt p{font-size:14px;color:rgba(255,255,255,.85);max-width:520px;line-height:1.55;margin:0}
.cs-stats-num{display:flex;align-items:baseline;gap:8px;position:relative;z-index:1}
.cs-stats-num .big{font-size:60px;font-weight:900;color:var(--GOLD);font-family:'Plus Jakarta Sans',sans-serif;line-height:1;letter-spacing:-.04em}
.cs-stats-num .lbl{font-size:12px;color:rgba(255,255,255,.78);font-weight:600;text-transform:uppercase;letter-spacing:.08em;line-height:1.3}
/* Variant 2 : image */
.cs-image{padding:0}
.cs-image .cs-img-bg{
  position:absolute;inset:0;background-size:cover;background-position:center;
  filter:brightness(.55) saturate(1.1);
}
.cs-image::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,rgba(11,37,69,.85) 0%,rgba(11,37,69,.35) 60%,transparent 100%);
}
.cs-image-content{position:relative;z-index:1;padding:28px 36px;color:white;max-width:60%}
.cs-image-content .tag{
  display:inline-block;background:rgba(244,196,48,.95);color:var(--B);
  padding:4px 12px;border-radius:100px;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;
  margin-bottom:10px;
}
.cs-image-content h3{font-size:22px;font-weight:900;font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:4px;letter-spacing:-.01em}
.cs-image-content p{font-size:13px;color:rgba(255,255,255,.85);line-height:1.5;margin:0}
/* Variant 3 : announcement text */
.cs-announce{
  background:linear-gradient(135deg,#1a3a6e 0%,var(--B) 100%);
  padding:24px 36px;color:white;
  display:flex;align-items:center;gap:20px;
}
.cs-announce::before{
  content:'';position:absolute;top:50%;right:-100px;width:300px;height:300px;
  border-radius:50%;background:radial-gradient(circle,rgba(244,196,48,.18) 0%,transparent 70%);
  transform:translateY(-50%);
}
.cs-announce-ico{
  flex-shrink:0;width:62px;height:62px;border-radius:18px;
  background:linear-gradient(135deg,var(--GOLD),var(--GOLD-D));color:var(--B);
  display:flex;align-items:center;justify-content:center;font-size:28px;
  box-shadow:0 8px 22px rgba(244,196,48,.35);
}
.cs-announce-txt{position:relative;z-index:1}
.cs-announce-txt .tag{
  display:inline-block;background:rgba(244,196,48,.2);color:var(--GOLD);
  padding:3px 10px;border-radius:100px;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;
  margin-bottom:6px;border:1px solid rgba(244,196,48,.3);
}
.cs-announce-txt h3{font-size:20px;font-weight:900;font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:4px;letter-spacing:-.01em}
.cs-announce-txt p{font-size:13px;color:rgba(255,255,255,.78);line-height:1.5;margin:0}
/* Variant 4 : quote */
.cs-quote{
  background:linear-gradient(135deg,var(--G) 0%,#0a5e4d 60%,var(--B) 100%);
  padding:28px 36px;color:white;
  display:flex;align-items:center;gap:18px;
}
.cs-quote-mark{
  flex-shrink:0;font-size:80px;font-family:Georgia,serif;color:var(--GOLD);
  line-height:.7;font-weight:900;opacity:.9;
}
.cs-quote-txt p{font-size:15px;font-style:italic;line-height:1.55;margin-bottom:10px;color:rgba(255,255,255,.95)}
.cs-quote-txt .by{font-size:12px;color:var(--GOLD);font-weight:800;letter-spacing:.04em}

/* Carousel controls */
.cov-arrows{
  position:absolute;top:50%;left:0;right:0;display:flex;justify-content:space-between;
  padding:0 12px;transform:translateY(-50%);z-index:2;pointer-events:none;
}
.cov-arr{
  pointer-events:auto;width:36px;height:36px;border-radius:50%;
  background:rgba(255,255,255,.18);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.22);
  color:white;cursor:pointer;
  display:flex;align-items:center;justify-content:center;font-size:13px;
  transition:background .2s,transform .25s var(--ease-spring);
}
.cov-arr:hover{background:rgba(255,255,255,.32);transform:scale(1.08)}
.cov-dots{
  position:absolute;bottom:12px;left:50%;transform:translateX(-50%);
  display:flex;gap:7px;z-index:2;
}
.cov-d{
  width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.42);
  cursor:pointer;border:none;padding:0;transition:width .3s var(--ease-out),background .3s;
}
.cov-d.on{background:var(--GOLD);width:26px;border-radius:4px}

@media(max-width:820px){
  .cov-carousel{height:auto;min-height:200px}
  .cs-stats{flex-direction:column;text-align:center;padding:22px 20px}
  .cs-stats-num{justify-content:center}
  .cs-stats-num .big{font-size:44px}
  .cs-image-content{max-width:none;padding:22px 20px}
  .cs-announce{padding:18px 20px;flex-direction:column;text-align:center;gap:14px}
  .cs-quote{padding:22px 20px;flex-direction:column;text-align:center}
  .cs-quote-mark{font-size:48px}
  .cov-arrows{padding:0 6px}
  .cov-arr{width:32px;height:32px;font-size:11px}
}

/* ============================================
   FOOTER
   ============================================ */
.footer{background:var(--B);padding:56px 5% 24px;color:rgba(255,255,255,.7);position:relative;overflow:hidden}
.footer::before{content:'';position:absolute;inset:0;background:radial-gradient(60% 60% at 50% 0%, rgba(14,124,102,.18) 0%, transparent 60%);pointer-events:none}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;max-width:1280px;margin:0 auto;padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,.08);position:relative}
.footer-brand{display:flex;flex-direction:column;gap:14px}
.footer-brand .brand-mark .loca{color:white}
.footer-brand .brand-mark .pharma{color:var(--GOLD)}
.footer-brand p{font-size:13px;line-height:1.75;color:rgba(255,255,255,.5);max-width:240px}
.footer-col h5{font-size:12px;font-weight:800;color:white;margin-bottom:16px;font-family:'Plus Jakarta Sans',sans-serif;text-transform:uppercase;letter-spacing:.08em}
.footer-col ul{list-style:none;display:flex;flex-direction:column;gap:10px}
.footer-col a{font-size:13px;color:rgba(255,255,255,.5);transition:color .2s,transform .2s;display:inline-block;position:relative}
.footer-col a::before{content:'';position:absolute;left:-12px;top:50%;width:6px;height:1px;background:var(--GOLD);transform:translateY(-50%) scaleX(0);transform-origin:right;transition:transform .25s var(--ease-out)}
.footer-col a:hover{color:var(--GOLD);transform:translateX(8px)}
.footer-col a:hover::before{transform:translateY(-50%) scaleX(1);transform-origin:left}
.footer-bot{max-width:1280px;margin:20px auto 0;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;position:relative}
.footer-bot p{font-size:12px;color:rgba(255,255,255,.3);line-height:1.6}
.socials{display:flex;gap:10px}
.soc{width:38px;height:38px;background:rgba(255,255,255,.05);border-radius:50%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.55);font-size:14px;transition:background .25s,color .25s,transform .25s var(--ease-spring),border-color .25s;border:1px solid rgba(255,255,255,.08)}
.soc:hover{background:var(--GOLD);color:var(--B);border-color:var(--GOLD);transform:translateY(-3px) rotate(-4deg)}

/* ============================================
   FULL-SCREEN MODAL
   ============================================ */
.fs-modal{position:fixed;inset:0;z-index:1500;background:white;transform:translateX(100%);transition:transform .42s var(--ease-out);display:flex;flex-direction:column;overflow:hidden}
.fs-modal.open{transform:translateX(0)}
.fs-modal-topbar{display:flex;align-items:center;gap:14px;padding:0 20px;height:60px;flex-shrink:0;background:white;border-bottom:1px solid var(--BDR);position:relative;box-shadow:0 2px 12px rgba(11,37,69,.06)}
.fs-back{width:40px;height:40px;background:var(--LT);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--B);cursor:pointer;transition:background .2s,transform .25s var(--ease-spring);flex-shrink:0}
.fs-back:hover{background:var(--BL);transform:scale(1.05)}
.fs-topbar-title{font-size:16px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif;flex:1;text-align:center;margin-right:40px;letter-spacing:-.01em}
.fs-modal-content{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch}
.fs-gallery{position:relative;height:340px;overflow:hidden;background:var(--B);flex-shrink:0;border-bottom:3px solid white;box-shadow:0 4px 24px rgba(11,37,69,.15);cursor:zoom-in}
.fs-gallery img{width:100%;height:100%;object-fit:cover;transition:opacity .4s var(--ease-out),transform 6s ease-out;display:block}
.fs-gallery img.kenburns{transform:scale(1.06)}
.fs-sticky-bar{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.97);backdrop-filter:blur(16px);border-bottom:1px solid var(--BDR);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 12px rgba(11,37,69,.07);transform:translateY(-100%);opacity:0;transition:transform .3s,opacity .3s;pointer-events:none}
.fs-sticky-bar.visible{transform:translateY(0);opacity:1;pointer-events:all}
.fs-sticky-name{font-size:14px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif}
.fs-sticky-status{font-size:11px;font-weight:800;padding:3px 10px;border-radius:100px}
.fs-gal-arr{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;background:rgba(255,255,255,.9);border-radius:50%;border:none;display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--B);cursor:pointer;transition:background .2s,transform .25s var(--ease-spring)}
.fs-gal-arr:hover{background:white;transform:translateY(-50%) scale(1.08)}
.fs-gal-prev{left:14px}.fs-gal-next{right:14px}
.fs-gal-dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:6px}
.fs-dot{width:7px;height:7px;border-radius:50%;border:none;cursor:pointer;background:rgba(255,255,255,.45);transition:width .3s var(--ease-out),background .3s;padding:0}
.fs-dot.on{background:white;width:24px;border-radius:4px}
.fs-badge{position:absolute;bottom:14px;left:14px;padding:5px 13px;border-radius:100px;font-size:11px;font-weight:800;letter-spacing:.04em}
.fs-body{padding:0}
.fs-ph-header{padding:24px 24px 20px;background:linear-gradient(180deg,var(--GXL) 0%,white 100%);border-bottom:1px solid var(--BDR);display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
.fs-ph-name{font-size:24px;font-weight:900;color:var(--G);font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:6px;line-height:1.2;letter-spacing:-.02em}
.fs-content-pad{padding:22px 24px}
.fs-desc{font-size:14px;color:var(--MUT);line-height:1.85;margin-bottom:22px;padding-bottom:22px;border-bottom:1px solid var(--BDR);font-weight:500}
.fs-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}
.fs-info-blk{background:var(--LT);border-radius:12px;padding:13px 14px;border:1px solid var(--BDR);transition:background .2s,border-color .2s,transform .2s}
.fs-info-blk:hover{border-color:var(--G);background:var(--GXL);transform:translateY(-2px)}
.fs-info-lbl{font-size:10px;font-weight:800;color:var(--MUT);text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px;display:flex;align-items:center;gap:5px}
.fs-info-lbl i{color:var(--G);font-size:11px}
.fs-info-val{font-size:13px;font-weight:700;color:var(--T);line-height:1.4}
.fs-info-val a{color:var(--G)}
.fs-sec-title{font-size:11px;font-weight:900;color:var(--B);text-transform:uppercase;letter-spacing:.09em;margin-bottom:14px;display:flex;align-items:center;gap:8px;padding-bottom:8px;border-bottom:2px solid var(--GL)}
.fs-sec-title i{color:var(--G);font-size:13px}
.fs-map{border-radius:14px;overflow:hidden;height:240px;margin-bottom:24px;position:relative;border:1px solid var(--BDR);box-shadow:0 2px 16px rgba(11,37,69,.08)}
.fs-map iframe{width:100%;height:100%;border:none;display:block}
.fs-map-fs-btn{position:absolute;top:10px;right:10px;background:white;border:1px solid var(--BDR);border-radius:9px;padding:7px 12px;font-size:12px;font-weight:800;color:var(--B);cursor:pointer;display:flex;align-items:center;gap:6px;transition:.2s;font-family:'Plus Jakarta Sans',sans-serif;z-index:5;box-shadow:var(--shadow)}
.fs-map-fs-btn:hover{background:var(--B);color:white;border-color:var(--B)}
.fs-hours{margin-bottom:24px;background:var(--LT);border-radius:12px;overflow:hidden;border:1px solid var(--BDR)}
.fs-hr{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;border-bottom:1px solid var(--BDR);font-size:13px;transition:.15s}
.fs-hr:last-child{border:none}
.fs-hr:hover{background:var(--GXL)}
.fs-hr-day{color:var(--MUT);font-weight:600;font-size:12px}
.fs-hr-time{font-weight:800;color:var(--T);font-size:13px}
.fs-hr-closed{color:var(--ERR);font-weight:800;font-size:13px}
.fs-call-btn{width:100%;padding:17px;background:linear-gradient(135deg,var(--G),var(--GD));color:white;border:none;border-radius:14px;font-size:15px;font-weight:900;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;transition:transform .22s var(--ease-spring),box-shadow .22s;font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:40px;box-shadow:0 4px 20px rgba(14,124,102,.28)}
.fs-call-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-glow)}
.fs-call-btn:active{transform:translateY(0)}

@media(min-width:641px){
  .fs-modal-content{background:var(--LT)}
  .fs-body{max-width:860px;margin:0 auto;padding:28px 36px 56px}
  .fs-ph-header{border-radius:16px;box-shadow:0 4px 28px rgba(11,37,69,.1);border:1px solid var(--BDR);margin-bottom:20px}
  .fs-desc{background:white;border-radius:13px;padding:18px 22px;border:1px solid var(--BDR);box-shadow:0 2px 12px rgba(11,37,69,.06);border-bottom:none}
  .fs-info-grid{grid-template-columns:1fr 1fr}
  .fs-info-blk{background:white}
  .fs-map{box-shadow:0 4px 24px rgba(11,37,69,.1);border-radius:16px}
  .fs-hours{box-shadow:0 2px 12px rgba(11,37,69,.06);border-radius:14px;overflow:hidden}
  .fs-sec-title{margin-top:6px}
}

/* ============================================
   LIGHTBOX / MAP FS / CALL / TOAST
   ============================================ */
.lightbox{position:fixed;inset:0;z-index:3000;background:rgba(0,0,0,.97);display:flex;align-items:center;justify-content:center;flex-direction:column;opacity:0;visibility:hidden;transition:.3s}
.lightbox.open{opacity:1;visibility:visible}
.lightbox img{max-width:100%;max-height:80vh;object-fit:contain;border-radius:8px;box-shadow:0 8px 48px rgba(0,0,0,.5);transition:opacity .25s}
.lightbox-close{position:absolute;top:16px;right:16px;width:46px;height:46px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;color:white;cursor:pointer;transition:background .2s,transform .3s var(--ease-spring);z-index:10;backdrop-filter:blur(10px)}
.lightbox-close:hover{background:var(--ERR);transform:rotate(90deg)}
.lightbox-prev,.lightbox-next{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;color:white;cursor:pointer;transition:background .2s,transform .25s var(--ease-spring);backdrop-filter:blur(10px)}
.lightbox-prev{left:16px}.lightbox-next{right:16px}
.lightbox-prev:hover{background:rgba(255,255,255,.25);transform:translateY(-50%) translateX(-4px)}
.lightbox-next:hover{background:rgba(255,255,255,.25);transform:translateY(-50%) translateX(4px)}
.lightbox-counter{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.7);font-size:13px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif}
.lightbox-thumbs{display:flex;gap:8px;margin-top:16px;padding:0 20px;max-width:92vw;overflow-x:auto}
.lightbox-thumb{width:60px;height:46px;border-radius:8px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:border-color .2s,transform .2s;flex-shrink:0;opacity:.65}
.lightbox-thumb.active{border-color:white;opacity:1;transform:scale(1.05)}
.lightbox-thumb img{width:100%;height:100%;object-fit:cover}

.map-fs{position:fixed;inset:0;z-index:2000;display:flex;flex-direction:column;background:white;transform:scale(.95);opacity:0;visibility:hidden;transition:.3s var(--ease-out)}
.map-fs.open{transform:scale(1);opacity:1;visibility:visible}
.map-fs-head{display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:56px;border-bottom:1px solid var(--BDR);flex-shrink:0}
.map-fs-head span{font-size:15px;font-weight:800;color:var(--B);font-family:'Plus Jakarta Sans',sans-serif}
.map-fs-close{background:var(--LT);border:none;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--B);cursor:pointer;transition:.2s}
.map-fs-close:hover{background:var(--ERR);color:white}
.map-fs iframe{flex:1;border:none;width:100%}

.call-overlay{position:fixed;inset:0;z-index:2000;background:rgba(11,37,69,.6);backdrop-filter:blur(12px);display:flex;align-items:flex-end;justify-content:center;opacity:0;visibility:hidden;transition:.3s}
.call-overlay.open{opacity:1;visibility:visible}
.call-sheet{background:white;width:100%;max-width:460px;border-radius:24px 24px 0 0;padding:28px 24px 36px;transform:translateY(60px);transition:transform .35s var(--ease-out)}
.call-overlay.open .call-sheet{transform:translateY(0)}
.call-handle{width:40px;height:4px;background:var(--BDR);border-radius:2px;margin:0 auto 28px}
.call-ava{width:74px;height:74px;border-radius:50%;background:var(--GL);margin:0 auto 16px;display:flex;align-items:center;justify-content:center;font-size:30px;color:var(--G);position:relative}
.call-ava::before{content:'';position:absolute;inset:-10px;border-radius:50%;border:2px solid var(--GL);animation:pulseRing 1.8s ease-out infinite}
.call-pharma{font-size:18px;font-weight:900;color:var(--B);text-align:center;font-family:'Plus Jakarta Sans',sans-serif}
.call-num{font-size:24px;font-weight:700;color:var(--T);text-align:center;margin:6px 0 28px;letter-spacing:.05em}
.call-btns{display:flex;gap:12px}
.call-cancel{flex:1;padding:14px;background:var(--LT);border:1px solid var(--BDR);border-radius:12px;font-size:15px;font-weight:800;color:var(--MUT);cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;transition:.2s}
.call-cancel:hover{background:var(--BDR)}
.call-ok{flex:2;padding:14px;background:var(--OK);border:none;border-radius:12px;font-size:15px;font-weight:900;color:white;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;transition:.22s}
.call-ok:hover{background:#0fa85a;transform:translateY(-1px);box-shadow:0 6px 20px rgba(18,183,106,.35)}

.toast-el{position:fixed;bottom:84px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--B);color:white;padding:13px 22px;border-radius:100px;font-size:13px;font-weight:700;z-index:4000;opacity:0;transition:opacity .32s,transform .32s var(--ease-spring);pointer-events:none;white-space:nowrap;box-shadow:var(--shadow-md);font-family:'Plus Jakarta Sans',sans-serif}
.toast-el.on{opacity:1;transform:translateX(-50%) translateY(0)}

/* Scroll reveals */
.rev,.rev-l,.rev-r{opacity:0;transition:opacity .75s var(--ease-out),transform .75s var(--ease-out);transition-delay:calc(var(--i,0) * 80ms)}
.rev{transform:translateY(28px)}
.rev-l{transform:translateX(-28px)}
.rev-r{transform:translateX(28px)}
.rev.in,.rev-l.in,.rev-r.in{opacity:1;transform:none}

/* Reduced motion */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .ph-card,.rev,.rev-l,.rev-r{opacity:1!important;transform:none!important}
  .hero-h1 .word{opacity:1;transform:none}
  .hero-sub,.hero-ctas,.hero-kpis,.hero-card,.hero-eyebrow{opacity:1;transform:none}
}

/* ============================================
   BUTTONS
   ============================================ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:13px 26px;border-radius:12px;font-size:14px;font-weight:800;border:none;cursor:pointer;
  transition:transform .25s var(--ease-spring),background .25s,color .25s,box-shadow .25s;
  font-family:'Plus Jakarta Sans',sans-serif;white-space:nowrap;text-decoration:none;
  position:relative;isolation:isolate;overflow:hidden;
}
.btn::before{
  content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(120deg,transparent 20%,rgba(255,255,255,.22) 50%,transparent 80%);
  transform:translateX(-100%);transition:transform .6s var(--ease-out);
}
.btn:hover::before{transform:translateX(100%)}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0)}
.btn-lg{padding:15px 30px;font-size:15px;border-radius:13px}
.btn-primary{background:var(--G);color:white;box-shadow:0 4px 18px rgba(14,124,102,.28)}
.btn-primary:hover{background:var(--GD);box-shadow:var(--shadow-glow)}
.btn-white{background:white;color:var(--G)}
.btn-white:hover{background:var(--GL);box-shadow:0 8px 24px rgba(255,255,255,.25)}
.btn-glass{background:rgba(255,255,255,.1);color:white;border:1.5px solid rgba(255,255,255,.35)}
.btn-glass:hover{background:rgba(255,255,255,.18);border-color:rgba(255,255,255,.6)}

/* ============================================
   RESPONSIVE
   ============================================ */
@media(max-width:1100px){
  .ph-grid{grid-template-columns:repeat(3,1fr)}
  .how-grid{grid-template-columns:repeat(2,1fr);gap:32px}
  .how-grid::before{display:none}
  .footer-grid{grid-template-columns:1fr 1fr;gap:32px}
  .cmd-inner{gap:40px}
}
@media(max-width:820px){
  .ph-grid{grid-template-columns:repeat(2,1fr)}
  .hero-inner{grid-template-columns:1fr;gap:36px;padding:60px 5%}
  .hero-card{max-width:100%}
  .cmd-inner{grid-template-columns:1fr}
  .cmd-visual{display:none}
  .fs-info-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr 1fr}
  /* cov-callout remplacé par cov-carousel — règles spécifiques dans la section carousel */
}
@media(max-width:640px){
  body{padding-top:60px;padding-bottom:var(--BOT)}
  .srch-bar{top:60px}
  .footer{display:none}
  section{padding:52px 4%}
  .ph-grid{grid-template-columns:repeat(2,1fr);gap:12px}
  .hero-ctas{flex-direction:column;align-items:stretch}
  .hero-ctas .btn{width:100%;justify-content:center}
  .hero-kpis{gap:10px;justify-content:center}
  .how-grid{grid-template-columns:1fr 1fr}
  .quick-grid{grid-template-columns:1fr 1fr}
  .fs-gallery{height:240px}
  .fs-body{padding:20px 16px}
  .fs-ph-name{font-size:20px}
  .fs-info-grid{grid-template-columns:1fr 1fr}
  .call-sheet{border-radius:20px 20px 0 0}
  section{padding:48px 4%}
  .how-grid::before{display:none}
  .how-step{padding:0 10px}
  .cs-stats-num .big{font-size:40px}
}
@media(max-width:380px){.ph-grid{grid-template-columns:1fr}}
</style>
