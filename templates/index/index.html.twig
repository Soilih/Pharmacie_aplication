/* ============================================
   LIGHTBOX / MAP FS / CALL / TOAST
   ============================================ */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(0,0,0,0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s var(--ease-out), visibility 0.3s;
}
.lightbox.open { opacity: 1; visibility: visible; }
.lightbox-close, .lightbox-prev, .lightbox-next {
  position: absolute;
  width: 46px; height: 46px;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: white;
  cursor: pointer;
  transition: background 0.2s, transform 0.25s var(--ease-spring);
  backdrop-filter: blur(10px);
}
.lightbox-close { top: 20px; right: 20px; }
.lightbox-prev { top: 50%; left: 20px; transform: translateY(-50%); }
.lightbox-next { top: 50%; right: 20px; transform: translateY(-50%); }
.lightbox-close:hover { background: var(--danger); transform: rotate(90deg); }
.lightbox-prev:hover { transform: translateY(-50%) translateX(-4px); background: rgba(255,255,255,0.2); }
.lightbox-next:hover { transform: translateY(-50%) translateX(4px);  background: rgba(255,255,255,0.2); }
.lightbox img { max-width: 92vw; max-height: 70vh; border-radius: 12px; transition: opacity 0.25s; }
.lightbox-counter { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.7); font-size: 13px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; }
.lightbox-thumbs { display: flex; gap: 10px; margin-top: 24px; padding: 0 20px; max-width: 92vw; overflow-x: auto; }
.lightbox-thumb { width: 60px; height: 46px; border-radius: 8px; overflow: hidden; cursor: pointer; border: 2px solid transparent; transition: border-color 0.2s, transform 0.2s; flex-shrink: 0; opacity: 0.65; }
.lightbox-thumb.active { border-color: white; opacity: 1; transform: scale(1.05); }
.lightbox-thumb img { width: 100%; height: 100%; object-fit: cover; }

.map-fs { position: fixed; inset: 0; z-index: 1800; display: flex; flex-direction: column; background: white; transform: scale(0.96); opacity: 0; visibility: hidden; transition: opacity 0.3s var(--ease-out), transform 0.3s, visibility 0.3s; }
.map-fs.open { transform: scale(1); opacity: 1; visibility: visible; }
.map-fs-head { display: flex; align-items: center; justify-content: space-between; padding: 0 20px; height: 60px; border-bottom: 1px solid var(--gray-200); flex-shrink: 0; }
.map-fs-head span { font-size: 16px; font-weight: 800; color: var(--dark); font-family: 'Plus Jakarta Sans', sans-serif; }
.map-fs-close { width: 38px; height: 38px; background: var(--gray-50); border: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; cursor: pointer; transition: background 0.2s; }
.map-fs-close:hover { background: var(--danger); color: white; }
.map-fs iframe { flex: 1; border: none; width: 100%; }

.call-overlay { position: fixed; inset: 0; z-index: 1700; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); display: flex; align-items: flex-end; justify-content: center; opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s; }
.call-overlay.open { opacity: 1; visibility: visible; }
.call-sheet { background: white; width: 100%; max-width: 460px; border-radius: 28px 28px 0 0; padding: 24px 24px 36px; transform: translateY(100%); transition: transform 0.4s var(--ease-out); }
.call-overlay.open .call-sheet { transform: translateY(0); }
.call-handle { width: 48px; height: 4px; background: var(--gray-200); border-radius: 2px; margin: 0 auto 24px; }
.call-ava { width: 76px; height: 76px; background: var(--primary-bg); border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 32px; color: var(--primary); position: relative; }
.call-ava::before { content: ''; position: absolute; inset: -10px; border-radius: 50%; border: 2px solid var(--primary-light); animation: pulseRing 1.8s ease-out infinite; }
.call-pharma { font-size: 18px; font-weight: 800; text-align: center; color: var(--dark); font-family: 'Plus Jakarta Sans', sans-serif; }
.call-num { font-size: 24px; font-weight: 700; text-align: center; margin: 8px 0 28px; letter-spacing: 0.5px; color: var(--primary-dark); }
.call-btns { display: flex; gap: 12px; }
.call-cancel { flex: 1; padding: 14px; background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: 14px; font-size: 15px; font-weight: 800; color: var(--gray-500); cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; transition: background 0.2s; }
.call-cancel:hover { background: var(--gray-200); }
.call-ok { flex: 2; padding: 14px; background: var(--success); border: none; border-radius: 14px; font-size: 15px; font-weight: 800; color: white; cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s, transform 0.2s; }
.call-ok:hover { background: #0D9F6E; transform: translateY(-1px); }

.toast-el { position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--dark); color: white; padding: 14px 24px; border-radius: 100px; font-size: 13px; font-weight: 700; z-index: 1900; opacity: 0; transition: opacity 0.3s, transform 0.3s var(--ease-spring); pointer-events: none; white-space: nowrap; box-shadow: var(--shadow-lg); font-family: 'Plus Jakarta Sans', sans-serif; }
.toast-el.on { opacity: 1; transform: translateX(-50%) translateY(0); }

/* Reveal animations (IntersectionObserver) */
.rev, .rev-l, .rev-r { opacity: 0; transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out); transition-delay: calc(var(--i, 0) * 70ms); }
.rev   { transform: translateY(30px); }
.rev-l { transform: translateX(-30px); }
.rev-r { transform: translateX(30px); }
.rev.in, .rev-l.in, .rev-r.in { opacity: 1; transform: none; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
  .ph-card, .rev, .rev-l, .rev-r { opacity: 1 !important; transform: none !important; }
  .hero-h1 .word { opacity: 1; transform: none; }
  .hero-sub, .hero-ctas, .hero-kpis, .hero-card-wrap { opacity: 1; transform: none; }
}

@media (max-width: 640px) {
  body { padding-top: 60px; padding-bottom: var(--BOT); }
  .srch-bar { top: 60px; }
  section { padding: 60px 4%; }
  .toast-el { bottom: 80px; white-space: normal; max-width: 90%; text-align: center; }
  .footer { display: none; }
}
</style>
